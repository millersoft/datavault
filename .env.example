# Copy this file to .env and replace all change-me values before starting.
# Never commit the resulting .env file.

# Container runtime: docker or podman
CONTAINER_ENGINE=docker

# Apache Hop runtime
ENV_NAME=postgres
RUN_CONFIG=local
HOP_OPTIONS="-Xmx8096m"
ACCEPT_LICENSE=false

# Hop job parameters
PARAMS_STAGE=id_data_vault=1,par_id_rtyp=4,par_subruntype=0,par_send_error_mail_ind=0,par_send_success_mail_ind=0,process_ref_tables=1
PARAMS_VAULT=process_hubs=1,process_links=1,process_hub_satellites=1,process_link_satellites=1,process_ref_tables=1,id_data_vault=1,ind_restart=0,ind_force_restart=0,subruntype=0,process_dv_ref=0,process_hub_status_satellites=0,process_link_group_validity_satellites=0,process_link_status_satellites=0,process_link_validity_satellites=0,par_send_error_mail_ind=0,par_send_success_mail_ind=0

# Shared PostgreSQL runtime-role password
VAULT_PASSWORD=secretpassword

# Source database password
SOURCE_PASSWORD=sourcepassword

# Packaged/internal PostgreSQL defaults
INTERNAL_DATA_VAULT_DATABASE=datavault
DB_HOST=postgres
DB_PORT=5432
DB_NAME=datavault
DB_USER=dvuser
DB_PASSWORD=${VAULT_PASSWORD}

# Packaged MySQL demo defaults
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=sakila
MYSQL_PASSWORD=${SOURCE_PASSWORD}

# External PostgreSQL bootstrap credentials.
# These are used only for setup; Hop runtime connections are configured in
# hop/postgres-environment.json by Data Vault Studio.
POSTGRES_BOOTSTRAP_USER=<bootstrap-user>
POSTGRES_BOOTSTRAP_PASSWORD=<bootstrap-password>
POSTGRES_BOOTSTRAP_DATABASE=postgres
DB_MAINTENANCE_NAME=postgres
CREATE_EXTERNAL_DATABASE=true

# External bootstrap marker and rerun controls
BOOTSTRAP_NAME=datavault-core
BOOTSTRAP_VERSION=1
FORCE_EXTERNAL_BOOTSTRAP=false

# Conservative defaults for small or remote/cloud PostgreSQL instances
STG_INSERT_COPIES=1
HUB_INSERT_COPIES=1
LINK_INSERT_COPIES=1
SAT_INSERT_COPIES=1
LINKSAT_INSERT_COPIES=1
HUB_STATUS_SAT_INSERT_COPIES=1

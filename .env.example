# Copy this file to .env and replace all placeholder credential values before starting.
# Never commit the resulting .env file.

# -----------------------------------------------------------------------------
# Data Vault Studio companion server
# -----------------------------------------------------------------------------

# Local HTTP listener. The server always binds to loopback only.
PORT=8420

# Studio feature profile: production or demo. The npm start:demo and
# start:production scripts override this value explicitly.
STUDIO_MODE=production

# Project discovery normally finds the parent of data_vault_studio automatically.
# Set this only when Studio is launched from a different working directory.
# DVS_PROJECT_ROOT=/absolute/path/to/datavault-hop-grok

# Compatibility alias for DVS_PROJECT_ROOT.
# PROJECT_ROOT=/absolute/path/to/datavault-hop-grok

# Advanced overrides for installed Database Packs and the canonical workbook
# validator. Leave commented to use the bundled/default locations.
# DVS_DATABASE_PACK_HOME=/absolute/path/to/database-packs
# DVS_VALIDATOR=/absolute/path/to/validate_mapping_workbook.py

# General API rate limit per window.
DVS_API_RATE_LIMIT_REQUESTS=120
DVS_API_RATE_LIMIT_WINDOW_MS=60000

# Maximum simultaneous expensive operations.
DVS_CONNECTION_TEST_CONCURRENCY=3
DVS_INTROSPECTION_CONCURRENCY=2
DVS_DRIVER_DOWNLOAD_CONCURRENCY=2

# JDBC driver download ceiling (100 MiB) and timeout (2 minutes).
DVS_MAX_JDBC_DRIVER_BYTES=104857600
DVS_JDBC_DOWNLOAD_TIMEOUT_MS=120000

# JSON request limits. Deployments and base64 workbooks need larger allowances
# than ordinary API control requests.
DVS_API_BODY_LIMIT=1mb
DVS_DEPLOY_BODY_LIMIT=25mb
DVS_WORKBOOK_BODY_LIMIT=25mb

# -----------------------------------------------------------------------------
# Container launcher and Apache Hop runtime
# -----------------------------------------------------------------------------

# Container runtime: docker or podman.
CONTAINER_ENGINE=docker

# Disable the optional Docker Compose attached-mode helper menu.
COMPOSE_MENU=false

# Optional license path/state overrides. Relative paths resolve from the project
# root for the launcher; absolute paths are safest for custom locations.
LICENSE_FILE=LICENSE
LICENSE_STATE_DIR=.license-state

# Apache Hop runtime
ENV_NAME=postgres
RUN_CONFIG=local
HOP_OPTIONS="-Xmx8096m"
ACCEPT_LICENSE=false

# Hop job parameters
PARAMS_STAGE=id_data_vault=1,par_id_rtyp=4,par_subruntype=0,par_send_error_mail_ind=0,par_send_success_mail_ind=0,process_ref_tables=1
PARAMS_VAULT=process_hubs=1,process_links=1,process_hub_satellites=1,process_link_satellites=1,process_ref_tables=1,id_data_vault=1,ind_restart=0,ind_force_restart=0,subruntype=0,process_dv_ref=0,process_hub_status_satellites=0,process_link_group_validity_satellites=0,process_link_status_satellites=0,process_link_validity_satellites=0,par_send_error_mail_ind=0,par_send_success_mail_ind=0

# Shared PostgreSQL runtime-role password
VAULT_PASSWORD=<vault-password>

# Source database password
SOURCE_PASSWORD=<source-password>

# Packaged/internal PostgreSQL defaults
INTERNAL_DATA_VAULT_DATABASE=datavault
DB_HOST=postgres
DB_PORT=5432
DB_NAME=datavault
DB_USER=dvuser
DB_PASSWORD=${VAULT_PASSWORD}

# Packaged MySQL demo defaults
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=sakila
MYSQL_PASSWORD=${SOURCE_PASSWORD}

# External PostgreSQL bootstrap credentials.
# These are used only for setup; Hop runtime connections are configured in
# hop/postgres-environment.json by Data Vault Studio.
POSTGRES_BOOTSTRAP_USER=<bootstrap-user>
POSTGRES_BOOTSTRAP_PASSWORD=<bootstrap-password>
POSTGRES_BOOTSTRAP_DATABASE=postgres
DB_MAINTENANCE_NAME=postgres
CREATE_EXTERNAL_DATABASE=true

# External bootstrap marker and rerun controls
BOOTSTRAP_NAME=datavault-core
BOOTSTRAP_VERSION=1
FORCE_EXTERNAL_BOOTSTRAP=false

# Conservative defaults for small or remote/cloud PostgreSQL instances
STG_INSERT_COPIES=1
HUB_INSERT_COPIES=1
LINK_INSERT_COPIES=1
SAT_INSERT_COPIES=1
LINKSAT_INSERT_COPIES=1
HUB_STATUS_SAT_INSERT_COPIES=1

# -----------------------------------------------------------------------------
# Developer and maintenance tooling (not required for normal Studio startup)
# -----------------------------------------------------------------------------

# Hop catalogue extraction/build scripts. Command-line arguments take precedence.
# HOP_EXTRACT_FILE=/absolute/path/to/hop-extract.json
# PACK_OUT_DIR=/absolute/path/to/output/database-packs
# CATALOG_OUT=/absolute/path/to/output/database-types.json

# PDI metadata schema checker. Use a connection URL or standard libpq PG*
# variables. Keep passwords out of the example and out of source control.
# PDI_META_DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_URL=postgresql://user:password@host:5432/database
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=datavault
# PGUSER=dvuser
# PGPASSWORD=<password>

# Database readiness settings
DATABASE_READY_TIMEOUT_SECONDS=300
DATABASE_READY_RETRY_INTERVAL_SECONDS=2
DATABASE_READY_CONNECT_TIMEOUT_SECONDS=5

# Studio connection-test timeout (milliseconds; 1000-30000)
DVS_CONNECTION_TEST_TIMEOUT_MS=6000

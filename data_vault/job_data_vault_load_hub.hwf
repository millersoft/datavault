        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>368</xloc>
      <yloc>848</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_sat_hub_surrogate_keys_objects</name>
      <description>Create (or replace) an updateable view containing all columns to be inserted.
With this view the transformation 'trf_data_vault_hub_generic' can perform an insert with fixed column names,
alway the same for every hub.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_sat_${hub_name}_surrogate_keys_lkp AS
SELECT     hub.${hub_business_key}         as hub_business_key_dv
,          sat.source_surrogate_key        as source_surrogate_key_dv
,          sat.id_srcsys                   as id_srcsys
,		 hub.tenant_id			  as tenant_id
,          1                               as exists_in_dv
FROM       sat_${hub_name}_surrogate_keys     sat
INNER JOIN ${hub_name}                        hub
ON         sat.${hub_key}                   = hub.${hub_key}
WHERE      sat.id_srcsys                    = ${id_srcsys};
-- AND        sat.load_end_dts                 ${PROP_LOAD_END_DTS_LATEST_COND};

drop view if exists vw_sat_${hub_name}_surrogate_keys_upd;

CREATE OR REPLACE VIEW vw_sat_${hub_name}_surrogate_keys_upd AS
SELECT ${hub_key}                  as hub_key
,      source_surrogate_key        as source_surrogate_key
,      id_srcsys
,		 tenant_id			  as tenant_id
,      record_source_id
,      load_dts
-- ,      load_end_dts
FROM   sat_${hub_name}_surrogate_keys;

${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} ${pdi_meta_schema_name}.prc_create_error_table ('sat_${hub_name}_surrogate_keys','${data_vault_schema_name}');

drop view if exists vw_sat_${hub_name}_surrogate_keys_err;
CREATE OR REPLACE VIEW vw_sat_${hub_name}_surrogate_keys_err AS
SELECT      ${hub_key}              as hub_key
,           source_surrogate_key    as source_surrogate_key
,           id_srcsys
,           load_dts
-- ,           load_end_dts
,           record_source_id
,           etl_id_run
,           etl_err_noe
,           etl_err_desc
,           etl_err_col
,           etl_err_cod
,           tenant_id
FROM        sat_${hub_name}_surrogate_keys_err sat;</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>592</xloc>
      <yloc>736</yloc>
      <attributes_hac/>
    </action>

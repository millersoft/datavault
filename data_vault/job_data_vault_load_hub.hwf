<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>job_data_vault_load_hub</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Load a hub</description>
  <extended_description>This job loads a hub in a Data Vault.
Based on the parameter values the steps are:

1: Create (or replace) a lookup view for the hub. This gives the generic hub transformation a lookup functionality with fixed column names.
2: Create (or replace) an updateable view for the hub. This gives the generic hub transformation an update/insert functionality with fixed column names.
3: Create the error table (if not already present).
4: Set the connection parameters. This makes it possible to source data from different databases in 1 Data Vault run.
5: Log the start of the generic transformation, including the number of records at the start.
6: Execute the generic transformation.
7: If a source_surrogate_key is specified:	generate the source system specific hub lookup view
						generate the objects for the surrogate keys satellite
						execute transformation trf_data_vault_sat_hub_surrogate_keys_generic
8: Log the end of the generic transformation, including the number of records and errors at the end.
9: Update the id_run of the error rows.</extended_description>
  <workflow_version>1.12</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user/>
  <created_date>2014/12/15 01:09:50.738</created_date>
  <modified_user>admin</modified_user>
  <modified_date>2017/06/12 12:40:38.715</modified_date>
  <parameters>
    <parameter>
      <name>hub_business_key</name>
      <default_value>actor_id</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>hub_key</name>
      <default_value>hub_actor_id</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>hub_name</name>
      <default_value>hub_hash_actor</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>hub_source</name>
      <default_value>Sakila database.actor</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>hub_source_business_key</name>
      <default_value>first_name||'>'||last_name'</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>hub_source_hash_key</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>hub_source_order</name>
      <default_value>1</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>hub_source_record_source_id</name>
      <default_value>1</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>hub_transformation_to_execute</name>
      <default_value>trf_data_vault_hub_dv2.0</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>id_connection</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>

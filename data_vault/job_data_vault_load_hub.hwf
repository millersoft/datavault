    <action>
      <name>create_hub_lookup_view_id_srcsys (surrogate key)</name>
      <description>Create (or replace) a view containing the business key and the Primary Key key.
With this view the transformation 'trf_data_vault_hub_generic' can perform a lookup with fixed column names,
alway the same for every hub.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${hub_name}_lkp_${id_srcsys} AS
SELECT   source_surrogate_key     as hub_business_key_dv
,        ${hub_key}               as hub_key_dv
,		 tenant_id			  as tenant_id
,         1                       as exists_in_dv
FROM     sat_${hub_name}_surrogate_keys
WHERE    id_srcsys                =  ${id_srcsys}
-- AND      load_end_dts             ${PROP_LOAD_END_DTS_LATEST_COND}</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>736</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_hub_lookup_view_id_srcsys (no surrogate key)</name>
      <description>Create (or replace) a view containing the business key and the Primary Key key.
With this view the transformation 'trf_data_vault_hub_generic' can perform a lookup with fixed column names,
alway the same for every hub.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>
DROP VIEW IF EXISTS vw_${hub_name}_lkp_${id_srcsys} CASCADE;

CREATE OR REPLACE VIEW vw_${hub_name}_lkp_${id_srcsys} AS
SELECT   hub.${hub_business_key}  as hub_business_key_dv
,        hub.${hub_key}           as hub_key_dv
,		 hub.tenant_id			  as tenant_id
,         1                   as exists_in_dv
FROM     ${hub_name} hub;</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>608</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>trf_data_vault_sat_hub_surrogate_keys_dv2.0</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>

    <parameter>
      <name>source_surrogate_key</name>
      <default_value/>
      <description/>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Update etl_id_run in errors</name>
      <description>Set the etl_id_run in the 'new' error rows, inserted in this instance of the job.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>update ${hub_name}_err
set    etl_id_run = ${actual_run}
where  etl_id_run is null </sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>144</xloc>
      <yloc>736</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_hub_updateable_view_err</name>
      <description>Create an updateable view for the error table.
With this view the transformation 'trf_data_vault_hub_generic' can perform an insert into the error table with fixed column names,
alway the same for every hub.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>drop view if exists vw_${hub_name}_err;
CREATE OR REPLACE VIEW vw_${hub_name}_err AS
SELECT      ${hub_key}          as hub_key 
,           ${hub_business_key} as hub_business_key
,           load_dts
,           record_source_id
,			tenant_id
,           etl_id_run
,           etl_err_noe
,           etl_err_desc
,           etl_err_col
,           etl_err_cod
FROM        ${hub_name}_err      hub</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>256</yloc>
      <attributes_hac/>
    </action>

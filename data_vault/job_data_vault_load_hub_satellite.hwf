    <action>
      <name>create_sat_lookup_view</name>
      <description>Create (or replace) a view containing the business key of the hub, the Primary Key of the satellite and all attributes concatenated into 1
pipe delimited string. That last columns is used to compare the source and Data Vault data.
With this view the transformation 'trf_data_vault_hub_sat_generic' can perform a lookup with fixed column names,
alway the same for every hub satellite.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${sat_name}_lkp_${id_srcsys} AS
SELECT          hub.hub_business_key_dv
,               hub.hub_key_dv                as hub_key
,               sat_attributes_concat         as sat_attributes_concat_dv
,               CASE
                   WHEN  sat.${sat_hub_key} IS NOT NULL then 1
                   ELSE  0
                END                           as exists_in_dv
,               ${sat_key}                    as sat_key
,				sat.load_dts				  as load_dts
, hub.tenant_id	as tenant_id
FROM            vw_${sat_hub}_lkp   hub
LEFT OUTER JOIN ${sat_name}                      sat  
ON              hub.hub_key_dv                 = sat.${sat_hub_key}
-- AND             sat.load_end_dts                 ${PROP_LOAD_END_DTS_LATEST_COND}</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>352</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_sat_updateable_view</name>
      <description>Create (or replace) an updateable view containing all columns to be inserted.
With this view the transformation 'trf_data_vault_hub_sat_generic' can perform an insert with fixed column names for the keys.
The attributes of the satellite are all included with the column names in the Data Vault and are inserted in the transformation
without specifying them individually.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${sat_name}_upd AS
SELECT      ${sat_hub_key}       as hub_key
,           ${sat_key}           as sat_key
,           ${sat_attributes_dv}
,           sat_attributes_concat
,           load_dts
-- ,           load_end_dts
,           record_source_id
,		    tenant_id
FROM        ${sat_name}      sat;



CREATE OR REPLACE VIEW vw_${sat_name}_upd_2 AS
SELECT      ${sat_hub_key}       as hub_key
,           ${sat_key}           as sat_key
,           sat_attributes_concat
,           load_dts
,           record_source_id
,			tenant_id
FROM        ${sat_name}      sat;</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>576</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_error_table</name>
      <description>Create an error table for the hub satellite.
Alle columns of the hub satellite table are present, but with data type varchar(512).
Additional columns provide information on what error occurred and when. </description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_create_error_table ('${sat_name}','${data_vault_schema_name}');</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>768</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_sat_updateable_view_err</name>
      <description>Create an updateable view for the error table.
With this view the transformation 'trf_data_vault_hub_sat_generic' can perform an insert into the error table with fixed column names for the keys.
The attributes of the satellite are all included with the column names in the Data Vault and are inserted in the transformation
without specifying them individually.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${sat_name}_err AS
SELECT      ${sat_hub_key}       as hub_key
,           ${sat_key}           as sat_key
,           ${sat_attributes_dv}
,           sat_attributes_concat
,           load_dts
-- ,           load_end_dts
,           record_source_id
,			tenant_id
,           etl_id_run
,           etl_err_noe
,           etl_err_desc
,           etl_err_col
,           etl_err_cod
FROM        ${sat_name}_err      sat</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>768</xloc>
      <yloc>256</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Update etl_id_run in errors</name>
      <description>Set the etl_id_run in the 'new' error rows, inserted in this instance of the job.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>update ${sat_name}_err
set    etl_id_run = ${actual_run}
where  etl_id_run is null </sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1488</xloc>
      <yloc>496</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Regular satellite?</name>
      <description>Check whether the link has 'attributes'. The parameter lnk_ind_attributes contains that information, 1 = yes, 0 = no.
The definition of the views to be generated depends on that.</description>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <comparevalue>1</comparevalue>
      <fieldtype>string</fieldtype>
      <successbooleancondition>false</successbooleancondition>
      <successcondition>different</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successwhenvarset>N</successwhenvarset>
      <valuetype>variable</valuetype>
      <variablename>ind_multiactive_extra_key_column</variablename>
      <parallel>N</parallel>
      <xloc>160</xloc>
      <yloc>272</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_sat_lookup_view_multiactive</name>
      <description>Create (or replace) a view containing the business key of the hub, the Primary Key of the satellite and all attributes concatenated into 1
pipe delimited string. That last columns is used to compare the source and Data Vault data.
With this view the transformation 'trf_data_vault_hub_sat_generic' can perform a lookup with fixed column names,
alway the same for every hub satellite.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${sat_name}_lkp_${id_srcsys} AS
SELECT          hub.hub_business_key_dv
,               hub.hub_key_dv                as hub_key
,               sat_attributes_concat         as sat_attributes_concat_dv
,               CASE
                   WHEN  sat.${sat_hub_key} IS NOT NULL then 1
                   ELSE  0
                END                           as exists_in_dv
,               ${sat_key}                    as sat_key
,               sat.${sat_multiactive_extra_key_column} as sat_multiactive_extra_key_column
FROM            vw_${sat_hub}_lkp_${id_srcsys}   hub
LEFT OUTER JOIN ${sat_name}                      sat  
ON              hub.hub_key_dv                 = sat.${sat_hub_key}
AND             sat.load_end_dts                 ${PROP_LOAD_END_DTS_LATEST_COND}</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>352</xloc>
      <yloc>272</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort job</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>768</xloc>
      <yloc>496</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>postgres bulk load</name>

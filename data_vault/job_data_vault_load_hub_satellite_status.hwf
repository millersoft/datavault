<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>job_data_vault_load_hub_satellite_status</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Load a hub status satellite</description>
  <extended_description>This job loads a hub status satellites in a Data Vault.
These satellites track Inserts and Deletes.
This can be configured for multiple sources, but since a FULL load is necessary for this to work it's likely it's applicable to 1 source table.
</extended_description>
  <workflow_version>1.4</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user/>
  <created_date>2014/12/15 01:09:50.554</created_date>
  <modified_user>admin</modified_user>
  <modified_date>2017/05/09 17:27:41.201</modified_date>
  <parameters>
    <parameter>
      <name>hub_key</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>hub_name</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>record_source_id</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>source_order</name>
      <default_value/>
      <description/>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>create_sat_updateable_view_err</name>
      <description>Create an updateable view for the error table.
With this view the transformation 'trf_data_vault_link_sat_generic' can perform an insert into the error table with fixed column names for the keys.
The attributes of the satellite are all included with the column names in the Data Vault and are inserted in the transformation
without specifying them individually.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_sat_${hub_name}_status_err AS
SELECT      ${hub_key}     as hub_key
,           operation
,           ind_deleted
,           load_dts
-- ,           load_end_dts
,           tenant_id
,           record_source_id
,           etl_id_run
,           etl_err_noe
,           etl_err_desc
,           etl_err_col
,           etl_err_cod
FROM        sat_${hub_name}_status_err      sat</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>288</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Log start transformation</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_log_dv_job_in_run('job_data_vault_load_hub_sat_status','trf_data_vault_hub_sat_status_generic' ,'start'
                          ,${record_source_id},${source_order}
                          ,'sat_${hub_name}_status','${hub_name}','sat_${hub_name}_status',NULL,NULL
                          ,'${data_vault_schema_name}'
                          ,'${hub_key}'
                          , NULL, NULL
                          )</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>512</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Log end transformation</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_log_dv_job_in_run('job_data_vault_load_hub_sat_status','trf_data_vault_hub_sat_status_generic' ,'end'
                          ,${record_source_id},${source_order}
                          ,'sat_${hub_name}_status','${hub_name}','sat_${hub_name}_status',NULL,NULL
                          ,'${data_vault_schema_name}'
                          ,'${hub_key}'
                          ,${var_etl_job_id_job},${var_etl_trf_id_batch}
                          )</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1152</xloc>
      <yloc>288</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>trf_data_vault_hub_sat_status_generic</name>
      <description>Load the link satellite with the generic transformation.</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/data_vault/trf_data_vault_hub_sat_status_generic.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>288</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1152</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create sat (if needed) and updateable view</name>
      <description>Create (or replace) an updateable view containing all columns to be inserted.
With this view the transformation 'trf_data_vault_link_sat_generic' can perform an insert with fixed column names for the keys.
The attributes of the satellite are all included with the column names in the Data Vault and are inserted in the transformation
without specifying them individually.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE TABLE IF NOT EXISTS sat_${hub_name}_status
(
 ${hub_key}       VARCHAR(32)
,operation        CHAR(1)
,ind_deleted      INT
,load_dts         TIMESTAMP
-- ,load_end_dts     TIMESTAMP
,tenant_id		  VARCHAR(20)
,record_source_id INT
, PRIMARY KEY (${hub_key},tenant_id,record_source_id,ind_deleted,load_dts)
);

CREATE OR REPLACE VIEW vw_sat_${hub_name}_status_upd AS
SELECT      ${hub_key}     as hub_key
,           operation
,           ind_deleted
,           load_dts
-- ,           load_end_dts
,			tenant_id
,           record_source_id
FROM        sat_${hub_name}_status      sat;


</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_sat_error_table</name>
      <description>Create an error table for the link satellite.
Alle columns of the link satellite table are present, but with data type varchar(512).
Additional columns provide information on what error occurred and when. </description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_create_error_table ('sat_${hub_name}_status','${data_vault_schema_name}');</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>288</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort job</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>448</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Log end transformation</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>create_sat_error_table</from>
      <to>create_sat_updateable_view_err</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>create_sat_updateable_view_err</from>
      <to>trf_data_vault_hub_sat_status_generic</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>START</from>
      <to>Create sat (if needed) and updateable view</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Log start transformation</from>
      <to>create_sat_error_table</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>trf_data_vault_hub_sat_status_generic</from>
      <to>Abort job</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Create sat (if needed) and updateable view</from>
      <to>Log start transformation</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>trf_data_vault_hub_sat_status_generic</from>
      <to>Log end transformation</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Arial</fontname>
      <fontsize>9</fontsize>
      <height>21</height>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <note>Description: see job settings</note>
      <width>163</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

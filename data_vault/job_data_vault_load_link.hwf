      <description>Create (or replace) an updateable view containing all columns to be inserted.
With this view the transformation 'trf_data_vault_lnk_generic' can perform an insert with fixed column names for the keys.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${lnk_name}_upd AS
SELECT ${lnk_updateable_hub_keys}
,      load_dts
,      record_source_id
,      last_seen_dts
FROM   ${lnk_name};

CREATE OR REPLACE VIEW vw_${lnk_name}_upd_incl_key AS
SELECT ${lnk_updateable_hub_keys}
,      load_dts
,      record_source_id
,      last_seen_dts
,      ${lnk_key} as lnk_key
FROM   ${lnk_name};</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>736</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_lnk_updateable_view_err (attr) (lsd)</name>
      <description>Create an updateable view for the error table.
With this view the transformation 'trf_data_vault_lnk_generic' can perform an insert into the error table with fixed column names for the keys.
The 'attributes' of the link are all included with the column names in the Data Vault and are inserted in the transformation
without specifying them individually.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${lnk_name}_err AS
SELECT      ${lnk_updateable_hub_keys}
            ${lnk_updateable_attributes}
,           load_dts
,           record_source_id
,			tenant_id
,           last_seen_dts
,	   lnk_attributes_concat_dv
,           etl_id_run
,           etl_err_noe
,           etl_err_desc
,           etl_err_col
,           etl_err_cod
FROM        ${lnk_name}_err      lnk</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>992</xloc>
      <yloc>352</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_error_table (attr) (lsd)</name>
      <description>Create an error table for the link.
Alle columns of the link table are present (including the 'attributes'), but with data type varchar(512).
Additional columns provide information on what error occurred and when. </description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_create_error_table ('${lnk_name}','${data_vault_schema_name}');</sql>

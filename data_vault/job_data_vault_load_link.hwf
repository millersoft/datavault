  <actions>
    <action>
      <name>Update etl_id_run in errors</name>
      <description>Set the etl_id_run in the 'new' error rows, inserted in this instance of the job.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>update ${lnk_name}_err
set    etl_id_run = ${actual_run}
where  etl_id_run is null </sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1376</xloc>
      <yloc>624</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_lnk_updateable_view_err (no attr)</name>
      <description>Create an updateable view for the error table.
With this view the transformation 'trf_data_vault_lnk_generic' can perform an insert into the error table with fixed column names for the keys.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${lnk_name}_err AS
SELECT      ${lnk_updateable_hub_keys}
,           load_dts
,			tenant_id
,           record_source_id
,           etl_id_run
,           etl_err_noe
,           etl_err_desc
,           etl_err_col
,           etl_err_cod
FROM        ${lnk_name}_err      lnk</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>992</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_error_table (no attr)</name>
      <description>Create an error table for the link.
Alle columns of the link table are present, but with data type varchar(512).
Additional columns provide information on what error occurred and when. </description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_create_error_table ('${lnk_name}','${data_vault_schema_name}');</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_lnk_updateable_view_err (attr)</name>
      <description>Create an updateable view for the error table.
With this view the transformation 'trf_data_vault_lnk_generic' can perform an insert into the error table with fixed column names for the keys.
The 'attributes' of the link are all included with the column names in the Data Vault and are inserted in the transformation
without specifying them individually.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>DROP VIEW IF EXISTS vw_${lnk_name}_err;

CREATE OR REPLACE VIEW vw_${lnk_name}_err AS
SELECT      ${lnk_updateable_hub_keys}
            ${lnk_updateable_attributes}
,           load_dts
,           record_source_id
,			tenant_id
,	   lnk_attributes_concat_dv
,           etl_id_run
,           etl_err_noe
,           etl_err_desc
,           etl_err_col
,           etl_err_cod
FROM        ${lnk_name}_err      lnk;</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>992</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_error_table (attr)</name>
      <description>Create an error table for the link.
Alle columns of the link table are present (including the 'attributes'), but with data type varchar(512).
Additional columns provide information on what error occurred and when. </description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_create_error_table ('${lnk_name}','${data_vault_schema_name}');</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success 2</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>32</xloc>
      <yloc>352</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>No attributes?</name>
      <description>Check whether the link has no 'attributes'. The parameter lnk_ind_attributes contains that information, 1 = yes, 0 = no.
The definition of the views to be generated depends on that.</description>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <comparevalue>0</comparevalue>
      <fieldtype>string</fieldtype>
      <successbooleancondition>false</successbooleancondition>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successwhenvarset>N</successwhenvarset>
      <valuetype>variable</valuetype>
      <variablename>lnk_ind_attributes</variablename>
      <parallel>N</parallel>
      <xloc>160</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_link_updateable_view_no_attr</name>
      <description>Create (or replace) an updateable view containing all columns to be inserted.
With this view the transformation 'trf_data_vault_lnk_generic' can perform an insert with fixed column names for the keys.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${lnk_name}_upd AS
SELECT ${lnk_updateable_hub_keys}
,      load_dts
,      tenant_id
,      record_source_id
FROM   ${lnk_name};

CREATE OR REPLACE VIEW vw_${lnk_name}_upd_incl_key AS
SELECT ${lnk_updateable_hub_keys}
,      load_dts
,      tenant_id
,      record_source_id
,      ${lnk_key} as lnk_key
FROM   ${lnk_name};</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_link_lookup_view_no_attr</name>
      <description>Create (or replace) an updateable view containing all columns to be inserted.
With this view the transformation 'trf_data_vault_lnk_generic' can perform a lookup with fixed column names for the keys.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${lnk_name}_lkp AS
SELECT ${lnk_hub_1_key_column}  as hub_1_key
,      ${lnk_hub_2_key_column}  as hub_2_key
,      ${lnk_hub_3_key_column}   as hub_3_key
,      ${lnk_hub_4_key_column}   as hub_4_key
,      ${lnk_hub_5_key_column}   as hub_5_key
,      ${lnk_hub_6_key_column}   as hub_6_key
,      ${lnk_hub_7_key_column}    as hub_7_key
,      ${lnk_hub_8_key_column}   as hub_8_key
,      ${lnk_hub_9_key_column}    as hub_9_key
,      ${lnk_hub_10_key_column}   as hub_10_key
,      ${lnk_key}                as lnk_key
,      1                         as exists_in_dv
,      ${PROP_DUMMY_LINK_ATTRIBUTES} as lnk_attributes_concat_dv 
,      tenant_id
FROM   ${lnk_name}</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>608</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_link_lookup_view_incl_attr</name>
      <description>Create (or replace) an updateable view containing all columns to be inserted.
With this view the transformation 'trf_data_vault_lnk_generic' can perform a lookup with fixed column names for the keys.
The 'attributes' of the link are included in a concatenated pipe delimited string.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${lnk_name}_lkp AS
SELECT '${lnk_hub_1_key_column}'      as hub_1_key
,      '${lnk_hub_2_key_column}'      as hub_2_key
,      '${lnk_hub_3_key_column}'      as hub_3_key
,      '${lnk_hub_4_key_column}'      as hub_4_key
,      '${lnk_hub_5_key_column}'      as hub_5_key
,      '${lnk_hub_6_key_column}'      as hub_6_key
,      '${lnk_hub_7_key_column}'      as hub_7_key
,      '${lnk_hub_8_key_column}'      as hub_8_key
,      '${lnk_hub_9_key_column}'     as hub_9_key
,      '${lnk_hub_10_key_column}'     as hub_10_key
,      ${lnk_key}                   as lnk_key
,      1                            as exists_in_dv
,	   lnk_attributes_concat_dv
,      tenant_id
FROM   ${lnk_name}</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_link_updateable_view_incl_attr</name>
      <description>Create (or replace) an updateable view containing all columns to be inserted.
With this view the transformation 'trf_data_vault_lnk_generic' can perform an insert with fixed column names for the keys.
The 'attributes' of the link are all included with the column names in the Data Vault and are inserted in the transformation
without specifying them individually.
</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${lnk_name}_upd AS
SELECT ${lnk_updateable_hub_keys}
       ${lnk_updateable_attributes}
,      load_dts
, tenant_id
,      record_source_id
FROM   ${lnk_name};

CREATE OR REPLACE VIEW vw_${lnk_name}_upd_incl_key AS
SELECT ${lnk_updateable_hub_keys}
       ${lnk_updateable_attributes}
,      load_dts
, tenant_id
,      record_source_id
,      ${lnk_key} as lnk_key
,	   lnk_attributes_concat_dv
FROM   ${lnk_name};</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Link attributes?</name>
      <description>Check whether the link has 'attributes'. The parameter lnk_ind_attributes contains that information, 1 = yes, 0 = no.
The definition of the views to be generated depends on that.</description>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <comparevalue>1</comparevalue>
      <fieldtype>string</fieldtype>
      <successbooleancondition>false</successbooleancondition>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successwhenvarset>N</successwhenvarset>
      <valuetype>variable</valuetype>
      <variablename>lnk_ind_attributes</variablename>
      <parallel>N</parallel>
      <xloc>160</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>32</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>trf_data_vault_set_connection_parameters</name>
      <description>Set the connection parameters for the the source data for the link.
The connection is determined by the the job parameter 'id_connection'.</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/data_vault/trf_data_vault_set_connection_parameters.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <parameter>
          <name>id_connection</name>
          <value>${id_connection}</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>1376</xloc>
      <yloc>96</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>trf_choose_attributes</name>
      <description>Load the link with the generic transformation.</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>

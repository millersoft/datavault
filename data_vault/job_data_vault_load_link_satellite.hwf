  <actions>
    <action>
      <name>Update etl_id_run in errors</name>
      <description>Set the etl_id_run in the 'new' error rows, inserted in this instance of the job.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>update ${sat_name}_err
set    etl_id_run = ${actual_run}
where  etl_id_run is null </sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1312</xloc>
      <yloc>288</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_sat_updateable_view_err</name>
      <description>Create an updateable view for the error table.
With this view the transformation 'trf_data_vault_link_sat_generic' can perform an insert into the error table with fixed column names for the keys.
The attributes of the satellite are all included with the column names in the Data Vault and are inserted in the transformation
without specifying them individually.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${sat_name}_err AS
SELECT      ${lnk_key}     as lnk_key
,           ${sat_key}     as sat_key
,           ${sat_attributes_dv}
,           sat_attributes_concat
,           load_dts
-- ,           load_end_dts
,           record_source_id
,			tenant_id
,           etl_id_run
,           etl_err_noe
,           etl_err_desc
,           etl_err_col
,           etl_err_cod
FROM        ${sat_name}_err      sat</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>736</xloc>
      <yloc>288</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_error_table</name>
      <description>Create an error table for the link satellite.
Alle columns of the link satellite table are present, but with data type varchar(512).
Additional columns provide information on what error occurred and when. </description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_create_error_table ('${sat_name}','${data_vault_schema_name}');</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>736</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_sat_updateable_view</name>
      <description>Create (or replace) an updateable view containing all columns to be inserted.
With this view the transformation 'trf_data_vault_link_sat_generic' can perform an insert with fixed column names for the keys.
The attributes of the satellite are all included with the column names in the Data Vault and are inserted in the transformation
without specifying them individually.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${sat_name}_upd AS
SELECT      ${lnk_key}     as lnk_key
,           ${sat_key}     as sat_key
,           ${sat_attributes_dv}
,           sat_attributes_concat
,           load_dts
-- ,           load_end_dts
,           record_source_id
,			tenant_id
FROM        ${sat_name}      sat;


CREATE OR REPLACE VIEW vw_${sat_name}_upd_2 AS
SELECT      ${lnk_key}     as lnk_key
,           ${sat_key}     as sat_key
,           sat_attributes_concat
,           load_dts
-- ,           load_end_dts
,           record_source_id
,			tenant_id
FROM        ${sat_name}      sat;</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>544</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_sat_lookup_view</name>
      <description>Create (or replace) a view containing the keys of the hub and satellite and all attributes concatenated into 1
pipe delimited string. That last columns is used to compare the source and Data Vault data.
With this view the transformation 'trf_data_vault_link_sat_generic' can perform a lookup with fixed column names,
alway the same for every link satellite.</description>
      <type>SQL</type>
      <attributes/>
      <connection>data_vault</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>CREATE OR REPLACE VIEW vw_${sat_name}_lkp  AS
SELECT      ${lnk_key}                     as lnk_key
,           sat_attributes_concat          as sat_attributes_concat_dv
,           1                              as exists_in_dv
,           sat.${sat_key}                 as sat_key 
,			tenant_id						as tenant_id
FROM        ${sat_name}      sat
-- WHERE       sat.load_end_dts ${PROP_LOAD_END_DTS_LATEST_COND}</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>352</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1312</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>trf_choose_lnk_sat</name>
      <description>Load the link satellite with the generic transformation.</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/data_vault/trf_choose_lnk_sat.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
    <action>

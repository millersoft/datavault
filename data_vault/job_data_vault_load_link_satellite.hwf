      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>288</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>32</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Log end transformation</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_log_dv_job_in_run('job_data_vault_load_link_satellite','${sat_transformation_to_execute}' ,'end'
                          ,${sat_source_record_source_id},1
                          ,'${sat_name}',NULL,NULL,'${lnk_name}','${sat_name}'
                          ,'${data_vault_schema_name}','${sat_key}'
                          ,${var_etl_job_id_job},${var_etl_trf_id_batch}
                          )</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1312</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Log start transformation</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_log_dv_job_in_run('job_data_vault_load_link_satellite','${sat_transformation_to_execute}' ,'start'
                          ,${sat_source_record_source_id},1
                          ,'${sat_name}',NULL,NULL,'${lnk_name}','${sat_name}'
                          ,'${data_vault_schema_name}','${sat_key}'
                          , NULL, NULL
                          )</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>176</xloc>
      <yloc>160</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort job</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>736</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>create_sat_updateable_view_err</from>
      <to>trf_data_vault_set_connection_parameters</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>

      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>trf_data_vault_set_connection_parameters</from>
      <to>Abort job</to>

      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>START</from>
      <to>Log start transformation</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>trf_choose_lnk_sat</from>
      <to>Log end transformation</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>

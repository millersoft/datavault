<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>job_data_vault_load_link_satellite_group_validity_all</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Job: load all link validity satellites for links with a 'group_key_column' and no 'bk_columns'.</description>
  <extended_description>This job loads all link validity satellites in a Data Vault for a links with a 'group_key_column' and no 'bk_columns'

The process is:
1	Determine all the link validity satellites to process
2	For each of those inputs: job_data_vault_load_link_satellite_validity_only_group</extended_description>
  <workflow_version>1.1</workflow_version>
  <workflow_status>0</workflow_status>

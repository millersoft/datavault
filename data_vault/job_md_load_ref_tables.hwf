    <action>
      <name>delete obsolete Data Vault objects </name>
      <description>Set ind_current to 0 (do not process) for objects that are not present in the staging tables.</description>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>delete from ref_data_vault_hub_satellite_columns
where  not exists
(
select          hsats.id_data_vault_hub_sat
,               stg_sat.attribute_number
,               stg_sat.attribute_source_column
,               stg_sat.attribute_target_column
,               ref_srctab.id_srctab              as record_source_id
,               stg_sat.ind_current           
from            vw_stg_management_satellites_all_columns_filled       stg_sat
cross join      stg_management_data_vaults      dv
inner join      ref_data_vault_hubs             ref_hubs
on              stg_sat.sat_hub               = ref_hubs.hub_name
and             dv.id_data_vault              = ref_hubs.id_data_vault
inner join      stg_management_source_tables    stg_srctab
on              stg_sat.source_concat         = stg_srctab.source_concat
inner join      ref_source_systems              ref_srcsys
on              stg_srctab.source_system      = ref_srcsys.description
inner join      ref_source_tables               ref_srctab
on              ref_srcsys.id_srcsys          = ref_srctab.id_srcsys
and             stg_srctab.table_name         = ref_srctab.table_name
inner join      ref_data_vault_hub_satellites   hsats
on              stg_sat.sat_name              = hsats.sat_name
and             ref_hubs.id_data_vault_hub    = hsats.id_data_vault_hub
where           stg_sat.ind_current           = 1
and             hsats.id_data_vault_hub_sat   = ref_data_vault_hub_satellite_columns.id_data_vault_hub_sat
and             stg_sat.attribute_number      = ref_data_vault_hub_satellite_columns.attribute_number
);

delete from ref_data_vault_link_satellite_columns
where  not exists
(
select          lsats.id_data_vault_link_sat
,               stg_sat.attribute_number
,               stg_sat.attribute_source_column
,               stg_sat.attribute_target_column
,               ref_srctab.id_srctab              as record_source_id
,               stg_sat.ind_current           
from            vw_stg_management_link_satellites_all_columns_filled       stg_sat
cross join      stg_management_data_vaults      dv
inner join      ref_data_vault_links            ref_links
on              stg_sat.sat_link              = ref_links.link_name
and             dv.id_data_vault              = ref_links.id_data_vault
inner join      stg_management_source_tables    stg_srctab
on              stg_sat.source_concat         = stg_srctab.source_concat
inner join      ref_source_systems              ref_srcsys
on              stg_srctab.source_system      = ref_srcsys.description
inner join      ref_source_tables               ref_srctab
on              ref_srcsys.id_srcsys          = ref_srctab.id_srcsys
and             stg_srctab.table_name         = ref_srctab.table_name
inner join      ref_data_vault_link_satellites  lsats
on              stg_sat.sat_name              = lsats.sat_name
and             ref_links.id_data_vault_link  = lsats.id_data_vault_link
where           stg_sat.ind_current           = 1
and             lsats.id_data_vault_link_sat  = ref_data_vault_link_satellite_columns.id_data_vault_link_sat
and             stg_sat.attribute_number      = ref_data_vault_link_satellite_columns.attribute_number
);

delete from ref_data_vault_hub_satellites
where exists (select 1
               from   ref_data_vault_hubs             dv_hubs
               where  dv_hubs.id_data_vault_hub    =  ref_data_vault_hub_satellites.id_data_vault_hub
               and    dv_hubs.id_data_vault        =  (select id_data_vault from stg_management_data_vaults)
              )
and    not exists
(
select          ref_hubs.id_data_vault_hub
,               stg_sat.sat_name
from            stg_management_satellites       stg_sat
cross join      stg_management_data_vaults      dv
inner join      ref_data_vault_hubs             ref_hubs
on              stg_sat.sat_hub               = ref_hubs.hub_name
and             dv.id_data_vault              = ref_hubs.id_data_vault
where           stg_sat.ind_current           = 1
and             ref_hubs.id_data_vault_hub    = ref_data_vault_hub_satellites.id_data_vault_hub
and             stg_sat.sat_name              = ref_data_vault_hub_satellites.sat_name
);


delete from ref_data_vault_link_satellites
where  exists (select 1
               from   ref_data_vault_links           dv_links
               where  dv_links.id_data_vault_link =  ref_data_vault_link_satellites.id_data_vault_link
               and    dv_links.id_data_vault      =  (select id_data_vault from stg_management_data_vaults)
              )
and    not exists
(
select          1
from            stg_management_link_satellites   stg_sat
inner join      ref_data_vault_links             ref_links
on              stg_sat.sat_link               = ref_links.link_name
and             (select id_data_vault from stg_management_data_vaults)   = ref_links.id_data_vault
where           stg_sat.ind_current            = 1
and             stg_sat.sat_name               = ref_data_vault_link_satellites.sat_name
and             ref_links.id_data_vault_link   = ref_data_vault_link_satellites.id_data_vault_link
);

delete from ref_data_vault_link_sources
where  exists (select 1 from ref_data_vault_links l where l.id_data_vault_link = ref_data_vault_link_sources.id_data_vault_link and l.id_data_vault = (select id_data_vault from stg_management_data_vaults))
and    not exists
(
select          ref_links.id_data_vault_link
,               stg_links.ind_current
,               ref_srctab.id_srctab                as record_source_id
,               stg_links.link_source_order         as source_order
from            stg_management_links            stg_links
cross join      stg_management_data_vaults      dv
inner join      stg_management_source_tables    stg_srctab
on              stg_links.source_concat       = stg_srctab.source_concat
inner join      ref_source_systems              ref_srcsys
on              stg_srctab.source_system      = ref_srcsys.description
inner join      ref_source_tables               ref_srctab
on              ref_srcsys.id_srcsys          = ref_srctab.id_srcsys
and             stg_srctab.table_name         = ref_srctab.table_name
inner join      ref_data_vault_links            ref_links
on              stg_links.link_name           = ref_links.link_name
and             ref_links.id_data_vault       = dv.id_data_vault
where           stg_links.ind_current         = 1
and             ref_links.id_data_vault_link  = ref_data_vault_link_sources.id_data_vault_link
and             ref_srctab.id_srctab          = ref_data_vault_link_sources.record_source_id
and             stg_links.link_source_order   = ref_data_vault_link_sources.source_order
);

delete from ref_data_vault_link_attributes
where  exists (select 1
               from   ref_data_vault_links            dv_links
               where  dv_links.id_data_vault_link  =  dv_links.id_data_vault_link
               and    dv_links.id_data_vault       =  (select id_data_vault from stg_management_data_vaults)
              )
and    not exists
(
select          ref_links.id_data_vault_link
,               ref_srctab.id_srctab              as record_source_id
,               stg_lnka.ind_current
from
(            
select          iv.link_name
,               iv.ind_current
,               iv.source_concat
from
(select         distinct 
                lnka.link_name
,               lnka.ind_current    
,               lnka.source_concat 
from            vw_stg_management_link_attributes_all_columns_filled lnka
) iv
) stg_lnka
inner join      ref_data_vault_links            ref_links
on              stg_lnka.link_name            = ref_links.link_name
and             ref_links.id_data_vault       = (select id_data_vault from stg_management_data_vaults)
inner join      stg_management_source_tables    stg_srctab
on              stg_lnka.source_concat        = stg_srctab.source_concat
inner join      ref_source_systems              ref_srcsys
on              stg_srctab.source_system      = ref_srcsys.description
inner join      ref_source_tables               ref_srctab
on              ref_srcsys.id_srcsys          = ref_srctab.id_srcsys
and             stg_srctab.table_name         = ref_srctab.table_name
where           stg_lnka.ind_current          = 1
and             ref_links.id_data_vault_link  = ref_data_vault_link_attributes.id_data_vault_link
and             ref_srctab.id_srctab          = ref_data_vault_link_attributes.record_source_id
);

delete from ref_data_vault_links
where       ref_data_vault_links.id_data_vault = (select id_data_vault from stg_management_data_vaults)
and    not exists
(
select          1
from            stg_management_links            stg_links
where           stg_links.link_name           = ref_data_vault_links.link_name
and             (select id_data_vault from stg_management_data_vaults) = ref_data_vault_links.id_data_vault
and             stg_links.ind_current         = 1
);

delete from ref_data_vault_hub_sources
where exists (select 1 from ref_data_vault_hubs h where h.id_data_vault_hub = ref_data_vault_hub_sources.id_data_vault_hub and h.id_data_vault = (select id_data_vault from stg_management_data_vaults))
and not exists
(
select          1
from            stg_management_hubs             stg_hubs
cross join      stg_management_data_vaults      dv
inner join      ref_data_vault_hubs             ref_hubs
on              stg_hubs.hub_name             = ref_hubs.hub_name
and             dv.id_data_vault              = ref_hubs.id_data_vault
inner join      stg_management_source_tables    stg_srctab
on              stg_hubs.hub_source           = stg_srctab.source_concat
inner join      ref_source_systems              ref_srcsys
on              stg_srctab.source_system      = ref_srcsys.description
inner join      ref_source_tables               ref_srctab
on              ref_srcsys.id_srcsys          = ref_srctab.id_srcsys
and             stg_srctab.table_name         = ref_srctab.table_name
where           stg_hubs.hub_source_business_key is not null
and             ref_hubs.id_data_vault_hub       = ref_data_vault_hub_sources.id_data_vault_hub
and             ref_srctab.id_srctab             = ref_data_vault_hub_sources.record_source_id       
and             stg_hubs.hub_source_business_key = ref_data_vault_hub_sources.source_business_key
and             stg_hubs.ind_current             = 1 
);

delete from ref_data_vault_hubs
where  id_data_vault = (select id_data_vault from stg_management_data_vaults)
and    not exists
(
select          1
from            stg_management_hubs        hubs
cross join      stg_management_data_vaults dv
where           hubs.hub_name            = ref_data_vault_hubs.hub_name
and             dv.id_data_vault         = ref_data_vault_hubs.id_data_vault
and             hubs.ind_current         = 1
);
</sql>

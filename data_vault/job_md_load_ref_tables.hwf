<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>job_md_load_ref_tables</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Load reference metadata for the Data Vault</description>
  <extended_description>This job processes the metadata of a Data Vault definition.
Source is an Excel sheet that contains the data for 1 Data Vault.
The id of the Data Vault is hardcoded in the Excel sheet.

First all data is staged, then the reference tables in the repository are refreshed using that data.</extended_description>
  <workflow_version>1.6</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user/>
  <created_date>2014/12/15 01:09:50.775</created_date>
  <modified_user>admin</modified_user>
  <modified_date>2017/05/11 12:19:56.719</modified_date>
  <parameters>
    <parameter>
      <name>id_data_vault</name>
      <default_value>1</default_value>
      <description/>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>trf_stg_management_dwh_metadata</name>
      <description>Load the metadata from the Excel Data Vault definition file into staging tables (truncate/insert).</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>

  <transform>
    <name>select_hubs_dynamic</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>staging</connection>
    <sql>select 
	'${lnk_src_hub_1_business_key}'
	|| gen_lnk_qry_no_as('${lnk_src_hub_2_business_key}')
	|| gen_lnk_qry_no_as('${lnk_src_hub_3_business_key}')
	|| gen_lnk_qry_no_as('${lnk_src_hub_4_business_key}')
	|| gen_lnk_qry_no_as('${lnk_src_hub_5_business_key}')
	|| gen_lnk_qry_no_as('${lnk_src_hub_6_business_key}')
	|| gen_lnk_qry_no_as('${lnk_src_hub_7_business_key}')
	|| gen_lnk_qry_no_as('${lnk_src_hub_8_business_key}')
	|| gen_lnk_qry_no_as('${lnk_src_hub_9_business_key}')
	|| gen_lnk_qry_no_as('${lnk_src_hub_10_business_key}') as concat_hubs
,
	'${lnk_src_hub_1_business_key}' || ' as hub_1_key'
	|| gen_lnk_qry_w_as('${lnk_src_hub_2_business_key}', 'hub_2_key')
	|| gen_lnk_qry_w_as('${lnk_src_hub_3_business_key}', 'hub_3_key')
	|| gen_lnk_qry_w_as('${lnk_src_hub_4_business_key}', 'hub_4_key')
	|| gen_lnk_qry_w_as('${lnk_src_hub_5_business_key}', 'hub_5_key')
	|| gen_lnk_qry_w_as('${lnk_src_hub_6_business_key}', 'hub_6_key')
	|| gen_lnk_qry_w_as('${lnk_src_hub_7_business_key}', 'hub_7_key')
	|| gen_lnk_qry_w_as('${lnk_src_hub_8_business_key}', 'hub_8_key')
	|| gen_lnk_qry_w_as('${lnk_src_hub_9_business_key}', 'hub_9_key')
	|| gen_lnk_qry_w_as('${lnk_src_hub_10_business_key}', 'hub_10_key') as seperate_hubs
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>

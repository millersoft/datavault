<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_data_vault_determine_hub_satellites_to_load</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Determine regular hub-satellites to load</description>
    <extended_description>This transformation collects all necessary parameters to load the hub satellites, except the hub-status satellites.
Each satellite results in 1 row.</extended_description>
    <pipeline_version>1.5</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>id_data_vault</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>mod_4_value</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>postgres_bulk</name>
        <default_value>0</default_value>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:36.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2017/06/13 12:23:35.486</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Arial</fontname>
      <fontsize>9</fontsize>
      <height>21</height>
      <xloc>16</xloc>
      <yloc>16</yloc>
      <note>Description: see transformation settings</note>
      <width>224</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>ref_data_vault_hub_satellites</from>
      <to>Copy rows to result</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>Job successful?</from>
      <to>Ignore successful jobs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Job successful?</from>
      <to>Abort when a job has an exit status &lt;&gt; Y</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>ref_data_vault_hub_satellites</from>
      <to>Processing Satellite</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Processing Satellite</from>
      <to>job_data_vault_load_hub_satellite</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>job_data_vault_load_hub_satellite</from>
      <to>Job successful?</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Abort when a job has an exit status &lt;&gt; Y</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Copy rows to result</name>
    <type>RowsToResult</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ignore successful jobs</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Job successful?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
</conditions>
        <function>=</function>
        <leftvalue>ExecutionResult</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constant</name>
          <precision>-1</precision>
          <text>Y</text>
          <type>Boolean</type>
        </value>
      </condition>
    </compare>
    <send_false_to>Abort when a job has an exit status &lt;&gt; Y</send_false_to>
    <send_true_to>Ignore successful jobs</send_true_to>
    <attributes/>
    <GUI>
      <xloc>672</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Processing Satellite</name>
    <type>WriteToLog</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <displayHeader>Y</displayHeader>
    <fields>
      <field>
        <name>sat_hub</name>
      </field>
      <field>
        <name>sat_name</name>
      </field>
    </fields>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <loglevel>Basic</loglevel>
    <logmessage>Fields</logmessage>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>job_data_vault_load_hub_satellite</name>
    <type>WorkflowExecutor</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <execution_errors_field>ExecutionNrErrors</execution_errors_field>
    <execution_exit_status_field>ExecutionExitStatus</execution_exit_status_field>
    <execution_files_retrieved_field>ExecutionFilesRetrieved</execution_files_retrieved_field>
    <execution_lines_deleted_field>ExecutionLinesDeleted</execution_lines_deleted_field>
    <execution_lines_input_field>ExecutionLinesInput</execution_lines_input_field>
    <execution_lines_output_field>ExecutionLinesOutput</execution_lines_output_field>
    <execution_lines_read_field>ExecutionLinesRead</execution_lines_read_field>
    <execution_lines_rejected_field>ExecutionLinesRejected</execution_lines_rejected_field>
    <execution_lines_updated_field>ExecutionLinesUpdated</execution_lines_updated_field>
    <execution_lines_written_field>ExecutionLinesWritten</execution_lines_written_field>
    <execution_log_channelid_field>ExecutionLogChannelId</execution_log_channelid_field>
    <execution_log_text_field>ExecutionLogText</execution_log_text_field>
    <execution_result_field>ExecutionResult</execution_result_field>
    <execution_time_field>ExecutionTime</execution_time_field>
    <filename>${PROJECT_HOME}/data_vault/job_data_vault_load_hub_satellite.hwf</filename>
    <group_size>1</group_size>
    <inherit_all_vars>Y</inherit_all_vars>
    <parameters>
      <variablemapping>
        <field>id_connection</field>
        <variable>id_connection</variable>
      </variablemapping>
      <variablemapping>
        <field>id_srcsys</field>
        <variable>id_srcsys</variable>
      </variablemapping>
      <variablemapping>
        <field>ind_multiactive_extra_key_column</field>
        <variable>ind_multiactive_extra_key_column</variable>
      </variablemapping>
      <variablemapping>
        <field>postgres_bulk</field>
        <variable>postgres_bulk</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_attributes</field>
        <variable>sat_attributes</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_attributes_concat</field>
        <variable>sat_attributes_concat</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_attributes_concat_dv</field>
        <variable>sat_attributes_concat_dv</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_attributes_dv</field>
        <variable>sat_attributes_dv</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_hub</field>
        <variable>sat_hub</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_hub_business_key</field>
        <variable>sat_hub_business_key</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_hub_key</field>
        <variable>sat_hub_key</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_key</field>
        <variable>sat_key</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_multiactive_extra_key_column</field>
        <variable>sat_multiactive_extra_key_column</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_multiactive_extra_key_column_src</field>
        <variable>sat_multiactive_extra_key_column_src</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_name</field>
        <variable>sat_name</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_source</field>
        <variable>sat_source</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_source_hub_business_key</field>
        <variable>sat_source_hub_business_key</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_source_record_source_id</field>
        <variable>sat_source_record_source_id</variable>
      </variablemapping>
      <variablemapping>
        <field>sat_transformation_to_execute</field>
        <variable>sat_transformation_to_execute</variable>
      </variablemapping>
    </parameters>
    <result_files_file_name_field>FileName</result_files_file_name_field>
    <run_configuration>local</run_configuration>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>ref_data_vault_hub_satellites</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select     sats.sat_name                                                    as sat_name
,          sats.sat_key                                                     as sat_key
,          hubs.hub_key                                                     as sat_hub_key
,          hubs.hub_name                                                    as sat_hub
,          hubs.hub_business_key                                            as sat_hub_business_key
,          coalesce(srctab.staging_table_name,srctab.table_name)            as sat_source
,          sats.sat_source_hub_business_key                                 as sat_source_hub_business_key
,          sats.sat_attributes                                              as sat_attributes
,          sats.sat_attributes_dv                                           as sat_attributes_dv
,          sats.ind_multiactive_extra_key_column                            as ind_multiactive_extra_key_column
,          sats.sat_multiactive_extra_key_column_src                        as sat_multiactive_extra_key_column_src
,          sats.sat_multiactive_extra_key_column                            as sat_multiactive_extra_key_column
,          sats.sat_attributes_concat                                       as sat_attributes_concat
,          sats.sat_attributes_concat_dv                                    as sat_attributes_concat_dv
,          sats.record_source_id                                            as sat_source_record_source_id
,          coalesce(srcsys.id_staging_connection,srcsys.id_source_connection) as id_connection
,          case when sats.ind_multiactive_extra_key_column = 1  then 'trf_data_vault_multiactive_sat_generic_source_is_STG'
                when sats.ind_multiactive_extra_key_column &lt;&gt; 1 then 'trf_data_vault_sat_generic_dv2.0' 
           end                                                              as sat_transformation_to_execute
,          srctab.id_srcsys                                                 as id_srcsys
,           ${postgres_bulk}                                                as postgres_bulk
from       ref_data_vault_hub_satellites sats
inner join ref_data_vault_hubs           hubs
on         sats.id_data_vault_hub      = hubs.id_data_vault_hub
inner join ref_source_tables             srctab
on         sats.record_source_id       = srctab.id_srctab
inner join ref_source_systems            srcsys
on         srctab.id_srcsys            = srcsys.id_srcsys
inner join ref_connections               conn
on         coalesce(srcsys.id_staging_connection,srcsys.id_source_connection) = conn.id_connection
where      sats.ind_current            = 1
-- and        mod(sats.id_data_vault_hub_sat,4) = ${mod_4_value}
and        hubs.id_data_vault                = ${id_data_vault}
and        (   ${subruntype} = 0 
            or ${PROP_DATABASE_STRING_SEARCH_FUNCTION}(concat('|',cast(${subruntype} as char),'|'),sats.process_in_subruntypes) > 0
           )
</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

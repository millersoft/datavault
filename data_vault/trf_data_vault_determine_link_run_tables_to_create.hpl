  <transform>
    <name>Job successful?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
</conditions>
        <function>=</function>
        <leftvalue>ExecutionResult</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constant</name>
          <precision>-1</precision>
          <text>Y</text>
          <type>Boolean</type>
        </value>
      </condition>
    </compare>
    <send_false_to>Abort when a job has an exit status &lt;&gt; Y</send_false_to>
    <send_true_to>Ignore successful jobs</send_true_to>
    <attributes/>
    <GUI>
      <xloc>736</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>job_data_vault_create_link_run_table</name>
    <type>WorkflowExecutor</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <execution_errors_field>ExecutionNrErrors</execution_errors_field>
    <execution_exit_status_field>ExecutionExitStatus</execution_exit_status_field>
    <execution_files_retrieved_field>ExecutionFilesRetrieved</execution_files_retrieved_field>
    <execution_lines_deleted_field>ExecutionLinesDeleted</execution_lines_deleted_field>
    <execution_lines_input_field>ExecutionLinesInput</execution_lines_input_field>
    <execution_lines_output_field>ExecutionLinesOutput</execution_lines_output_field>
    <execution_lines_read_field>ExecutionLinesRead</execution_lines_read_field>
    <execution_lines_rejected_field>ExecutionLinesRejected</execution_lines_rejected_field>
    <execution_lines_updated_field>ExecutionLinesUpdated</execution_lines_updated_field>
    <execution_lines_written_field>ExecutionLinesWritten</execution_lines_written_field>
    <execution_log_channelid_field>ExecutionLogChannelId</execution_log_channelid_field>
    <execution_log_text_field>ExecutionLogText</execution_log_text_field>
    <execution_result_field>ExecutionResult</execution_result_field>
    <execution_time_field>ExecutionTime</execution_time_field>
    <filename>${PROJECT_HOME}/data_vault/job_data_vault_create_link_run_table.hwf</filename>
    <group_size>1</group_size>
    <inherit_all_vars>Y</inherit_all_vars>
    <parameters>
      <variablemapping>
        <field>create_ix_link_run_stmt</field>
        <variable>create_ix_link_run_stmt</variable>
      </variablemapping>
      <variablemapping>
        <field>lnk_bk_columns</field>
        <variable>lnk_bk_columns</variable>
      </variablemapping>
      <variablemapping>
        <field>lnk_key</field>
        <variable>lnk_key</variable>
      </variablemapping>
      <variablemapping>
        <field>lnk_name</field>
        <variable>lnk_name</variable>
      </variablemapping>
      <variablemapping>
        <field>lnk_no_bk_columns</field>
        <variable>lnk_no_bk_columns</variable>
      </variablemapping>
      <variablemapping>
        <field>lnk_updateable_attributes</field>
        <variable>lnk_updateable_attributes</variable>
      </variablemapping>
      <variablemapping>
        <field>lnk_updateable_hub_keys</field>
        <variable>lnk_updateable_hub_keys</variable>
      </variablemapping>
    </parameters>
    <result_files_file_name_field>FileName</result_files_file_name_field>
    <run_configuration>local</run_configuration>
    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>ref_data_vault_links_and_link_sources</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select     distinct
           links.link_key                                                   as lnk_key
,          links.link_name                                                  as lnk_name
,          case 
                when hub_10.hub_name is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key, '
                                                                  ,coalesce(links.link_hub_7_key_column,hub_7.hub_key),' as hub_7_key, '
                                                                  ,coalesce(links.link_hub_8_key_column,hub_8.hub_key),' as hub_8_key, '
                                                                  ,coalesce(links.link_hub_9_key_column,hub_9.hub_key),' as hub_9_key, '
                                                                  ,coalesce(links.link_hub_10_key_column,hub_10.hub_key),' as hub_10_key ')
                when hub_9.hub_name  is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key, '
                                                                  ,coalesce(links.link_hub_7_key_column,hub_7.hub_key),' as hub_7_key, '
                                                                  ,coalesce(links.link_hub_8_key_column,hub_8.hub_key),' as hub_8_key, '
                                                                  ,coalesce(links.link_hub_9_key_column,hub_9.hub_key),' as hub_9_key ')
                when hub_8.hub_name  is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key, '
                                                                  ,coalesce(links.link_hub_7_key_column,hub_7.hub_key),' as hub_7_key, '
                                                                  ,coalesce(links.link_hub_8_key_column,hub_8.hub_key),' as hub_8_key ')
                when hub_7.hub_name  is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key, '
                                                                  ,coalesce(links.link_hub_7_key_column,hub_7.hub_key),' as hub_7_key ')
                when hub_6.hub_name  is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key ')
                when hub_5.hub_name is not null  then       concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key ')
                when hub_4.hub_name is not null then        concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key ')
                when hub_3.hub_name is not null then        concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key ')
                when hub_2.hub_name is not null  then       concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key ')
                else  concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key ')
            end                                as lnk_updateable_hub_keys
,           case 
                when lnka.id_data_vault_link is not null then concat(',',lnka.link_attributes_dv)
                else ''      
            end                                as lnk_updateable_attributes
,           links.lnk_bk_columns
,           links.lnk_no_bk_columns
,           case when links.lnk_bk_columns is null and links.lnk_group_key_column is null then ''
                 when links.lnk_bk_columns is not null then       concat('create index ix_',links.link_name,'_run on ',links.link_name,'_run(record_source_id,load_dts,',links.lnk_bk_columns,',',links.lnk_no_bk_columns,');')
                 when links.lnk_group_key_column is not null then concat('create index ix_',links.link_name,'_run on ',links.link_name,'_run(',links.lnk_group_key_column,',',links.lnk_no_group_key_columns,',record_source_id,load_dts);')
                 else ''
            end                                as create_ix_link_run_stmt
from            ref_data_vault_links            links
inner join      ref_data_vault_link_sources     lsource
on              links.id_data_vault_link      = lsource.id_data_vault_link
left outer join ref_data_vault_link_attributes  lnka
on              links.id_data_vault_link    = lnka.id_data_vault_link
and             lsource.record_source_id    = lnka.record_source_id
inner join      ref_data_vault_hubs           hub_1
on              links.id_data_vault_hub_1   = hub_1.id_data_vault_hub
inner join      ref_source_tables             srctab
on              lsource.record_source_id    = srctab.id_srctab
inner join      ref_source_systems            srcsys
on              srctab.id_srcsys            = srcsys.id_srcsys
left outer join ref_data_vault_hubs           hub_2
on              links.id_data_vault_hub_2   = hub_2.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_3
on              links.id_data_vault_hub_3   = hub_3.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_4
on              links.id_data_vault_hub_4   = hub_4.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_5
on              links.id_data_vault_hub_5   = hub_5.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_6
on              links.id_data_vault_hub_6   = hub_6.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_7
on              links.id_data_vault_hub_7   = hub_7.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_8
on              links.id_data_vault_hub_8   = hub_8.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_9
on              links.id_data_vault_hub_9   = hub_9.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_10
on              links.id_data_vault_hub_10  = hub_10.id_data_vault_hub
where           links.ind_current           = 1
and             lsource.ind_current         = 1
and             links.id_data_vault         = ${id_data_vault}
and             (links.lnk_bk_columns is not null or lsource.ind_status_sat = 1 or links.lnk_group_key_column is not null) 
order by        links.link_key</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

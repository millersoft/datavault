      <width>224</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>ref_data_vault_links_and_link_sources</from>
      <to>Copy rows to result</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>Job successful?</from>
      <to>Ignore successful jobs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Job successful?</from>
      <to>Abort when a job has an exit status &lt;&gt; Y</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>ref_data_vault_links_and_link_sources</from>
      <to>job_data_vault_create_link_run_table</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>job_data_vault_create_link_run_table</from>
      <to>Job successful?</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Abort when a job has an exit status &lt;&gt; Y</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>736</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Copy rows to result</name>
    <type>RowsToResult</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ignore successful jobs</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>928</xloc>
      <yloc>96</yloc>
    </GUI>

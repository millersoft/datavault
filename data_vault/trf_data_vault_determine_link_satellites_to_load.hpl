    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>ref_data_vault_link_satellites</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select     sats.sat_name                                                    as sat_name
,          sats.sat_key                                                     as sat_key
,          links.link_key                                                   as lnk_key
,          links.link_name                                                  as lnk_name
,          coalesce(srctab.staging_table_name,srctab.table_name)              as sat_source
,          coalesce(hub_1.hub_name,'hub_dummy')                               as lnk_hub_1_name
,          coalesce(sats.sat_source_hub_1_business_key,'''''-1''''')                  as sat_source_hub_1_business_key
,          coalesce(hub_2.hub_name,'hub_dummy')                               as lnk_hub_2_name
,          coalesce(sats.sat_source_hub_2_business_key,'''''-1''''')                  as sat_source_hub_2_business_key
,          coalesce(hub_3.hub_name,'hub_dummy')                               as lnk_hub_3_name
,          coalesce(sats.sat_source_hub_3_business_key,'''''-1''''')                  as sat_source_hub_3_business_key
,          coalesce(hub_4.hub_name,'hub_dummy')                               as lnk_hub_4_name
,          coalesce(sats.sat_source_hub_4_business_key,'''''-1''''')                  as sat_source_hub_4_business_key
,          coalesce(hub_5.hub_name,'hub_dummy')                               as lnk_hub_5_name
,          coalesce(sats.sat_source_hub_5_business_key,'''''-1''''')                  as sat_source_hub_5_business_key
,          coalesce(hub_6.hub_name,'hub_dummy')                               as lnk_hub_6_name
,          coalesce(sats.sat_source_hub_6_business_key,'''''-1''''')                  as sat_source_hub_6_business_key
,          coalesce(hub_7.hub_name,'hub_dummy')                               as lnk_hub_7_name
,          coalesce(sats.sat_source_hub_7_business_key,'''''-1''''')                  as sat_source_hub_7_business_key
,          coalesce(hub_8.hub_name,'hub_dummy')                               as lnk_hub_8_name
,          coalesce(sats.sat_source_hub_8_business_key,'''''-1''''')                  as sat_source_hub_8_business_key
,          coalesce(hub_9.hub_name,'hub_dummy')                               as lnk_hub_9_name
,          coalesce(sats.sat_source_hub_9_business_key,'''''-1''''')                  as sat_source_hub_9_business_key
,          coalesce(hub_10.hub_name,'hub_dummy')                              as lnk_hub_10_name
,          coalesce(sats.sat_source_hub_10_business_key,'''''-1''''')                 as sat_source_hub_10_business_key
,          sats.sat_attributes                                              as sat_attributes
,          sats.sat_attributes_dv                                           as sat_attributes_dv
,          case when conn.type in ('MySQL','PostgreSQL') then sats.sat_attributes_concat
                else ''
           end                                                              as sat_attributes_concat
,          sats.sat_attributes_concat_dv                                    as sat_attributes_concat_dv
,          sats.record_source_id                                            as sat_source_record_source_id
,          coalesce(srcsys.id_staging_connection,srcsys.id_source_connection) as id_connection
,          case when conn.name in ('staging','STG') and hub_10.hub_name is not null then 'trf_data_vault_link_sat_generic_10_hubs_source_is_STG'
                when conn.name in ('staging','STG') and hub_9.hub_name  is not null then 'trf_data_vault_link_sat_generic_09_hubs_source_is_STG'
                when conn.name in ('staging','STG') and hub_8.hub_name  is not null then 'trf_data_vault_link_sat_generic_08_hubs_source_is_STG'
                when conn.name in ('staging','STG') and hub_7.hub_name  is not null then 'trf_data_vault_link_sat_generic_07_hubs_source_is_STG'
                when conn.name in ('staging','STG') and hub_6.hub_name  is not null then 'trf_data_vault_link_sat_generic_06_hubs_source_is_STG'
                when conn.name in ('staging','STG') and hub_5.hub_name  is not null then 'trf_data_vault_link_sat_generic_05_hubs_source_is_STG'
                when conn.name in ('staging','STG') and hub_4.hub_name  is not null then 'trf_data_vault_link_sat_generic_04_hubs_source_is_STG'
                when conn.name in ('staging','STG') and hub_3.hub_name  is not null then 'trf_data_vault_link_sat_generic_03_hubs_source_is_STG'
                when conn.name in ('staging','STG') and hub_2.hub_name  is not null then 'trf_data_vault_link_sat_generic_02_hubs_source_is_STG'
                when hub_2.hub_name  is not null then 'trf_data_vault_link_sat_generic_02_hubs_source_is_STG'
                when conn.name in ('staging','STG') and hub_1.hub_name  is not null then 'trf_data_vault_link_sat_generic_01_hubs_source_is_STG'                
           end                                                              as sat_transformation_to_execute
,          case when conn.type in ('MySQL','PostgreSQL') then sats.sat_lnk_key_attributes_concat
                else ''
           end                                                              as sat_lnk_key_attributes_concat
,          case
               when hub_10.hub_name is not null then 10
               when hub_9.hub_name  is not null then 9
               when hub_8.hub_name  is not null then 8
               when hub_7.hub_name  is not null then 7
               when hub_6.hub_name  is not null then 6
               when hub_5.hub_name  is not null then 5
               when hub_4.hub_name  is not null then 4
               when hub_3.hub_name  is not null then 3
               when hub_2.hub_name  is not null then 2
               else 1 
           end                                                              as lnk_number_of_hubs
,          srctab.id_srcsys                                                 as id_srcsys
from            ref_data_vault_link_satellites sats
inner join      ref_data_vault_links           links
on              sats.id_data_vault_link      = links.id_data_vault_link
inner join      ref_source_tables              srctab
on              sats.record_source_id        = srctab.id_srctab
inner join      ref_source_systems             srcsys
on              srctab.id_srcsys             = srcsys.id_srcsys
inner join      ref_connections               conn
on              coalesce(srcsys.id_staging_connection,srcsys.id_source_connection) = conn.id_connection
left outer join ref_data_vault_hubs            hub_1
on              links.id_data_vault_hub_1    = hub_1.id_data_vault_hub
left outer join ref_data_vault_hubs            hub_2
on              links.id_data_vault_hub_2    = hub_2.id_data_vault_hub
left outer join ref_data_vault_hubs            hub_3
on              links.id_data_vault_hub_3    = hub_3.id_data_vault_hub
left outer join ref_data_vault_hubs            hub_4
on              links.id_data_vault_hub_4    = hub_4.id_data_vault_hub
left outer join ref_data_vault_hubs            hub_5
on              links.id_data_vault_hub_5    = hub_5.id_data_vault_hub
left outer join ref_data_vault_hubs            hub_6
on              links.id_data_vault_hub_6    = hub_6.id_data_vault_hub
left outer join ref_data_vault_hubs            hub_7
on              links.id_data_vault_hub_7    = hub_7.id_data_vault_hub
left outer join ref_data_vault_hubs            hub_8
on              links.id_data_vault_hub_8    = hub_8.id_data_vault_hub
left outer join ref_data_vault_hubs            hub_9
on              links.id_data_vault_hub_9    = hub_9.id_data_vault_hub
left outer join ref_data_vault_hubs            hub_10
on              links.id_data_vault_hub_10   = hub_10.id_data_vault_hub
where           sats.ind_current             = 1
-- and             mod(sats.id_data_vault_link_sat,4) = ${mod_4_value}
and             links.id_data_vault                = ${id_data_vault}
and             (   ${subruntype} = 0 
                 or ${PROP_DATABASE_STRING_SEARCH_FUNCTION}(concat('|',cast(${subruntype} as char),'|'),sats.process_in_subruntypes) > 0
                )</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

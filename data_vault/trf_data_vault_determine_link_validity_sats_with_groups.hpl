<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_data_vault_determine_link_validity_sats_with_groups</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Determine link validy satellites with groups</description>
    <extended_description>This transformation determines all links with a defines 'group_key_column'.</extended_description>
    <pipeline_version>1.3</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>id_data_vault</name>
        <default_value>1</default_value>
        <description/>
      </parameter>
      <parameter>
        <name>ind_invalidate_or_clean</name>
        <default_value>0</default_value>
        <description/>
      </parameter>
      <parameter>
        <name>ind_process_validity_sat</name>
        <default_value>1</default_value>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:36.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2017/05/03 16:28:59.125</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Arial</fontname>
      <fontsize>9</fontsize>
      <height>21</height>
      <xloc>32</xloc>
      <yloc>16</yloc>
      <note>Description: see transformation settings</note>
      <width>224</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>ref_data_vault_links_and_link_sources</from>
      <to>Split 'lnk_no_group_key_columns' (max 10)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Split 'lnk_no_group_key_columns' (max 10)</from>
      <to>Formula for 'join_condition'</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Job successful?</from>
      <to>Ignore successful jobs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Job successful?</from>
      <to>Abort when a job has an exit status &lt;&gt; Y</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>job_data_vault_load_link_satellite_group_validity</from>
      <to>Job successful?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Formula for 'join_condition'</from>
      <to>job_data_vault_load_link_satellite_group_validity</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Formula for 'join_condition'</from>
      <to>Copy rows to result</to>
      <enabled>N</enabled>
    </hop>
  </order>
  <transform>
    <name>Abort when a job has an exit status &lt;&gt; Y</name>
    <type>Abort</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <abort_option>ABORT</abort_option>
    <always_log_rows>Y</always_log_rows>
    <row_threshold>0</row_threshold>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Copy rows to result</name>
    <type>RowsToResult</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>1024</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Formula for 'join_condition'</name>
    <type>Formula</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formulas>
      <formula>
        <field_name>join_condition</field_name>
        <formula>IF(ISBLANK([lnk_group_key_column]),""," lnk_run." &amp; [lnk_group_key_column] &amp; " = dv." &amp; [lnk_group_key_column]) &amp;
IF(ISBLANK([lnk_no_group_key_column_1]),""," AND lnk_run." &amp; [lnk_no_group_key_column_1] &amp; " = dv." &amp; [lnk_no_group_key_column_1]) &amp;
IF(ISBLANK([lnk_no_group_key_column_2]),""," AND lnk_run." &amp; [lnk_no_group_key_column_2] &amp; " = dv." &amp; [lnk_no_group_key_column_2]) &amp;
IF(ISBLANK([lnk_no_group_key_column_3]),""," AND lnk_run." &amp; [lnk_no_group_key_column_3] &amp; " = dv." &amp; [lnk_no_group_key_column_3]) &amp;
IF(ISBLANK([lnk_no_group_key_column_4]),""," AND lnk_run." &amp; [lnk_no_group_key_column_4] &amp; " = dv." &amp; [lnk_no_group_key_column_4]) &amp;
IF(ISBLANK([lnk_no_group_key_column_5]),""," AND lnk_run." &amp; [lnk_no_group_key_column_5] &amp; " = dv." &amp; [lnk_no_group_key_column_5]) &amp;
IF(ISBLANK([lnk_no_group_key_column_6]),""," AND lnk_run." &amp; [lnk_no_group_key_column_6] &amp; " = dv." &amp; [lnk_no_group_key_column_6]) &amp;
IF(ISBLANK([lnk_no_group_key_column_7]),""," AND lnk_run." &amp; [lnk_no_group_key_column_7] &amp; " = dv." &amp; [lnk_no_group_key_column_7]) &amp;
IF(ISBLANK([lnk_no_group_key_column_8]),""," AND lnk_run." &amp; [lnk_no_group_key_column_8] &amp; " = dv." &amp; [lnk_no_group_key_column_8]) &amp;
IF(ISBLANK([lnk_no_group_key_column_9]),""," AND lnk_run." &amp; [lnk_no_group_key_column_9] &amp; " = dv." &amp; [lnk_no_group_key_column_9]) &amp;
IF(ISBLANK([lnk_no_group_key_column_10]),""," AND lnk_run." &amp; [lnk_no_group_key_column_10] &amp; " = dv." &amp; [lnk_no_group_key_column_10])</formula>
        <set_na>N</set_na>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <value_type>2</value_type>
      </formula>
    </formulas>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ignore successful jobs</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Job successful?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
</conditions>
        <function>=</function>
        <leftvalue>ExecutionResult</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constant</name>
          <precision>-1</precision>
          <text>Y</text>
          <type>Boolean</type>
        </value>
      </condition>
    </compare>
    <send_false_to>Abort when a job has an exit status &lt;&gt; Y</send_false_to>
    <send_true_to>Ignore successful jobs</send_true_to>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Split 'lnk_no_group_key_columns' (max 10)</name>
    <type>FieldSplitter</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <delimiter>,</delimiter>
    <fields>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_1</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_2</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_3</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_4</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_5</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_6</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_7</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_8</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_9</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
      <field>
        <idrem>N</idrem>
        <length>-1</length>
        <name>lnk_no_group_key_column_10</name>
        <precision>-1</precision>
        <trimtype>none</trimtype>
        <type>String</type>
      </field>
    </fields>
    <splitfield>lnk_no_group_key_columns_to_split</splitfield>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>job_data_vault_load_link_satellite_group_validity</name>
    <type>WorkflowExecutor</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <execution_errors_field>ExecutionNrErrors</execution_errors_field>
    <execution_exit_status_field>ExecutionExitStatus</execution_exit_status_field>
    <execution_files_retrieved_field>ExecutionFilesRetrieved</execution_files_retrieved_field>
    <execution_lines_deleted_field>ExecutionLinesDeleted</execution_lines_deleted_field>
    <execution_lines_input_field>ExecutionLinesInput</execution_lines_input_field>
    <execution_lines_output_field>ExecutionLinesOutput</execution_lines_output_field>
    <execution_lines_read_field>ExecutionLinesRead</execution_lines_read_field>
    <execution_lines_rejected_field>ExecutionLinesRejected</execution_lines_rejected_field>
    <execution_lines_updated_field>ExecutionLinesUpdated</execution_lines_updated_field>
    <execution_lines_written_field>ExecutionLinesWritten</execution_lines_written_field>
    <execution_log_channelid_field>ExecutionLogChannelId</execution_log_channelid_field>
    <execution_log_text_field>ExecutionLogText</execution_log_text_field>
    <execution_result_field>ExecutionResult</execution_result_field>
    <execution_time_field>ExecutionTime</execution_time_field>
    <group_size>1</group_size>
    <inherit_all_vars>Y</inherit_all_vars>
    <parameters>
</parameters>
    <result_files_file_name_field>FileName</result_files_file_name_field>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform>
    <name>ref_data_vault_links_and_link_sources</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select     DISTINCT
           links.link_name                 as lnk_name
,          links.link_key                  as lnk_key
,          links.lnk_group_key_column      as lnk_group_key_column
,          links.lnk_no_group_key_columns  as lnk_no_group_key_columns    
,          link_src.system_source_id       as lnk_source_record_source_id
,          links.lnk_no_group_key_columns  as lnk_no_group_key_columns_to_split
,          link_src.source_order
from       ref_data_vault_links               links
inner join ref_data_vault_link_sources        link_src
on         links.id_data_vault_link         = link_src.id_data_vault_link
where      link_src.ind_current             = 1
and        links.id_data_vault              = ${id_data_vault}
and        (links.lnk_group_key_column is not null and links.lnk_no_group_key_columns &lt;&gt; '')
and        (links.lnk_bk_columns       is null      or links.lnk_bk_columns            = '') 
and        (   ${subruntype} = 0 
            or ${PROP_DATABASE_STRING_SEARCH_FUNCTION}(concat('|',cast(${subruntype} as char),'|'),link_src.process_in_subruntypes) > 0
           )
order by   links.link_name
,          link_src.source_order DESC</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

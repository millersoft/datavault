    <compare>
      <condition>
        <conditions>
</conditions>
        <function>=</function>
        <leftvalue>ExecutionResult</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <value>
          <isnull>N</isnull>
          <length>-1</length>
          <name>constant</name>
          <precision>-1</precision>
          <text>Y</text>
          <type>Boolean</type>
        </value>
      </condition>
    </compare>
    <send_false_to>Abort when a job has an exit status &lt;&gt; Y</send_false_to>
    <send_true_to>Ignore successful jobs</send_true_to>
    <attributes/>

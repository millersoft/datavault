  <transform>
    <name>ref_data_vault_links</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select     links.link_key                                                   as lnk_key
,          links.link_name                                                  as lnk_name
,          links.ind_last_seen_dts                                          as ind_last_seen_dts
,          hub_1.hub_name                                                   as lnk_hub_1_name
,          hub_1.hub_business_key                                           as lnk_hub_1_business_key
,          hub_1.hub_key                                                    as lnk_hub_1_key
,          lsource.source_hub_1_business_key                                as lnk_src_hub_1_business_key
,          coalesce(hub_2.hub_name,'hub_dummy')                               as lnk_hub_2_name
,          coalesce(hub_2.hub_business_key,'hub_dummy_bk')                    as lnk_hub_2_business_key
,          coalesce(hub_2.hub_key,'hub_dummy_id')                             as lnk_hub_2_key
,          coalesce(lsource.source_hub_2_business_key,'''''-1''''')                   as lnk_src_hub_2_business_key
,          coalesce(hub_3.hub_name,'hub_dummy')                               as lnk_hub_3_name
,          coalesce(hub_3.hub_business_key,'hub_dummy_bk')                    as lnk_hub_3_business_key
,          coalesce(hub_3.hub_key,'hub_dummy_id')                             as lnk_hub_3_key
,          coalesce(lsource.source_hub_3_business_key,'''''-1''''')                     as lnk_src_hub_3_business_key
,          coalesce(hub_4.hub_name,'hub_dummy')                               as lnk_hub_4_name
,          coalesce(hub_4.hub_business_key,'hub_dummy_bk')                    as lnk_hub_4_business_key
,          coalesce(hub_4.hub_key,'hub_dummy_id')                             as lnk_hub_4_key
,          coalesce(lsource.source_hub_4_business_key,'''''-1''''')                     as lnk_src_hub_4_business_key
,          coalesce(hub_5.hub_name,'hub_dummy')                               as lnk_hub_5_name
,          coalesce(hub_5.hub_business_key,'hub_dummy_bk')                    as lnk_hub_5_business_key
,          coalesce(hub_5.hub_key,'hub_dummy_id')                             as lnk_hub_5_key
,          coalesce(lsource.source_hub_5_business_key,'''''-1''''')                     as lnk_src_hub_5_business_key
,          coalesce(hub_6.hub_name,'hub_dummy')                               as lnk_hub_6_name
,          coalesce(hub_6.hub_business_key,'hub_dummy_bk')                    as lnk_hub_6_business_key
,          coalesce(hub_6.hub_key,'hub_dummy_id')                             as lnk_hub_6_key
,          coalesce(lsource.source_hub_6_business_key,'''''-1''''')                     as lnk_src_hub_6_business_key
,          coalesce(hub_7.hub_name,'hub_dummy')                               as lnk_hub_7_name
,          coalesce(hub_7.hub_business_key,'hub_dummy_bk')                    as lnk_hub_7_business_key
,          coalesce(hub_7.hub_key,'hub_dummy_id')                             as lnk_hub_7_key
,          coalesce(lsource.source_hub_7_business_key,'''''-1''''')                     as lnk_src_hub_7_business_key
,          coalesce(hub_8.hub_name,'hub_dummy')                               as lnk_hub_8_name
,          coalesce(hub_8.hub_business_key,'hub_dummy_bk')                    as lnk_hub_8_business_key
,          coalesce(hub_8.hub_key,'hub_dummy_id')                             as lnk_hub_8_key
,          coalesce(lsource.source_hub_8_business_key,'''''-1''''')                     as lnk_src_hub_8_business_key
,          coalesce(hub_9.hub_name,'hub_dummy')                               as lnk_hub_9_name
,          coalesce(hub_9.hub_business_key,'hub_dummy_bk')                    as lnk_hub_9_business_key
,          coalesce(hub_9.hub_key,'hub_dummy_id')                             as lnk_hub_9_key
,          coalesce(lsource.source_hub_9_business_key,'''''-1''''')                     as lnk_src_hub_9_business_key
,          coalesce(hub_10.hub_name,'hub_dummy')                              as lnk_hub_10_name
,          coalesce(hub_10.hub_business_key,'hub_dummy_bk')                   as lnk_hub_10_business_key
,          coalesce(hub_10.hub_key,'hub_dummy_id')                            as lnk_hub_10_key
,          coalesce(lsource.source_hub_10_business_key,'''''-1''''')                    as lnk_src_hub_10_business_key
,          coalesce(srctab.staging_table_name,srctab.table_name)              as lnk_source
,          lsource.record_source_id                                         as lnk_source_record_source_id
,          lsource.source_order                                             as lnk_source_order
,          coalesce(srcsys.id_staging_connection,srcsys.id_source_connection) as id_connection
,          case when lnka.id_data_vault_link is null                        then 'trf_data_vault_lnk_generic_no_attributes_dv2.0'
                when lnka.id_data_vault_link is not null                    then 'trf_data_vault_lnk_generic_with_attributes_dv2.0'
           end                                                              as lnk_transformation_to_execute
,          case
               when hub_10.hub_name is not null then 10
               when hub_9.hub_name  is not null then 9
               when hub_8.hub_name  is not null then 8
               when hub_7.hub_name  is not null then 7
               when hub_6.hub_name  is not null then 6
               when hub_5.hub_name  is not null then 5
               when hub_4.hub_name  is not null then 4
               when hub_3.hub_name  is not null then 3
               when hub_2.hub_name  is not null then 2
               else 1 
           end                                                              as lnk_number_of_hubs
,          case when lnka.id_data_vault_link is null then 0 else 1 end      as lnk_ind_attributes
,          lnka.link_attributes                                             as lnk_attributes
,          case when conn.type not in ('MySQL') then coalesce(lnka.link_attributes_concat,${PROP_DUMMY_LINK_ATTRIBUTES})
                when conn.type in ('MSSQL') then coalesce(replace(replace(replace(substring(lnka.link_attributes_concat,8,length(lnka.link_attributes_concat)-8),',''|'',',' + ''|'' + '),'coalesce','coalesce'),' as char)',' as varchar)'),']#[')
                else coalesce(lnka.link_attributes_concat,${PROP_DUMMY_LINK_ATTRIBUTES})
           end                                                              as lnk_attributes_concat
,          lnka.link_attributes_dv                                          as lnk_attributes_dv
,          coalesce(lnka.link_attributes_concat_dv,${PROP_DUMMY_LINK_ATTRIBUTES}) as lnk_attributes_concat_dv        
,          coalesce(coalesce(links.link_hub_1_key_column,hub_1.hub_key),'-1')     as lnk_hub_1_key_column
,          coalesce(coalesce(links.link_hub_2_key_column,hub_2.hub_key),'-1')     as lnk_hub_2_key_column
,          coalesce(coalesce(links.link_hub_3_key_column,hub_3.hub_key),'-1')     as lnk_hub_3_key_column
,          coalesce(coalesce(links.link_hub_4_key_column,hub_4.hub_key),'-1')     as lnk_hub_4_key_column
,          coalesce(coalesce(links.link_hub_5_key_column,hub_5.hub_key),'-1')     as lnk_hub_5_key_column
,          coalesce(coalesce(links.link_hub_6_key_column,hub_6.hub_key),'-1')     as lnk_hub_6_key_column
,          coalesce(coalesce(links.link_hub_7_key_column,hub_7.hub_key),'-1')     as lnk_hub_7_key_column
,          coalesce(coalesce(links.link_hub_8_key_column,hub_8.hub_key),'-1')     as lnk_hub_8_key_column
,          coalesce(coalesce(links.link_hub_9_key_column,hub_9.hub_key),'-1')     as lnk_hub_9_key_column
,          coalesce(coalesce(links.link_hub_10_key_column,hub_10.hub_key),'-1')    as lnk_hub_10_key_column
,          case 
                when hub_10.hub_name is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key, '
                                                                  ,coalesce(links.link_hub_7_key_column,hub_7.hub_key),' as hub_7_key, '
                                                                  ,coalesce(links.link_hub_8_key_column,hub_8.hub_key),' as hub_8_key, '
                                                                  ,coalesce(links.link_hub_9_key_column,hub_9.hub_key),' as hub_9_key, '
                                                                  ,coalesce(links.link_hub_10_key_column,hub_10.hub_key),' as hub_10_key ')
                when hub_9.hub_name  is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key, '
                                                                  ,coalesce(links.link_hub_7_key_column,hub_7.hub_key),' as hub_7_key, '
                                                                  ,coalesce(links.link_hub_8_key_column,hub_8.hub_key),' as hub_8_key, '
                                                                  ,coalesce(links.link_hub_9_key_column,hub_9.hub_key),' as hub_9_key ')
                when hub_8.hub_name  is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key, '
                                                                  ,coalesce(links.link_hub_7_key_column,hub_7.hub_key),' as hub_7_key, '
                                                                  ,coalesce(links.link_hub_8_key_column,hub_8.hub_key),' as hub_8_key ')
                when hub_7.hub_name  is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key, '
                                                                  ,coalesce(links.link_hub_7_key_column,hub_7.hub_key),' as hub_7_key ')
                when hub_6.hub_name  is not null  then      concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key, '
                                                                  ,coalesce(links.link_hub_6_key_column,hub_6.hub_key),' as hub_6_key ')
                when hub_5.hub_name is not null  then       concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key, '
                                                                  ,coalesce(links.link_hub_5_key_column,hub_5.hub_key),' as hub_5_key ')
                when hub_4.hub_name is not null then        concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key, '
                                                                  ,coalesce(links.link_hub_4_key_column,hub_4.hub_key),' as hub_4_key ')
                when hub_3.hub_name is not null then        concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key, '
                                                                  ,coalesce(links.link_hub_3_key_column,hub_3.hub_key),' as hub_3_key ')
                when hub_2.hub_name is not null  then       concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key, '
                                                                  ,coalesce(links.link_hub_2_key_column,hub_2.hub_key),' as hub_2_key ')
                else  concat(coalesce(links.link_hub_1_key_column,hub_1.hub_key),' as hub_1_key ')
            end                                as lnk_updateable_hub_keys
,           case 
                when lnka.id_data_vault_link is not null then concat(',',lnka.link_attributes_dv)
                else ''      
            end                                as lnk_updateable_attributes
,           coalesce(links.lnk_bk_columns,']#[') as lnk_bk_columns
,           links.lnk_no_bk_columns            as lnk_no_bk_columns
,           lsource.ind_status_sat             as ind_status_sat
,           case when links.lnk_group_key_column is not null and links.lnk_group_key_column &lt;&gt; '' then 1
                 else 0
            end                                as ind_group_key_column    
,           srctab.id_srcsys                   as id_srcsys
from            ref_data_vault_links            links
inner join      ref_data_vault_link_sources     lsource
on              links.id_data_vault_link      = lsource.id_data_vault_link
left outer join ref_data_vault_link_attributes  lnka
on              links.id_data_vault_link    = lnka.id_data_vault_link
and             lsource.record_source_id    = lnka.record_source_id
inner join      ref_data_vault_hubs           hub_1
on              links.id_data_vault_hub_1   = hub_1.id_data_vault_hub
inner join      ref_source_tables             srctab
on              lsource.record_source_id    = srctab.id_srctab
inner join      ref_source_systems            srcsys
on              srctab.id_srcsys            = srcsys.id_srcsys
inner join      ref_connections               conn
on              coalesce(srcsys.id_staging_connection,srcsys.id_source_connection) = conn.id_connection
left outer join ref_data_vault_hubs           hub_2
on              links.id_data_vault_hub_2   = hub_2.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_3
on              links.id_data_vault_hub_3   = hub_3.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_4
on              links.id_data_vault_hub_4   = hub_4.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_5
on              links.id_data_vault_hub_5   = hub_5.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_6
on              links.id_data_vault_hub_6   = hub_6.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_7
on              links.id_data_vault_hub_7   = hub_7.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_8
on              links.id_data_vault_hub_8   = hub_8.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_9
on              links.id_data_vault_hub_9   = hub_9.id_data_vault_hub
left outer join ref_data_vault_hubs           hub_10
on              links.id_data_vault_hub_10  = hub_10.id_data_vault_hub
where           links.ind_current           = 1
and             lsource.ind_current         = 1
-- and             mod(links.id_data_vault_link,4) = ${mod_4_value}
and             links.id_data_vault             = ${id_data_vault}
and             (   ${subruntype} = 0 
                 or ${PROP_DATABASE_STRING_SEARCH_FUNCTION}(concat('|',cast(${subruntype} as char),'|'),lsource.process_in_subruntypes) > 0
                )
order by        links.link_key
,               lsource.source_order</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

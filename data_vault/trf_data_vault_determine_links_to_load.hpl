    </notepad>
  </notepads>
  <order>
    <hop>
      <from>ref_data_vault_links</from>
      <to>Copy rows to result</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>Job successful?</from>
      <to>Ignore successful jobs</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Job successful?</from>
      <to>Abort when a job has an exit status &lt;&gt; Y</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>ref_data_vault_links</from>
      <to>job_data_vault_load_link</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>job_data_vault_load_link</from>
      <to>Job successful?</to>
      <enabled>Y</enabled>
    </hop>
  </order>

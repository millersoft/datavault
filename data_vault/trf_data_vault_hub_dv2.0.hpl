  <transform>
    <name>hub_dummy</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select dummy.*
,      ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as load_dts
from   (
        SELECT   public.digest(cast('-1' as text), 'sha256') as ${hub_key}
        ,        cast('-1' as char(2))                       as ${hub_business_key}
        ,        0                                           as record_source_id
        ,        stg.tenant_id                               as tenant_id
        FROM ${staging_schema_name}.${staging_prefix}${hub_source} stg
        LIMIT 1
       ) dummy
left outer join vw_${hub_name}_lkp hub
on              dummy.${hub_business_key} = hub.hub_business_key_dv
and             dummy.tenant_id = hub.tenant_id
where           hub.hub_business_key_dv IS NULL
or              dummy.tenant_id IS NULL;</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>368</yloc>
    </GUI>
  </transform>

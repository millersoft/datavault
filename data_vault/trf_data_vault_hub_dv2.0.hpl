  <transform>
    <name>hub_src</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT   DISTINCT
         ${hub_source_hash_key}     	as hub_key
,        ${hub_source_business_key}     as hub_business_key
,		 tenant_id			  as tenant_id
,        ${hub_source_record_source_id} as record_source_id
,        ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as load_dts
,		 ${ind_status_sat}				as ind_status_sat
FROM     ${staging_schema_name}.${staging_prefix}${hub_source} STG
WHERE NOT EXISTS
(
	select 1
	from ${data_vault_schema_name}.vw_${hub_name}_lkp H
	where STG.${hub_source_hash_key} = H.hub_key_dv
	and STG.tenant_id = H.tenant_id
)
AND ${hub_source_business_key} IS NOT NULL
AND tenant_id IS NOT NULL
</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>176</xloc>
      <yloc>320</yloc>
    </GUI>

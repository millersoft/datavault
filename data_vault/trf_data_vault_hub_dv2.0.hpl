<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_data_vault_hub_dv2.0</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: hub</description>
    <extended_description>This transformation loads a Data Vault hub from 1 source table.
A hub can be filled by more then 1 source table, in which case this transformation runs multiple times,
each time with another table as the source.
</extended_description>
    <pipeline_version>1.14</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>

      <to>Dummy (do nothing)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Skip run table?</from>
      <to>Select columns for run table</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select columns for run table</from>
      <to>vw_${hub_name}_run_upd</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>vw_${hub_name}_run_upd</from>
      <to>Ignore run-table errors</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove Unused (keep last_seen_dts)</from>
      <to>Dummy (do nothing) 2</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove Unused (remove last_seen_dts)</from>
      <to>Dummy (do nothing) 2</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Dummy (do nothing) 2</from>
      <to>hub_dv_insert</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove Unused (keep last_seen_dts)</from>
      <to>PostgreSQL Bulk Loader</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>Remove Unused (remove last_seen_dts)</from>
      <to>PostgreSQL Bulk Loader No Exist</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>PostgreSQL Bulk Loader</from>
      <to>hub_dv_errors</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>PostgreSQL Bulk Loader No Exist</from>
      <to>hub_dv_errors</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>last_seen_dts existing?</from>
      <to>Dummy (do nothing) 3</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Dummy (do nothing) 3</from>
      <to>Update 'last_seen_dts' existing</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup hub in DV</from>
      <to>New?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>New?</from>
      <to>last_seen_dts existing?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>last_seen_dts existing?</from>
      <to>Ignore existing</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get transformation and job batch ID</from>
      <to>Set var_etl_trf_id_batch and var_etl_job_id_job</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup hub in DV</from>
      <to>Skip run table?</to>
      <enabled>Y</enabled>
    </hop>
  </order>

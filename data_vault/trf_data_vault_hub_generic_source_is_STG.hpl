      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>last_seen_dts dummy?</from>
      <to>Remove Unused dummy (remove last_seen_dts)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove Unused dummy (keep last_seen_dts)</from>

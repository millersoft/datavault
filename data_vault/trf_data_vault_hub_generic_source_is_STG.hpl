<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_data_vault_hub_generic_source_is_STG</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: hub</description>
    <extended_description>This transformation loads a Data Vault hub from 1 source table.
A hub can be filled by more then 1 source table, in which case this transformation runs multiple times,
each time with another table as the source.
</extended_description>
    <pipeline_version>1.14</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>hub_business_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>hub_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>hub_name</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>hub_source</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>hub_source_business_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>hub_source_record_source_id</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>ind_last_seen_dts</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>ind_status_sat</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:37.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2017/03/06 12:25:04.352</modified_date>
  </info>
  <notepads>

  <transform>
    <name>Update 'last_seen_dts' existing</name>
    <type>Update</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>4</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>data_vault</connection>
    <error_ignored>N</error_ignored>
    <lookup>

  <transform>
    <name>hub_dummy</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select dummy.*
,      ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as load_dts
,      ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as last_seen_dts
,      ${ind_last_seen_dts}                as ind_last_seen_dts
from   (SELECT   md5('-1')                        as ${hub_key}

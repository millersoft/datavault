  <transform>
    <name>lsat_dv_insert</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>${LINKSAT_INSERT_COPIES}</copies>
    <partitioning>

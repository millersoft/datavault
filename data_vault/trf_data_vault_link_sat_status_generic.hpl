<pipeline>
  <info>
    <name>trf_data_vault_link_sat_status_generic</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: link status satellite</description>
    <extended_description>This transformation processes a link status satellite. 
For this to work correctly the staging table must contain ALL links from the source (FULL load).

The following scenarios result in actions:

Situation  The link is in the source delivery and has no current entry in the status satellite for this source:
Result     Insert into status satellite with the correct record_source_id, operation = 'I' (insert) and ind_deleted = 0

Situation  The link is in the source delivery and has a current entry in the status satellite for this source, but with ind_deleted = 1 (a re-entry of the link):
Result     Update of the previous entry in the satellite for this source.  The 'deleted' version is end-dated.
           Insert into status satellite with the correct record_source_id, operation = 'I' (insert) and ind_deleted = 0

Situation  The link is NOT in the source delivery and has a current entry in the status satellite for this source, but with ind_deleted = 0:
Result     Update of the previous entry in the satellite for this source.  The 'inserted' version is end-dated.
           Insert into status satellite with the correct record_source_id, operation = 'D' (insert) and ind_deleted = 1
</extended_description>
    <pipeline_version>1.5</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <directory>/data_vault</directory>
    <parameters>
      <parameter>
        <name>lnk_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_name</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>record_source_id</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>

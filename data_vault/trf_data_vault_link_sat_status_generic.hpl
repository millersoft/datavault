        <field>lnk_key</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>record_source_id</name>
        <field>record_source_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>load_end_dts</name>
        <field>load_end_dts</field>
        <condition>= ~NULL</condition>
        <name2/>
      </key>
      <value>

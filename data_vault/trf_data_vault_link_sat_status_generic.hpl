      <to>Insert new row in status satellite</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>hub_dummy</from>
      <to>Insert row in status satellite for dummy</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>

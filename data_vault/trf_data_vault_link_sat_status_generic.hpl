    <skip_lookup>N</skip_lookup>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <use_batch>N</use_batch>
    <error_ignored>Y</error_ignored>
    <ignore_flag_field/>
    <lookup>
      <schema/>
      <table>vw_sat_${lnk_name}_status_upd</table>
      <key>

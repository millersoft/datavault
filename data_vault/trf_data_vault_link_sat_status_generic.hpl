  <transform>
    <name>New and deleted links</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <sql>select          distinct
                dv_link.tenant_id	as	tenant_id
,				dv_link.record_source_id as record_source_id
,               dv_link.${lnk_key}                  as lnk_key
,               'I'                                 as operation
,               0                                   as ind_deleted
,               dv_link.load_dts                    as load_dts
-- ,               ${PROP_LOAD_END_DTS_LATEST}         as load_end_dts
from            ${lnk_name}                            dv_link
left outer join sat_${lnk_name}_status                 dv_sat
on              dv_link.${lnk_key}                   = dv_sat.${lnk_key}
and             dv_link.tenant_id                  = dv_sat.tenant_id
where           dv_sat.${lnk_key} is null
and				dv_link.${lnk_key} is not null
and				dv_link.tenant_id is not null
UNION ALL
select          distinct
                lnk_run.tenant_id	as	tenant_id
,				lnk_run.record_source_id as record_source_id
,               lnk_run.${lnk_key}                  as lnk_key
,               'I'                                 as operation
,               0                                   as ind_deleted
,               ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST}  as load_dts
-- ,               ${PROP_LOAD_END_DTS_LATEST}         as load_end_dts
from            ${lnk_name}_run                        lnk_run
inner join      ${lnk_name}                            dv_link
on              lnk_run.${lnk_key}                   = dv_link.${lnk_key}
inner join      sat_${lnk_name}_status                 dv_sat
on              lnk_run.${lnk_key}                   = dv_sat.${lnk_key}
and             lnk_run.tenant_id             = dv_sat.tenant_id   
-- and             dv_sat.load_end_dts                  ${PROP_LOAD_END_DTS_LATEST_COND}
where             dv_sat.ind_deleted = 1
UNION ALL
select          distinct
                dv_link.tenant_id	as	tenant_id
,				dv_link.record_source_id as record_source_id
,               dv_link.${lnk_key}                  as lnk_key
,               'D'                                 as operation
,               1                                   as ind_deleted
,               ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST}  as load_dts
-- ,               ${PROP_LOAD_END_DTS_LATEST}         as load_end_dts
from            ${lnk_name}                            dv_link
inner join      sat_${lnk_name}_status                 dv_sat
on              dv_link.${lnk_key}                   = dv_sat.${lnk_key}
and             dv_link.tenant_id                  = dv_sat.tenant_id    
-- and             dv_sat.load_end_dts                  ${PROP_LOAD_END_DTS_LATEST_COND}    
left outer join ${lnk_name}_run                        lnk_run
on              dv_sat.${lnk_key}                    = lnk_run.${lnk_key}
and             dv_sat.tenant_id                  = lnk_run.tenant_id
where             (lnk_run.${lnk_key} is null and dv_sat.ind_deleted = 0)



</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <GUI>
      <xloc>96</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Set var_etl_trf_id_batch and var_etl_job_id_job</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <field_name>var_etl_trf_id_batch</field_name>
        <variable_name>var_etl_trf_id_batch</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>var_etl_job_id_job</field_name>
        <variable_name>var_etl_job_id_job</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <cluster_schema/>
    <GUI>
      <xloc>960</xloc>
      <yloc>32</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>hub_dummy</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <sql>select          0                                   as record_source_id
,				'NO SYSTEM'									as tenant_id
,               dv_link.${lnk_key}                   as lnk_key
,               'I'                                 as operation
,               0                                   as ind_deleted
,               dv_link.load_dts                     as load_dts
-- ,               ${PROP_LOAD_END_DTS_LATEST}         as load_end_dts
from            ${lnk_name}                            dv_link
where           dv_link.${lnk_key}                    = upper(md5(cast('-1' as varchar)))
and not exists(select 1 from sat_${lnk_name}_status where ${lnk_key} = upper(md5(cast('-1' as varchar))))</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <GUI>
      <xloc>112</xloc>
      <yloc>400</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>Insert new row in status satellite</source_transform>
      <target_transform>Insert satellite (errors)</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>etl_err_noe</nr_valuename>
      <descriptions_valuename>etl_err_desc</descriptions_valuename>
      <fields_valuename>etl_err_col</fields_valuename>
      <codes_valuename>etl_err_cod</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
</pipeline>

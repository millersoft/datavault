<pipeline>
  <info>
    <name>trf_data_vault_link_sat_validity_generic_b</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: link validity satellite part b</description>
    <extended_description>See the description of trf_data_vault_link_sat_validity_generic_a.</extended_description>
    <pipeline_version>1.6</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <directory>/data_vault</directory>
    <parameters>
      <parameter>
        <name>join_condition</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>join_condition_old</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_bk_columns</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_name</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_no_bk_columns</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_source_record_source_id</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:40.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2017/05/04 17:28:37.360</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Description: see transformation settings</note>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <width>273</width>
      <heigth>27</heigth>
      <fontname>Arial</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorblue>0</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
    <notepad>
      <note>Necessary columns:

link_key
ind_valid
load_dts
load_end_dts
record_source_id</note>
      <xloc>1248</xloc>
      <yloc>96</yloc>
      <width>172</width>
      <heigth>147</heigth>
      <fontname>Ariel</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorblue>0</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Insert valid satellite</from>
      <to>Insert satellite (errors)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Close possible satellite where load_end_dts = 'current'</from>
      <to>Insert valid satellite Mapping</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Insert valid satellite Mapping</from>
      <to>Insert valid satellite</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Links with changed no_bk_attributes</from>
      <to>Close possible satellite where load_end_dts = 'current'</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get transformation and job batch ID</from>
      <to>Set var_etl_trf_id_batch and var_etl_job_id_job</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Close possible satellite where load_end_dts = 'current'</name>
    <type>Update</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <skip_lookup>N</skip_lookup>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <use_batch>N</use_batch>
    <error_ignored>Y</error_ignored>
    <ignore_flag_field/>
    <lookup>
      <schema/>
      <table>vw_sat_${lnk_name}_valid_upd</table>
      <key>
        <name>lnk_key</name>
        <field>lnk_key</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>load_end_dts</name>
        <field>load_end_dts</field>
        <condition>= ~NULL</condition>
        <name2/>
      </key>
      <value>
        <name>load_end_dts</name>
        <rename>load_dts</rename>
      </value>
    </lookup>
    <cluster_schema/>
    <GUI>
      <xloc>512</xloc>
      <yloc>224</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Get transformation and job batch ID</name>
    <type>SystemInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>var_etl_trf_id_batch</name>
        <type>batch ID</type>
      </field>
      <field>
        <name>var_etl_job_id_job</name>
        <type>job batch ID</type>
      </field>
    </fields>
    <cluster_schema/>
    <GUI>
      <xloc>448</xloc>
      <yloc>32</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Insert satellite (errors)</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <schema/>
    <table>vw_sat_${lnk_name}_valid_err</table>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>N</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
    </fields>
    <cluster_schema/>
    <GUI>
      <xloc>1184</xloc>
      <yloc>384</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Insert valid satellite</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <schema/>
    <table>vw_sat_${lnk_name}_valid_upd</table>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>N</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
    </fields>
    <cluster_schema/>
    <GUI>
      <xloc>1184</xloc>
      <yloc>224</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Insert valid satellite Mapping</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>lnk_key</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>ind_valid_1</name>
        <rename>ind_valid</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>record_source_id</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>load_dts</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>load_end_dts</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <cluster_schema/>
    <GUI>
      <xloc>896</xloc>
      <yloc>224</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Links with changed no_bk_attributes</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <sql>select          distinct
                lnk_run.record_source_id            as record_source_id
,				lnk_run.tenant_id					as tenant_id
,               1                                   as ind_valid_1
,               0                                   as ind_valid_0
,               lnk_run.load_dts                    as load_dts
,               ${PROP_LOAD_END_DTS_LATEST}         as load_end_dts
,               dv.lnk_key                          as lnk_key
,               coalesce(sat_to_close.lnk_key,-1)   as lnk_key_old
from            vw_${lnk_name}_run_lkp                 lnk_run
inner join      vw_${lnk_name}_valid_lkp               dv
on              ${join_condition}
left outer join vw_sat_${lnk_name}_valid_upd             sat
on              dv.lnk_key                            =  sat.lnk_key
and		dv.tenant_id	=	sat.tenant_id
and             sat.ind_valid                         = 1
and             sat.load_end_dts                      ${PROP_LOAD_END_DTS_LATEST_COND}
left outer join 
(
select          dv_old.*
from            vw_${lnk_name}_valid_lkp                 dv_old
inner join      vw_sat_${lnk_name}_valid_upd             sat_old
on              dv_old.lnk_key                        =  sat_old.lnk_key
and 	dv_old.tenant_id	=	sat_old.tenant_id
and             sat_old.ind_valid                     = 1
and             sat_old.load_end_dts                  ${PROP_LOAD_END_DTS_LATEST_COND}
)                                                        sat_to_close
on              ${join_condition_old}
where           sat.lnk_key                           is null
-- and             lnk_run.record_source_id              = ${lnk_source_record_source_id}

</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <GUI>
      <xloc>160</xloc>
      <yloc>224</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Set var_etl_trf_id_batch and var_etl_job_id_job</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <field_name>var_etl_trf_id_batch</field_name>
        <variable_name>var_etl_trf_id_batch</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>var_etl_job_id_job</field_name>
        <variable_name>var_etl_job_id_job</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <cluster_schema/>
    <GUI>
      <xloc>960</xloc>
      <yloc>32</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>Insert valid satellite</source_transform>
      <target_transform>Insert satellite (errors)</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>etl_err_noe</nr_valuename>
      <descriptions_valuename>etl_err_desc</descriptions_valuename>
      <fields_valuename>etl_err_col</fields_valuename>
      <codes_valuename>etl_err_cod</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
</pipeline>

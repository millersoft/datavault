        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>ind_valid_1</name>
        <field>load_end_dts_is_latest</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>exists_in_dv</name>
        <rename>exists_in_dv_invalid</rename>
        <default>0</default>
        <type>Integer</type>
      </value>
    </lookup>
    <cluster_schema/>
    <GUI>
      <xloc>736</xloc>

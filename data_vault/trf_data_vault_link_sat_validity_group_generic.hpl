  <order>
    <hop>
      <from>Insert valid satellite</from>
      <to>Insert valid satellite (errors)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Insert valid satellite Mapping</from>
      <to>Insert valid satellite</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Links in group in run</from>
      <to>Lookup valid entry with load_end_dts = 'latest' default</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Already currently valid?</from>
      <to>Ignore already currently valid</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Already currently valid?</from>
      <to>Lookup invalid entry with load_end_dts = 'latest' default</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup valid entry with load_end_dts = 'latest' default</from>
      <to>Already currently valid?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Currently invalid?</from>
      <to>Close the currently invalid entry</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Currently invalid?</from>
      <to>Insert valid satellite Mapping</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Close the currently invalid entry</from>
      <to>Insert valid satellite Mapping</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup invalid entry with load_end_dts = 'latest' default</from>
      <to>Currently invalid?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get transformation and job batch ID</from>
      <to>Set var_etl_trf_id_batch and var_etl_job_id_job</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Already currently valid?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Ignore already currently valid</send_true_to>
    <send_false_to>Lookup invalid entry with load_end_dts = 'latest' default</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>exists_ind_dv_valid</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>1</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>#;-#</mask>
        </value>
      </condition>
    </compare>
    <cluster_schema/>
    <GUI>
      <xloc>736</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Close the currently invalid entry</name>
    <type>Update</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <skip_lookup>N</skip_lookup>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <use_batch>N</use_batch>
    <error_ignored>Y</error_ignored>
    <ignore_flag_field/>
    <lookup>
      <schema/>
      <table>vw_sat_${lnk_name}_valid_upd</table>
      <key>
        <name>lnk_key</name>
        <field>lnk_key</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>load_end_dts</name>
        <field>load_end_dts</field>
        <condition>= ~NULL</condition>
        <name2/>
      </key>
      <value>
        <name>load_end_dts</name>
        <rename>load_dts</rename>
      </value>
    </lookup>
    <cluster_schema/>
    <GUI>
      <xloc>736</xloc>
      <yloc>640</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Currently invalid?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Close the currently invalid entry</send_true_to>
    <send_false_to>Insert valid satellite Mapping</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>exists_in_dv_invalid</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>1</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>#;-#</mask>
        </value>
      </condition>
    </compare>
    <cluster_schema/>
    <GUI>
      <xloc>736</xloc>
      <yloc>448</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>

  <transform>
    <name>Links in group in run</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <sql>select          distinct
                lnk_run.record_source_id            as record_source_id
,               1                                   as ind_valid_1
,               0                                   as ind_valid_0
,               lnk_run.load_dts                    as load_dts
,               ${PROP_LOAD_END_DTS_LATEST}         as load_end_dts
,               dv.lnk_key                          as lnk_key
from            vw_${lnk_name}_group_run_lkp           lnk_run
inner join      vw_${lnk_name}_group_valid_lkp         dv
on              ${join_condition}
where           lnk_run.record_source_id              = ${lnk_source_record_source_id}

</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Lookup invalid entry with load_end_dts = 'latest' default</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>

<pipeline>
  <info>
    <name>trf_data_vault_link_sat_validity_group_invalidate_generic</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: link validity satellite with group and no bk</description>
    <extended_description>This transformation processes a link validity satellite for links that have a 'group_key_column', but no 'bk_columns'.

The transformation is largely equivalent to trf_data_vault_link_sat_validity_generic, but without invalidating the changed entries.
That already has been done by invalidating the complete active group.
</extended_description>
    <pipeline_version>1.5</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <directory>/data_vault</directory>
    <parameters>
      <parameter>
        <name>join_condition</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_group_key_column</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_name</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_no_group_key_columns</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>lnk_source_record_source_id</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:40.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2017/05/04 17:30:09.679</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Description: see transformation settings</note>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <width>224</width>
      <heigth>24</heigth>
      <fontname>Arial</fontname>
      <fontsize>9</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorblue>0</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
    <notepad>
      <note>NO TENANT ID YET</note>
      <xloc>112</xloc>
      <yloc>192</yloc>
      <width>136</width>
      <heigth>26</heigth>
      <fontname>Arial</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>205</backgroundcolorgreen>
      <backgroundcolorblue>112</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Close valid satellite</from>
      <to>Insert invalid satellite Mapping</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Insert invalid satellite Mapping</from>
      <to>Insert invalid satellite</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Valid links with group key in run, but nogroup not!</from>
      <to>Close valid satellite</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Insert invalid satellite</from>
      <to>Insert invalid satellite (errors)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get transformation and job batch ID</from>
      <to>Set var_etl_trf_id_batch and var_etl_job_id_job</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Close valid satellite</name>
    <type>Update</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <skip_lookup>N</skip_lookup>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <use_batch>N</use_batch>
    <error_ignored>Y</error_ignored>
    <ignore_flag_field/>
    <lookup>
      <schema/>
      <table>vw_sat_${lnk_name}_valid_upd</table>
      <key>
        <name>lnk_key</name>
        <field>lnk_key</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>ind_valid_1</name>
        <field>ind_valid</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>load_end_dts</name>
        <field>load_end_dts</field>
        <condition>= ~NULL</condition>
        <name2/>
      </key>
      <value>
        <name>load_end_dts</name>
        <rename>load_dts</rename>
      </value>
    </lookup>
    <cluster_schema/>
    <GUI>
      <xloc>448</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Get transformation and job batch ID</name>
    <type>SystemInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>var_etl_trf_id_batch</name>
        <type>batch ID</type>
      </field>
      <field>
        <name>var_etl_job_id_job</name>
        <type>job batch ID</type>
      </field>
    </fields>
    <cluster_schema/>
    <GUI>
      <xloc>448</xloc>
      <yloc>32</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Insert invalid satellite</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <schema/>
    <table>vw_sat_${lnk_name}_valid_upd</table>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>N</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
    </fields>
    <cluster_schema/>
    <GUI>
      <xloc>960</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Insert invalid satellite (errors)</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <schema/>
    <table>vw_sat_${lnk_name}_valid_err</table>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>N</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
    </fields>
    <cluster_schema/>
    <GUI>
      <xloc>1216</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Insert invalid satellite Mapping</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>lnk_key</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>ind_valid_0</name>
        <rename>ind_valid</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>record_source_id</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>load_dts</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>load_end_dts</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <cluster_schema/>
    <GUI>
      <xloc>704</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Set var_etl_trf_id_batch and var_etl_job_id_job</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <field_name>var_etl_trf_id_batch</field_name>
        <variable_name>var_etl_trf_id_batch</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
      <field>
        <field_name>var_etl_job_id_job</field_name>
        <variable_name>var_etl_job_id_job</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value/>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <cluster_schema/>
    <GUI>
      <xloc>960</xloc>
      <yloc>32</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform>
    <name>Valid links with group key in run, but nogroup not!</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>data_vault</connection>
    <sql>SELECT          DISTINCT
                dv.record_source_id                 as record_source_id
,               1                                   as ind_valid_1
,               0                                   as ind_valid_0
,               ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST}  as load_dts
,               ${PROP_LOAD_END_DTS_LATEST}         as load_end_dts
,               dv.lnk_key                          as lnk_key
FROM            vw_${lnk_name}_group_valid_lkp         dv
INNER JOIN      vw_sat_${lnk_name}_group_valid_lkp     sat
ON              dv.lnk_key                           = sat.lnk_key
AND             sat.ind_valid                        = 1
AND             sat.load_end_dts                     ${PROP_LOAD_END_DTS_LATEST_COND}
INNER JOIN      (
                SELECT DISTINCT
                       ${lnk_group_key_column}
                FROM   vw_${lnk_name}_group_run_lkp
                ) lnk_run_group_key_column
ON              dv.${lnk_group_key_column}           = lnk_run_group_key_column.${lnk_group_key_column}
LEFT OUTER JOIN vw_${lnk_name}_group_run_lkp           lnk_run
ON              ${join_condition}
WHERE           dv.record_source_id                  = ${lnk_source_record_source_id}
AND             lnk_run.load_dts                     IS NULL

</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cluster_schema/>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
      <draw>Y</draw>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>Insert invalid satellite</source_transform>
      <target_transform>Insert invalid satellite (errors)</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename/>
      <descriptions_valuename/>
      <fields_valuename/>
      <codes_valuename/>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
</pipeline>

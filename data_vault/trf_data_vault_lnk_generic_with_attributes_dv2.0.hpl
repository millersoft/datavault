  <transform>
    <name>hubs_dynamic 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit/>
    <sql>select   distinct
         public.digest(
             concat_ws(
                 '${CDC_DEL}',
                 ${hubs_no_as}
             ),
             'sha256'
         ) as lnk_key
,        ${hubs_with_as}
,        tenant_id as tenant_id
,        ${lnk_source_record_source_id} as record_source_id
,        ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as load_dts
,        ${lnk_attributes}
,        public.digest(
             concat_ws(
                 '${CDC_DEL}',
                 ${lnk_attributes_concat}
             ),
             'sha256'
         ) as lnk_attributes_concat_dv
,        ${ind_status_sat} as ind_status_sat
from     ${staging_schema_name}.${staging_prefix}${lnk_source} stg
where not exists
(
    select 1
    from ${data_vault_schema_name}.vw_${lnk_name}_lkp lnk
    where
    (
        public.digest(
            concat_ws(
                '${CDC_DEL}',
                ${hubs_no_as}
            ),
            'sha256'
        ) = lnk.lnk_key
        and stg.tenant_id = lnk.tenant_id
    )
    and public.digest(
            concat_ws(
                '${CDC_DEL}',
                ${lnk_attributes_concat}
            ),
            'sha256'
        ) = lnk.lnk_attributes_concat_dv
)</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>192</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>

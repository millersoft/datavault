<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_data_vault_lnk_generic_with_attributes_dv2.0</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: link without attributes</description>
    <extended_description>This transformation loads a Data Vault link that only links hubs and has no 'non hub key attributes'.
To prevent many idle database connections (each hub lookup step initiates 4 connections), there is a 
separate transformation for each number of hubs.
Initially there was a transformation handling all number of hubs, but especially with PostgreSQL the large
number of connections consumed a lot of memory.</extended_description>
    <pipeline_version>1.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>

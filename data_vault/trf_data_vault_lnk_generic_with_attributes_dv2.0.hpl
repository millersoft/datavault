              <length>-1</length>
              <mask>#.#;-#.#</mask>
              <name>constant</name>
              <precision>-1</precision>
              <text>0.0</text>
              <type>Number</type>
            </value>
          </condition>
        </conditions>
        <function>=</function>
        <negated>N</negated>
        <operator>-</operator>
      </condition>
    </compare>
    <send_false_to>Select columns for run table</send_false_to>

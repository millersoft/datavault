    <connection>staging</connection>
    <sql>select   distinct 
         ${lnk_src_hub_1_business_key}    as hub_1_business_key
,        ${lnk_src_hub_2_business_key}    as hub_2_business_key
,        ${lnk_src_hub_3_business_key}    as hub_3_business_key
,        ${lnk_src_hub_4_business_key}    as hub_4_business_key
,        ${lnk_src_hub_5_business_key}    as hub_5_business_key
,        ${lnk_src_hub_6_business_key}    as hub_6_business_key

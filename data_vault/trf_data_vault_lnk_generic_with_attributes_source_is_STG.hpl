<pipeline>
  <info>
    <name>trf_data_vault_lnk_generic_with_attributes_source_is_STG</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: link without attributes</description>
    <extended_description>This transformation loads a Data Vault link that only links hubs and has no 'non hub key attributes'.
A maximum of 10 hubs is currently supported.
For every link 10 hubs are joined in this transformation.
In case the link links 4 hubs, the first 4 joins will be with those hubs, the 6 remaining joins will lookup the dummy hub.

This result in relevant hub_keys and irrelevant ones. The latter must be removed from the flow, because the link table
has no target column for them. That's why there are 9 'Remove Unused ... hubs' steps.
</extended_description>
    <pipeline_version>1.16</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <directory>/data_vault</directory>

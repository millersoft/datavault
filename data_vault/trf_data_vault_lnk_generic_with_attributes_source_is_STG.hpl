,        ${lnk_src_hub_9_business_key}    as hub_9_business_key
,        ${lnk_src_hub_10_business_key}   as hub_10_business_key
,        ${lnk_source_record_source_id}   as record_source_id
,        ${lnk_attributes_concat}         as lnk_attributes_concat
,        ${lnk_attributes}
,        ${lnk_number_of_hubs}            as lnk_number_of_hubs
,        ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST}  as load_dts
,        '${lnk_bk_columns}'              as lnk_bk_columns
,        ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST}  as last_seen_dts
,        ${ind_last_seen_dts}             as ind_last_seen_dts
,        ${ind_status_sat}                as ind_status_sat
,        ${ind_group_key_column}          as ind_group_key_column
from     ${lnk_source}</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>

<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_data_vault_sat_generic_dv2.0</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: hub satellite</description>
    <extended_description>This transformation loads a Data Vault hub-satellite.
To determine whether one of the attributes has changed a concatenated string including all source attributes separated by a |
is compared to the equivalent concatenation in de Data Vault.
</extended_description>
    <pipeline_version>1.14</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>id_srcsys</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_attributes</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_attributes_concat</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_attributes_concat_dv</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_hub</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_hub_business_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_hub_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_name</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_source</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_source_hub_business_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>sat_source_record_source_id</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:40.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2017/06/14 11:12:30.096</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Arial</fontname>
      <fontsize>9</fontsize>
      <height>21</height>
      <xloc>0</xloc>
      <yloc>0</yloc>
      <note>Description: see transformation settings</note>
      <width>224</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>sat_dv_insert</from>
      <to>sat_dv_errors</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get transformation and job batch ID</from>
      <to>Set var_etl_trf_id_batch and var_etl_job_id_job</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>sat_src</from>
      <to>sat_dv_insert</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get variables</from>
      <to>Set var_etl_trf_id_batch and var_etl_job_id_job</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Get transformation and job batch ID</name>
    <type>SystemInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>var_etl_trf_id_batch</name>
        <type/>
      </field>
      <field>
        <name>var_etl_job_id_job</name>
        <type/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>32</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Get variables</name>
    <type>GetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <name>var_etl_trf_id_batch</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>0</variable>
      </field>
      <field>
        <length>-1</length>
        <name>var_etl_job_id_job</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>0</variable>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>656</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Set var_etl_trf_id_batch and var_etl_job_id_job</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <field_name>var_etl_trf_id_batch</field_name>
        <variable_name>var_etl_trf_id_batch</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
      </field>
      <field>
        <field_name>var_etl_job_id_job</field_name>
        <variable_name>var_etl_job_id_job</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>32</yloc>
    </GUI>
  </transform>
  <transform>
    <name>sat_dv_errors</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <connection>data_vault</connection>
    <fields>
</fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>${data_vault_schema_name}</schema>
    <specify_fields>N</specify_fields>
    <table>vw_${sat_name}_err</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>528</xloc>
      <yloc>480</yloc>
    </GUI>
  </transform>
  <transform>
    <name>sat_dv_insert</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>${SAT_INSERT_COPIES}</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <connection>data_vault</connection>
    <fields>
</fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>${data_vault_schema_name}</schema>
    <specify_fields>N</specify_fields>
    <table>vw_${sat_name}_upd</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>528</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform>
    <name>sat_src</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>with latest_sat as materialized
(
    select distinct on (hub_key, tenant_id)
           hub_key,
           tenant_id,
           sat_attributes_concat,
           load_dts
    from   ${data_vault_schema_name}.vw_${sat_name}_upd_2
    order by
           hub_key,
           tenant_id,
           load_dts desc
)
select distinct
       public.digest(
           concat_ws(
               '${CDC_DEL}',
               ${sat_source_hub_business_key},
               cast(${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as char(100))
           ),
           'sha256'
       ) as sat_key,
       ${sat_source_hub_business_key} as hub_key,
       ${sat_attributes_concat}       as sat_attributes_concat,
       ${sat_attributes},
       ${sat_source_record_source_id} as record_source_id,
       stg.tenant_id                  as tenant_id,
       ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as load_dts
from   ${staging_schema_name}.${staging_prefix}${sat_source} stg
left join latest_sat sat
       on sat.hub_key = stg.${sat_source_hub_business_key}
      and sat.tenant_id = stg.tenant_id
where  sat.hub_key is null
   or  sat.sat_attributes_concat is distinct from ${sat_attributes_concat}</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>sat_dv_insert</source_transform>
      <target_transform>sat_dv_errors</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>etl_err_noe</nr_valuename>
      <descriptions_valuename>etl_err_desc</descriptions_valuename>
      <fields_valuename>etl_err_col</fields_valuename>
      <codes_valuename>etl_err_cod</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
  <attributes/>
</pipeline>

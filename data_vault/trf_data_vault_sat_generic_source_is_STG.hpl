<pipeline>
  <info>
    <name>trf_data_vault_sat_generic_source_is_STG</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: hub satellite</description>
    <extended_description>This transformation loads a Data Vault hub-satellite.
To determine whether one of the attributes has changed a concatenated string including all source attributes separated by a |
is compared to the equivalent concatenation in de Data Vault.
</extended_description>
    <pipeline_version>1.14</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>

    <sql>select distinct
       ${sat_source_hub_business_key}   as hub_business_key
,      ${sat_attributes_concat}         as sat_attributes_concat
,      ${sat_attributes}
,      ${sat_source_record_source_id}   as record_source_id
,      ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as load_dts
,      ${PROP_LOAD_END_DTS_LATEST}      as load_end_dts
,      coalesce(sj.exists_in_dv, 0) as exists_in_dv
,      coalesce(sj.sat_key, 0) as sat_key
,	   sj.sat_attributes_concat_dv
,	   sj.hub_key
from   ${staging_schema_name}.${sat_source} sat
left outer join ${data_vault_schema_name}.vw_${sat_name}_lkp_${id_srcsys} sj on sj.hub_key = md5(cast(sat.${sat_source_hub_business_key} as varchar))
order by 1</sql>

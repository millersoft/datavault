<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_data_vault_sat_hub_surrogate_keys_dv2.0</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic transformation: hub satellite</description>
    <extended_description>This transformation loads a Data Vault hub-satellite.
To determine whether one of the attributes has changed a concatenated string including all source attributes separated by a |
is compared to the equivalent concatenation in de Data Vault.
</extended_description>
    <pipeline_version>1.7</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>hub_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>hub_name</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>hub_source</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>hub_source_business_key</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>id_srcsys</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>source_surrogate_key</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:40.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2017/05/04 16:09:27.829</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Arial</fontname>
      <fontsize>9</fontsize>
      <height>-1</height>
      <xloc>32</xloc>
      <yloc>16</yloc>
      <note>Description: see transformation settings</note>
      <width>224</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>sat_dv_insert_new</from>
      <to>sat_dv_errors (ins)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove Unused New</from>
      <to>sat_dv_insert_new</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup sat in DV</from>
      <to>Already exists?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Already exists?</from>
      <to>Remove Unused New</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Already exists?</from>
      <to>Ignore Existing</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remove Unused New</from>
      <to>Update load_end_dts previous surrogate key</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>hub_src</from>
      <to>Lookup sat in DV</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>hub_src 2</from>
      <to>Lookup sat in DV</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Already exists?</name>
    <type>SwitchCase</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <case_value_type>Integer</case_value_type>
    <cases>
      <case>
        <target_transform>Ignore Existing</target_transform>
        <value>1</value>
      </case>
    </cases>
    <default_target_transform>Remove Unused New</default_target_transform>
    <fieldname>exists_in_dv</fieldname>
    <use_contains>N</use_contains>
    <attributes/>
    <GUI>
      <xloc>640</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ignore Existing</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Lookup sat in DV</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>4</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache>N</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <connection>data_vault</connection>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure>
      <fail_on_multiple>N</fail_on_multiple>
      <key>
        <condition>=</condition>
        <field>source_surrogate_key_dv</field>
        <name>source_surrogate_key</name>
      </key>
      <key>
        <condition>=</condition>
        <field>id_srcsys</field>
        <name>id_srcsys</name>
      </key>
      <key>
        <condition>=</condition>
        <field>hub_business_key_dv</field>
        <name>hub_business_key</name>
      </key>
      <table>vw_sat_${hub_name}_surrogate_keys_lkp</table>
      <value>
        <default>0</default>
        <name>exists_in_dv</name>
        <rename>exists_in_dv</rename>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Remove Unused New</name>
    <type>SelectValues</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <remove>
        <name>hub_business_key</name>
      </remove>
      <remove>
        <name>exists_in_dv</name>
      </remove>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>640</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Update load_end_dts previous surrogate key</name>
    <type>Update</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <connection>data_vault</connection>
    <error_ignored>Y</error_ignored>
    <lookup>
      <key>
        <condition>=</condition>
        <field>hub_key</field>
        <name>hub_key</name>
      </key>
      <key>
        <condition>=</condition>
        <field>id_srcsys</field>
        <name>id_srcsys</name>
      </key>
      <key>
        <condition>&lt;></condition>
        <field>source_surrogate_key</field>
        <name>source_surrogate_key</name>
      </key>
      <key>
        <condition>= ~NULL</condition>
        <field>load_end_dts</field>
        <name>load_end_dts</name>
      </key>
      <table>vw_sat_${hub_name}_surrogate_keys_upd</table>
      <value>
        <name>load_end_dts</name>
        <rename>load_dts</rename>
      </value>
    </lookup>
    <skip_lookup>N</skip_lookup>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>640</xloc>
      <yloc>512</yloc>
    </GUI>
  </transform>
  <transform>
    <name>hub_src</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT   DISTINCT
         ${hub_source_hash_key}     	as hub_key
,        ${hub_source_business_key}     as hub_business_key
,        ${source_surrogate_key}        as source_surrogate_key
,        ${id_srcsys}                   as id_srcsys
,        ${hub_source_record_source_id} as record_source_id
,        ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as load_dts
FROM     ${staging_prefix}${hub_source} STG
WHERE    ${hub_source_hash_key} not in
(
	select H.hub_key_dv
	from ${data_vault_schema_name}.vw_${hub_name}_lkp H
	where STG.${hub_source_hash_key} = H.hub_key_dv
)</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform>
    <name>hub_src 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT   DISTINCT
         ${hub_source_hash_key}     	as hub_key
,        ${hub_source_business_key}     as hub_business_key
,        ${source_surrogate_key}        as source_surrogate_key
,		 tenant_id			  as tenant_id
,        ${id_srcsys}                   as id_srcsys
,        ${hub_source_record_source_id} as record_source_id
,        ${PROP_DATABASE_LOAD_DTS_CAST_PRE}'${load_dts}' ${PROP_DATABASE_LOAD_DTS_CAST_POST} as load_dts
FROM     ${staging_prefix}${hub_source} STG
WHERE NOT EXISTS
(
	select 1
	from ${data_vault_schema_name}.vw_${hub_name}_lkp H
	where STG.${hub_source_hash_key} = H.hub_key_dv
	and STG.tenant_id = H.tenant_id
)
AND ${hub_source_business_key} IS NOT NULL
AND tenant_id IS NOT NULL</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>304</yloc>
    </GUI>
  </transform>
  <transform>
    <name>sat_dv_errors (ins)</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <add_columns>N</add_columns>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <auto_update_table_structure>N</auto_update_table_structure>
    <change_column_types>N</change_column_types>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <connection>data_vault</connection>
    <drop_columns>N</drop_columns>
    <fields>
</fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>vw_sat_${hub_name}_surrogate_keys_err</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>512</yloc>
    </GUI>
  </transform>
  <transform>
    <name>sat_dv_insert_new</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <add_columns>N</add_columns>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <auto_update_table_structure>N</auto_update_table_structure>
    <change_column_types>N</change_column_types>
    <commit>${PROP_COMMIT_SIZE_DATA_VAULT}</commit>
    <connection>data_vault</connection>
    <drop_columns>N</drop_columns>
    <fields>
</fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_field/>
    <return_keys>N</return_keys>
    <schema/>
    <specify_fields>N</specify_fields>
    <table>vw_sat_${hub_name}_surrogate_keys_upd</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>N</use_batch>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
    <error>
      <source_transform>sat_dv_insert_new</source_transform>
      <target_transform>sat_dv_errors (ins)</target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>etl_err_noe</nr_valuename>
      <descriptions_valuename>etl_err_desc</descriptions_valuename>
      <fields_valuename>etl_err_col</fields_valuename>
      <codes_valuename>etl_err_cod</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
  <attributes/>
</pipeline>

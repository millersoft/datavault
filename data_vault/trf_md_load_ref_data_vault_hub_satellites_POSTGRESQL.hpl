  </order>
  <transform>
    <name>ref_data_vault_hub_satellites</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>sat_name</field>
        <name>sat_name</name>
      </key>
      <key>
        <condition>=</condition>
        <field>id_data_vault_hub</field>
        <name>id_data_vault_hub</name>
      </key>
      <schema/>
      <table>ref_data_vault_hub_satellites</table>
      <value>
        <name>id_data_vault_hub</name>
        <rename>id_data_vault_hub</rename>
        <update>N</update>
      </value>
      <value>
        <name>sat_name</name>
        <rename>sat_name</rename>
        <update>N</update>
      </value>
      <value>
        <name>sat_key</name>
        <rename>sat_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>description</name>
        <rename>description</rename>
        <update>Y</update>
      </value>
      <value>
        <name>record_source_id</name>
        <rename>record_source_id</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_source_hub_business_key</name>
        <rename>sat_source_hub_business_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_current</name>
        <rename>ind_current</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_attributes</name>
        <rename>sat_attributes</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_attributes_dv</name>
        <rename>sat_attributes_dv</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_attributes_concat</name>
        <rename>sat_attributes_concat</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_attributes_concat_dv</name>
        <rename>sat_attributes_concat_dv</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_multiactive_extra_key_column</name>
        <rename>ind_multiactive_extra_key_column</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_multiactive_extra_key_column_src</name>
        <rename>sat_multiactive_extra_key_column_src</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_multiactive_extra_key_column</name>
        <rename>sat_multiactive_extra_key_column</rename>
        <update>Y</update>
      </value>
      <value>
        <name>process_in_subruntypes</name>
        <rename>process_in_subruntypes</rename>
        <update>Y</update>
      </value>
    </lookup>
    <update_bypassed>N</update_bypassed>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>stg_management_satellites</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select
       ref_hubs.id_data_vault_hub,
       stg_sat.sat_name,
       stg_sat.sat_key,
       stg_sat.sat_description as description,
       ref_srctab.id_srctab as record_source_id,
       stg_sat.source_hub_business_key as sat_source_hub_business_key,
       stg_sat.ind_current,
       stg_sat.sat_attributes,
       stg_sat.sat_attributes_dv,
       stg_sat.sat_attributes_concat,
       stg_sat.sat_attributes_concat_dv,
       stg_sat.ind_multiactive_extra_key_column,
       stg_sat.sat_multiactive_extra_key_column_src,
       stg_sat.sat_multiactive_extra_key_column,
       stg_sat.process_in_subruntypes

from
(
    select
           sat.sat_name,
           sat.sat_key,
           sat.sat_description,
           sat.sat_hub,
           sat.ind_current,
           sat.source_concat,
           sat.source_hub_business_key,
           sat.process_in_subruntypes,

           max(sat.ind_multiactive_extra_key_column)
               as ind_multiactive_extra_key_column,

           max(sat.attribute_source_column)
               filter (
                   where sat.ind_multiactive_extra_key_column = 1
               )
               as sat_multiactive_extra_key_column_src,

           max(sat.attribute_target_column)
               filter (
                   where sat.ind_multiactive_extra_key_column = 1
               )
               as sat_multiactive_extra_key_column,

           string_agg(
               sat.attribute_source_column
               || ' as '
               || sat.attribute_target_column,
               ','
               order by sat.attribute_number
           ) as sat_attributes,

           string_agg(
               sat.attribute_target_column,
               ','
               order by sat.attribute_number
           ) as sat_attributes_dv,

           '${CDC_HASH_FUNCTION}('
           ||
           string_agg(
               'coalesce(cast('
               || sat.attribute_source_column
               || ' as text),''${CDC_NULL}'')',
               '||''${CDC_DEL}''||'
               order by sat.attribute_number
           )
           ||
           ', ''sha256'')'
               as sat_attributes_concat,

           '${CDC_HASH_FUNCTION}('
           ||
           string_agg(
               'coalesce(cast('
               || sat.attribute_target_column
               || ' as text),''${CDC_NULL}'')',
               '||''${CDC_DEL}''||'
               order by sat.attribute_number
           )
           ||
           ', ''sha256'')'
               as sat_attributes_concat_dv

    from pdi_meta.vw_stg_management_satellites_all_columns_filled sat

    group by
           sat.sat_name,
           sat.sat_key,
           sat.sat_description,
           sat.sat_hub,
           sat.ind_current,
           sat.source_concat,
           sat.source_hub_business_key,
           sat.process_in_subruntypes

) stg_sat

cross join pdi_meta.stg_management_data_vaults dv

inner join pdi_meta.ref_data_vault_hubs ref_hubs
        on stg_sat.sat_hub = ref_hubs.hub_name
       and dv.id_data_vault = ref_hubs.id_data_vault

inner join pdi_meta.stg_management_source_tables stg_srctab
        on stg_sat.source_concat = stg_srctab.source_concat

inner join pdi_meta.ref_source_systems ref_srcsys
        on stg_srctab.source_system = ref_srcsys.description

inner join pdi_meta.ref_source_tables ref_srctab
        on ref_srcsys.id_srcsys = ref_srctab.id_srcsys
       and stg_srctab.table_name = ref_srctab.table_name

where stg_sat.ind_current = 1</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

  </transform>
  <transform>
    <name>stg_management_hub_sources</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select          ref_hubs.id_data_vault_hub
,               ref_srctab.id_srctab              as record_source_id
-- , 1 as record_source_id
-- ,               ref_rs.record_source_id           as system_source_id
-- ,				ref_srctab.id_srctab              as record_source_id
,				stg_hubs.hub_source_hash_key	  as source_hash_key
,               stg_hubs.hub_source_business_key  as source_business_key
,               stg_hubs.source_surrogate_key     as source_surrogate_key
,               stg_hubs.hub_source_order         as source_order
,               stg_hubs.ind_current
,               stg_hubs.ind_status_sat
,               stg_hubs.process_in_subruntypes
from            stg_management_hubs             stg_hubs
cross join      stg_management_data_vaults      dv
inner join      ref_data_vault_hubs             ref_hubs
on              stg_hubs.hub_name             = ref_hubs.hub_name
and             dv.id_data_vault              = ref_hubs.id_data_vault
inner join      stg_management_source_tables    stg_srctab
on              stg_hubs.hub_source           = stg_srctab.source_concat
inner join      ref_source_systems              ref_srcsys
on              stg_srctab.source_system      = ref_srcsys.description
inner join      ref_source_tables               ref_srctab
on              ref_srcsys.id_srcsys          = ref_srctab.id_srcsys
and             stg_srctab.table_name         = ref_srctab.table_name
and             coalesce(stg_srctab.source_schema,'') = coalesce(ref_srctab.source_schema,'')
and             stg_srctab.staging_table_name = ref_srctab.staging_table_name
-- inner join		ref_record_source				ref_rs
-- on				ref_rs.source_name			  = ref_srcsys.cod_srcsys
where           stg_hubs.hub_source_business_key is not null
and             stg_hubs.ind_current = 1
-- order by ref_hubs.id_data_vault_hub</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

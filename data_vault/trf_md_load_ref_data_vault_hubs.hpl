<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_md_load_ref_data_vault_hubs</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load design metadata: hubs</description>
    <extended_description>This transformation loads the Data Vault hubs from the staging table into the ref table.</extended_description>
    <pipeline_version>1.2</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:32.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2014/12/14 11:29:53.609</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ariel</fontname>
      <fontsize>10</fontsize>
      <height>22</height>
      <xloc>96</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>272</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>stg_management_hubs</from>
      <to>ref_data_vault_hubs</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>ref_data_vault_hubs</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>hub_name</field>
        <name>hub_name</name>
      </key>
      <key>
        <condition>=</condition>
        <field>id_data_vault</field>
        <name>id_data_vault</name>
      </key>
      <schema/>
      <table>ref_data_vault_hubs</table>
      <value>
        <name>hub_name</name>
        <rename>hub_name</rename>
        <update>N</update>
      </value>
      <value>
        <name>id_data_vault</name>
        <rename>id_data_vault</rename>
        <update>N</update>
      </value>
      <value>
        <name>hub_key</name>
        <rename>hub_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>hub_business_key</name>
        <rename>hub_business_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>hub_description</name>
        <rename>hub_description</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_current</name>
        <rename>ind_current</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_last_seen_dts</name>
        <rename>ind_last_seen_dts</rename>
        <update>Y</update>
      </value>
    </lookup>
    <update_bypassed>N</update_bypassed>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>stg_management_hubs</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select          distinct
                hubs.hub_name
,               dv.id_data_vault
,               hubs.hub_key
,               hubs.hub_business_key
,               hubs.hub_description
,               hubs.ind_current
,               hubs.ind_last_seen_dts
from            stg_management_hubs        hubs
cross join      stg_management_data_vaults dv
where           hubs.ind_current = 1</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

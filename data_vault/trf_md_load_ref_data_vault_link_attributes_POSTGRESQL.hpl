<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_md_load_ref_data_vault_link_attributes_POSTGRESQL</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load design metadata: link attributes</description>
    <extended_description>This transformation loads the Data Vault link attributes from the staging table into the ref table.
</extended_description>
    <pipeline_version>1.1</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:33.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2018/01/16 10:21:31.206</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ariel</fontname>
      <fontsize>10</fontsize>
      <height>22</height>
      <xloc>64</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>272</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>stg_management_link_attributes</from>
      <to>ref_data_vault_link_attributes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>stg_management_link_attributes 2</from>
      <to>ref_data_vault_link_attributes</to>
      <enabled>N</enabled>
    </hop>
  </order>
  <transform>
    <name>ref_data_vault_link_attributes</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>id_data_vault_link</field>
        <name>id_data_vault_link</name>
      </key>
      <key>
        <condition>=</condition>
        <field>record_source_id</field>
        <name>record_source_id</name>
      </key>
      <schema/>
      <table>ref_data_vault_link_attributes</table>
      <value>
        <name>id_data_vault_link</name>
        <rename>id_data_vault_link</rename>
        <update>N</update>
      </value>
      <value>
        <name>record_source_id</name>
        <rename>record_source_id</rename>
        <update>N</update>
      </value>
      <value>
        <name>ind_current</name>
        <rename>ind_current</rename>
        <update>Y</update>
      </value>
      <value>
        <name>link_attributes</name>
        <rename>link_attributes</rename>
        <update>Y</update>
      </value>
      <value>
        <name>link_attributes_dv</name>
        <rename>link_attributes_dv</rename>
        <update>Y</update>
      </value>
      <value>
        <name>link_attributes_concat</name>
        <rename>link_attributes_concat</rename>
        <update>Y</update>
      </value>
      <value>
        <name>link_attributes_concat_dv</name>
        <rename>link_attributes_concat_dv</rename>
        <update>Y</update>
      </value>
    </lookup>
    <update_bypassed>N</update_bypassed>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>stg_management_link_attributes</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select
       ref_links.id_data_vault_link,
       ref_srctab.id_srctab as record_source_id,
       stg_lnka.ind_current,
       stg_lnka.link_attributes,
       stg_lnka.link_attributes_dv,
       stg_lnka.link_attributes_concat,
       stg_lnka.link_attributes_concat_dv

from
(
    select
           lnka.link_name,
           lnka.ind_current,
           lnka.source_concat,

           string_agg(
               lnka.attribute_source_column
                   || ' as '
                   || lnka.attribute_target_column,
               ','
               order by lnka.attribute_number
           ) as link_attributes,

           string_agg(
               lnka.attribute_target_column,
               ','
               order by lnka.attribute_number
           ) as link_attributes_dv,

           string_agg(
               'coalesce(cast('
                   || lnka.attribute_source_column
                   || ' as text),''${CDC_NULL}'')',
               '||''${CDC_DEL}''||'
               order by lnka.attribute_number
           ) as link_attributes_concat,

           string_agg(
               'coalesce(cast('
                   || lnka.attribute_target_column
                   || ' as text),''${CDC_NULL}'')',
               '||''${CDC_DEL}''||'
               order by lnka.attribute_number
           ) as link_attributes_concat_dv

    from vw_stg_management_link_attributes_all_columns_filled lnka

    group by
           lnka.link_name,
           lnka.ind_current,
           lnka.source_concat

) stg_lnka

inner join ref_data_vault_links ref_links
        on stg_lnka.link_name = ref_links.link_name
       and ref_links.id_data_vault =
           (
               select id_data_vault
               from stg_management_data_vaults
           )

inner join stg_management_source_tables stg_srctab
        on stg_lnka.source_concat = stg_srctab.source_concat

inner join ref_source_systems ref_srcsys
        on stg_srctab.source_system = ref_srcsys.description

inner join ref_source_tables ref_srctab
        on ref_srcsys.id_srcsys = ref_srctab.id_srcsys
       and stg_srctab.table_name = ref_srctab.table_name
       and coalesce(stg_srctab.source_schema,'') = coalesce(ref_srctab.source_schema,'')
       and stg_srctab.staging_table_name = ref_srctab.staging_table_name

where stg_lnka.ind_current = 1</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>stg_management_link_attributes 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select          ref_links.id_data_vault_link
,               ref_srctab.id_srctab              as record_source_id
,               stg_lnka.ind_current
,               stg_lnka.link_attributes
,               stg_lnka.link_attributes_dv
,               stg_lnka.link_attributes_concat
,               stg_lnka.link_attributes_concat_dv
from
(            
select          iv.link_name
,               iv.ind_current
,               iv.source_concat
,               concat(attribute_source_column_1,' as ' , attribute_target_column_1
                     ,case when attribute_source_column_2  is not null then concat(',',concat(attribute_source_column_2 ,' as ',attribute_target_column_2))  else '' end
                     ,case when attribute_source_column_3  is not null then concat(',',concat(attribute_source_column_3 ,' as ',attribute_target_column_3))  else '' end
                     ,case when attribute_source_column_4  is not null then concat(',',concat(attribute_source_column_4 ,' as ',attribute_target_column_4))  else '' end
                     ,case when attribute_source_column_5  is not null then concat(',',concat(attribute_source_column_5 ,' as ',attribute_target_column_5))  else '' end
                     ,case when attribute_source_column_6  is not null then concat(',',concat(attribute_source_column_6 ,' as ',attribute_target_column_6))  else '' end
                     ,case when attribute_source_column_7  is not null then concat(',',concat(attribute_source_column_7 ,' as ',attribute_target_column_7))  else '' end
                     ,case when attribute_source_column_8  is not null then concat(',',concat(attribute_source_column_8 ,' as ',attribute_target_column_8))  else '' end
                     ,case when attribute_source_column_9  is not null then concat(',',concat(attribute_source_column_9 ,' as ',attribute_target_column_9))  else '' end
                     ,case when attribute_source_column_10 is not null then concat(',',concat(attribute_source_column_10,' as ',attribute_target_column_10)) else '' end
                     )        as link_attributes 
,               concat(attribute_target_column_1
                     ,case when attribute_target_column_2  is not null then concat(',',attribute_target_column_2)  else '' end
                     ,case when attribute_target_column_3  is not null then concat(',',attribute_target_column_3)  else '' end
                     ,case when attribute_target_column_4  is not null then concat(',',attribute_target_column_4)  else '' end
                     ,case when attribute_target_column_5  is not null then concat(',',attribute_target_column_5)  else '' end
                     ,case when attribute_target_column_6  is not null then concat(',',attribute_target_column_6)  else '' end
                     ,case when attribute_target_column_7  is not null then concat(',',attribute_target_column_7)  else '' end
                     ,case when attribute_target_column_8  is not null then concat(',',attribute_target_column_8)  else '' end
                     ,case when attribute_target_column_9  is not null then concat(',',attribute_target_column_9)  else '' end
                     ,case when attribute_target_column_10  is not null then concat(',',attribute_target_column_10)  else '' end
                     )        as link_attributes_dv 
,                concat('concat(coalesce(cast(',attribute_source_column_1,' as text),''','${CDC_NULL}',''')'
                       , case when attribute_source_column_2  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_source_column_2 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_source_column_3  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_source_column_3 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_source_column_4  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_source_column_4 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_source_column_5  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_source_column_5 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_source_column_6  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_source_column_6 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_source_column_7  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_source_column_7 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_source_column_8  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_source_column_8 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_source_column_9  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_source_column_9 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_source_column_10 is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_source_column_10,' as text),''','${CDC_NULL}',''')') else '' end
                       ,')'
                     )        as link_attributes_concat  
,                concat('concat(coalesce(cast(',attribute_target_column_1,' as text),''','${CDC_NULL}',''')'
                       , case when attribute_target_column_2  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_target_column_2 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_target_column_3  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_target_column_3 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_target_column_4  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_target_column_4 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_target_column_5  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_target_column_5 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_target_column_6  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_target_column_6 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_target_column_7  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_target_column_7 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_target_column_8  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_target_column_8 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_target_column_9  is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_target_column_9 ,' as text),''','${CDC_NULL}',''')') else '' end
                       , case when attribute_target_column_10 is not null then concat(',''${CDC_DEL}'',coalesce(cast(',attribute_target_column_10,' as text),''','${CDC_NULL}',''')') else '' end
                       ,')'
                     )        as link_attributes_concat_dv          
from
(select         lnka.link_name
,               lnka.ind_current    
,               lnka.source_concat 
,               max(case when lnka.attribute_number =  1 then lnka.attribute_source_column else null end) as attribute_source_column_1
,               max(case when lnka.attribute_number =  2 then lnka.attribute_source_column else null end) as attribute_source_column_2
,               max(case when lnka.attribute_number =  3 then lnka.attribute_source_column else null end) as attribute_source_column_3
,               max(case when lnka.attribute_number =  4 then lnka.attribute_source_column else null end) as attribute_source_column_4
,               max(case when lnka.attribute_number =  5 then lnka.attribute_source_column else null end) as attribute_source_column_5
,               max(case when lnka.attribute_number =  6 then lnka.attribute_source_column else null end) as attribute_source_column_6
,               max(case when lnka.attribute_number =  7 then lnka.attribute_source_column else null end) as attribute_source_column_7
,               max(case when lnka.attribute_number =  8 then lnka.attribute_source_column else null end) as attribute_source_column_8
,               max(case when lnka.attribute_number =  9 then lnka.attribute_source_column else null end) as attribute_source_column_9
,               max(case when lnka.attribute_number = 10 then lnka.attribute_source_column else null end) as attribute_source_column_10
,               max(case when lnka.attribute_number =  1 then lnka.attribute_target_column else null end) as attribute_target_column_1
,               max(case when lnka.attribute_number =  2 then lnka.attribute_target_column else null end) as attribute_target_column_2
,               max(case when lnka.attribute_number =  3 then lnka.attribute_target_column else null end) as attribute_target_column_3
,               max(case when lnka.attribute_number =  4 then lnka.attribute_target_column else null end) as attribute_target_column_4
,               max(case when lnka.attribute_number =  5 then lnka.attribute_target_column else null end) as attribute_target_column_5
,               max(case when lnka.attribute_number =  6 then lnka.attribute_target_column else null end) as attribute_target_column_6
,               max(case when lnka.attribute_number =  7 then lnka.attribute_target_column else null end) as attribute_target_column_7
,               max(case when lnka.attribute_number =  8 then lnka.attribute_target_column else null end) as attribute_target_column_8
,               max(case when lnka.attribute_number =  9 then lnka.attribute_target_column else null end) as attribute_target_column_9
,               max(case when lnka.attribute_number = 10 then lnka.attribute_target_column else null end) as attribute_target_column_10
from            vw_stg_management_link_attributes_all_columns_filled lnka
group by        lnka.link_name
,               lnka.ind_current
,               lnka.source_concat
) iv
) stg_lnka
inner join      ref_data_vault_links            ref_links
on              stg_lnka.link_name            = ref_links.link_name
and             ref_links.id_data_vault       = (select id_data_vault from stg_management_data_vaults)
inner join      stg_management_source_tables    stg_srctab
on              stg_lnka.source_concat        = stg_srctab.source_concat
inner join      ref_source_systems              ref_srcsys
on              stg_srctab.source_system      = ref_srcsys.description
inner join      ref_source_tables               ref_srctab
on              ref_srcsys.id_srcsys          = ref_srctab.id_srcsys
and             stg_srctab.table_name         = ref_srctab.table_name
and             coalesce(stg_srctab.source_schema,'') = coalesce(ref_srctab.source_schema,'')
and             stg_srctab.staging_table_name = ref_srctab.staging_table_name
where           stg_lnka.ind_current          = 1</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>176</xloc>
      <yloc>208</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>stg_management_link_satellites</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select
       ref_links.id_data_vault_link,
       stg_sat.sat_name,
       stg_sat.sat_key,
       stg_sat.sat_description as description,
       ref_srctab.id_srctab as record_source_id,

       stg_sat.source_hub_1_business_key  as sat_source_hub_1_business_key,
       stg_sat.source_hub_2_business_key  as sat_source_hub_2_business_key,
       stg_sat.source_hub_3_business_key  as sat_source_hub_3_business_key,
       stg_sat.source_hub_4_business_key  as sat_source_hub_4_business_key,
       stg_sat.source_hub_5_business_key  as sat_source_hub_5_business_key,
       stg_sat.source_hub_6_business_key  as sat_source_hub_6_business_key,
       stg_sat.source_hub_7_business_key  as sat_source_hub_7_business_key,
       stg_sat.source_hub_8_business_key  as sat_source_hub_8_business_key,
       stg_sat.source_hub_9_business_key  as sat_source_hub_9_business_key,
       stg_sat.source_hub_10_business_key as sat_source_hub_10_business_key,

       stg_sat.sat_lnk_key_attributes_concat,
       stg_sat.ind_current,
       stg_sat.sat_attributes,
       stg_sat.sat_attributes_dv,
       stg_sat.sat_attributes_concat,
       stg_sat.sat_attributes_concat_dv,
       stg_sat.process_in_subruntypes

from
(
    select
           sat.sat_name,
           sat.sat_key,
           sat.sat_description,
           sat.sat_link,
           sat.ind_current,
           sat.source_concat,

           sat.source_hub_1_business_key,
           sat.source_hub_2_business_key,
           sat.source_hub_3_business_key,
           sat.source_hub_4_business_key,
           sat.source_hub_5_business_key,
           sat.source_hub_6_business_key,
           sat.source_hub_7_business_key,
           sat.source_hub_8_business_key,
           sat.source_hub_9_business_key,
           sat.source_hub_10_business_key,

           case
               when sat.source_lnk_key_attribute_1 is null
               then ''']#['''
               else concat(
                   'concat(coalesce(cast(',
                   sat.source_lnk_key_attribute_1,
                   ' as text),''',
                   '${CDC_NULL}',
                   ''')',

                   case
                       when sat.source_lnk_key_attribute_2 is not null
                       then concat(
                           ',''${CDC_DEL}'',coalesce(cast(',
                           sat.source_lnk_key_attribute_2,
                           ' as text),''',
                           '${CDC_NULL}',
                           ''')'
                       )
                       else ''
                   end,

                   case
                       when sat.source_lnk_key_attribute_3 is not null
                       then concat(
                           ',''${CDC_DEL}'',coalesce(cast(',
                           sat.source_lnk_key_attribute_3,
                           ' as text),''',
                           '${CDC_NULL}',
                           ''')'
                       )
                       else ''
                   end,

                   case
                       when sat.source_lnk_key_attribute_4 is not null
                       then concat(
                           ',''${CDC_DEL}'',coalesce(cast(',
                           sat.source_lnk_key_attribute_4,
                           ' as text),''',
                           '${CDC_NULL}',
                           ''')'
                       )
                       else ''
                   end,

                   case
                       when sat.source_lnk_key_attribute_5 is not null
                       then concat(
                           ',''${CDC_DEL}'',coalesce(cast(',
                           sat.source_lnk_key_attribute_5,
                           ' as text),''',
                           '${CDC_NULL}',
                           ''')'
                       )
                       else ''
                   end,

                   ')'
               )
           end as sat_lnk_key_attributes_concat,

           string_agg(
               sat.attribute_source_column
                   || ' as '
                   || sat.attribute_target_column,
               ','
               order by sat.attribute_number
           ) as sat_attributes,

           string_agg(
               sat.attribute_target_column,
               ','
               order by sat.attribute_number
           ) as sat_attributes_dv,

           '${CDC_HASH_FUNCTION}('
           ||
           string_agg(
               'coalesce(cast('
                   || sat.attribute_source_column
                   || ' as text),''${CDC_NULL}'')',
               '||''${CDC_DEL}''||'
               order by sat.attribute_number
           )
           ||
           ', ''sha256'')'
           as sat_attributes_concat,

           '${CDC_HASH_FUNCTION}('
           ||
           string_agg(
               'coalesce(cast('
                   || sat.attribute_target_column
                   || ' as text),''${CDC_NULL}'')',
               '||''${CDC_DEL}''||'
               order by sat.attribute_number
           )
           ||
           ', ''sha256'')'
           as sat_attributes_concat_dv,

           sat.process_in_subruntypes

    from pdi_meta.vw_stg_management_link_satellites_all_columns_filled sat

    group by
           sat.sat_name,
           sat.sat_key,
           sat.sat_description,
           sat.sat_link,
           sat.ind_current,
           sat.source_concat,

           sat.source_hub_1_business_key,
           sat.source_hub_2_business_key,
           sat.source_hub_3_business_key,
           sat.source_hub_4_business_key,
           sat.source_hub_5_business_key,
           sat.source_hub_6_business_key,
           sat.source_hub_7_business_key,
           sat.source_hub_8_business_key,
           sat.source_hub_9_business_key,
           sat.source_hub_10_business_key,

           sat.source_lnk_key_attribute_1,
           sat.source_lnk_key_attribute_2,
           sat.source_lnk_key_attribute_3,
           sat.source_lnk_key_attribute_4,
           sat.source_lnk_key_attribute_5,

           sat.process_in_subruntypes

) stg_sat

cross join pdi_meta.stg_management_data_vaults dv

inner join pdi_meta.ref_data_vault_links ref_links
        on stg_sat.sat_link = ref_links.link_name
       and dv.id_data_vault = ref_links.id_data_vault

inner join pdi_meta.stg_management_source_tables stg_srctab
        on stg_sat.source_concat = stg_srctab.source_concat

inner join pdi_meta.ref_source_systems ref_srcsys
        on stg_srctab.source_system = ref_srcsys.description

inner join pdi_meta.ref_source_tables ref_srctab
        on ref_srcsys.id_srcsys = ref_srctab.id_srcsys
       and stg_srctab.table_name = ref_srctab.table_name

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_1
        on ref_links.id_data_vault_hub_1 = ref_hubs_1.id_data_vault_hub

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_2
        on ref_links.id_data_vault_hub_2 = ref_hubs_2.id_data_vault_hub

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_3
        on ref_links.id_data_vault_hub_3 = ref_hubs_3.id_data_vault_hub

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_4
        on ref_links.id_data_vault_hub_4 = ref_hubs_4.id_data_vault_hub

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_5
        on ref_links.id_data_vault_hub_5 = ref_hubs_5.id_data_vault_hub

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_6
        on ref_links.id_data_vault_hub_6 = ref_hubs_6.id_data_vault_hub

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_7
        on ref_links.id_data_vault_hub_7 = ref_hubs_7.id_data_vault_hub

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_8
        on ref_links.id_data_vault_hub_8 = ref_hubs_8.id_data_vault_hub

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_9
        on ref_links.id_data_vault_hub_9 = ref_hubs_9.id_data_vault_hub

left outer join pdi_meta.ref_data_vault_hubs ref_hubs_10
        on ref_links.id_data_vault_hub_10 = ref_hubs_10.id_data_vault_hub

where stg_sat.ind_current = 1</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

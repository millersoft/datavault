  <transform>
    <name>ref_data_vault_link_satellites</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>sat_name</field>
        <name>sat_name</name>
      </key>
      <key>
        <condition>=</condition>
        <field>id_data_vault_link</field>
        <name>id_data_vault_link</name>
      </key>
      <schema/>
      <table>ref_data_vault_link_satellites</table>
      <value>
        <name>id_data_vault_link</name>
        <rename>id_data_vault_link</rename>
        <update>N</update>
      </value>
      <value>
        <name>sat_name</name>
        <rename>sat_name</rename>
        <update>N</update>
      </value>
      <value>
        <name>description</name>
        <rename>description</rename>
        <update>Y</update>
      </value>
      <value>
        <name>record_source_id</name>

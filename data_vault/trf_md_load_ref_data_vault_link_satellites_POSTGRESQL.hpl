        <update>Y</update>
      </value>
      <value>
        <name>sat_source_hub_4_business_key</name>
        <rename>sat_source_hub_4_business_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_source_hub_5_business_key</name>
        <rename>sat_source_hub_5_business_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_current</name>
        <rename>ind_current</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_attributes</name>
        <rename>sat_attributes</rename>
        <update>Y</update>
      </value>

      </value>
      <value>
        <name>sat_source_hub_8_business_key</name>
        <rename>sat_source_hub_8_business_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_source_hub_9_business_key</name>
        <rename>sat_source_hub_9_business_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sat_source_hub_10_business_key</name>
        <rename>sat_source_hub_10_business_key</rename>

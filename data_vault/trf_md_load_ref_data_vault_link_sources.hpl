        <name>source_hub_9_business_key</name>
        <rename>source_hub_9_hash_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>source_hub_10_business_key</name>
        <rename>source_hub_10_hash_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_status_sat</name>
        <rename>ind_status_sat</rename>
        <update>Y</update>
      </value>
      <value>
        <name>process_in_subruntypes</name>
        <rename>process_in_subruntypes</rename>
        <update>Y</update>
      </value>
    </lookup>
    <update_bypassed>N</update_bypassed>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>stg_management_link_sources</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select          ref_links.id_data_vault_link
,               stg_links.ind_current
,               ref_srctab.id_srctab              as record_source_id
-- ,               ref_rs.record_source_id                as system_source_id
,               stg_links.link_source_order         as source_order
,               stg_links.source_hub_1_hash_key
,               stg_links.source_hub_2_hash_key
,               stg_links.source_hub_3_hash_key
,               stg_links.source_hub_4_hash_key
,               stg_links.source_hub_5_hash_key
,               stg_links.source_hub_6_hash_key
,               stg_links.source_hub_7_hash_key
,               stg_links.source_hub_8_hash_key
,               stg_links.source_hub_9_hash_key
,               stg_links.source_hub_10_hash_key
,               stg_links.ind_status_sat
,               stg_links.process_in_subruntypes
from            stg_management_links            stg_links
cross join      stg_management_data_vaults      dv
inner join      stg_management_source_tables    stg_srctab
on              stg_links.source_concat       = stg_srctab.source_concat
inner join      ref_source_systems              ref_srcsys
on              stg_srctab.source_system      = ref_srcsys.description
inner join      ref_source_tables               ref_srctab
on              ref_srcsys.id_srcsys          = ref_srctab.id_srcsys
and             stg_srctab.table_name         = ref_srctab.table_name
and             coalesce(stg_srctab.source_schema,'') = coalesce(ref_srctab.source_schema,'')
and             stg_srctab.staging_table_name = ref_srctab.staging_table_name
inner join      ref_data_vault_links            ref_links
on              stg_links.link_name           = ref_links.link_name
and             ref_links.id_data_vault       = dv.id_data_vault
-- inner join		ref_record_source				ref_rs
-- on				ref_rs.source_name			  = ref_srcsys.cod_srcsys
where           stg_links.ind_current         = 1</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

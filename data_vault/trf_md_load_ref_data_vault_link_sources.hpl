      <xloc>64</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>272</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>stg_management_link_sources</from>
      <to>ref_data_vault_link_sources</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>ref_data_vault_link_sources</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>id_data_vault_link</field>
        <name>id_data_vault_link</name>
      </key>
      <key>
        <condition>=</condition>
        <field>record_source_id</field>
        <name>record_source_id</name>
      </key>
      <key>
        <condition>=</condition>
        <field>source_order</field>
        <name>source_order</name>
      </key>
      <schema/>
      <table>ref_data_vault_link_sources</table>
      <value>
        <name>id_data_vault_link</name>
        <rename>id_data_vault_link</rename>
        <update>N</update>
      </value>
      <value>
        <name>ind_current</name>
        <rename>ind_current</rename>
        <update>Y</update>
      </value>
      <value>
        <name>record_source_id</name>
        <rename>record_source_id</rename>
        <update>Y</update>
      </value>
      <value>
        <name>source_order</name>
        <rename>source_order</rename>
        <update>N</update>
      </value>
      <value>
        <name>source_hub_1_business_key</name>
        <rename>source_hub_1_hash_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>source_hub_2_business_key</name>
        <rename>source_hub_2_hash_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>source_hub_3_business_key</name>
        <rename>source_hub_3_hash_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>source_hub_4_business_key</name>
        <rename>source_hub_4_hash_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>source_hub_5_business_key</name>
        <rename>source_hub_5_hash_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>source_hub_6_business_key</name>
        <rename>source_hub_6_hash_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>source_hub_7_business_key</name>
        <rename>source_hub_7_hash_key</rename>
        <update>Y</update>

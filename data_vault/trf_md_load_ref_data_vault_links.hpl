        <name>link_hub_9_key_column</name>
        <rename>link_hub_9_key_column</rename>
        <update>Y</update>
      </value>
      <value>
        <name>link_hub_10_key_column</name>
        <rename>link_hub_10_key_column</rename>
        <update>Y</update>
      </value>
      <value>
        <name>lnk_cnt_hubs</name>
        <rename>lnk_cnt_hubs</rename>
        <update>Y</update>
      </value>
      <value>
        <name>lnk_ind_attributes</name>
        <rename>lnk_ind_attributes</rename>
        <update>Y</update>
      </value>
      <value>
        <name>lnk_bk_columns</name>
        <rename>lnk_bk_columns</rename>
        <update>Y</update>
      </value>
      <value>
        <name>lnk_no_bk_columns</name>
        <rename>lnk_no_bk_columns</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_last_seen_dts</name>
        <rename>ind_last_seen_dts</rename>
        <update>Y</update>
      </value>
      <value>
        <name>lnk_group_key_column</name>
        <rename>lnk_group_key_column</rename>
        <update>Y</update>
      </value>

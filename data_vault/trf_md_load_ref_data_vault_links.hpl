    <connection>pdi_meta</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>link_name</field>
        <name>link_name</name>
      </key>
      <key>
        <condition>=</condition>
        <field>id_data_vault</field>
        <name>id_data_vault</name>
      </key>
      <schema/>
      <table>ref_data_vault_links</table>
      <value>
        <name>link_name</name>
        <rename>link_name</rename>
        <update>N</update>
      </value>
      <value>
        <name>id_data_vault</name>
        <rename>id_data_vault</rename>
        <update>N</update>
      </value>
      <value>
        <name>link_key</name>
        <rename>link_key</rename>
        <update>Y</update>
      </value>
      <value>
        <name>description</name>
        <rename>description</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_current</name>
        <rename>ind_current</rename>
        <update>Y</update>
      </value>
      <value>
        <name>id_data_vault_hub_1</name>
        <rename>id_data_vault_hub_1</rename>
        <update>Y</update>
      </value>
      <value>
        <name>id_data_vault_hub_2</name>
        <rename>id_data_vault_hub_2</rename>
        <update>Y</update>

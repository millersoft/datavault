<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_md_load_ref_data_vault_objects_in_subruntypes</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load design metadata: data vault objects in subruntypes</description>
    <extended_description>This transformation fulle refreshes (TRUNCATE/INSERT) table ref_data_vault_objects_in_subruntypes.
That table contains the information which Data Vault objects get refreshed in which subruntype.

Every current Data Vault objects belongs to subruntype 0, the complete (and default) subruntype.
Subruntype 0 must not be specified in the column 'process_in_subruntypes', it is added in this transformation.
That column 'process_in_subruntypes' contains all subruntypes a Data vault object belongs to in a pipe-delimited format.
Example:
|1|4|	Object belongs to subruntypes 1 and 4, and the default subruntype 0.

When the column is empty, the object only belongs to the default subruntype 0.</extended_description>
    <pipeline_version>1.2</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:32.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2014/12/14 11:24:46.367</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ariel</fontname>
      <fontsize>10</fontsize>
      <height>22</height>
      <xloc>96</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>272</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>hubs</from>
      <to>Append links</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>links</from>
      <to>Append links</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Append links</from>
      <to>Append hub_satellites</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>hub_satellites</from>
      <to>Append hub_satellites</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Append hub_satellites</from>
      <to>Append link_satellites</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>link_satellites</from>
      <to>Append link_satellites</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Append link_satellites</from>
      <to>Split field 'process_in_subruntypes' to rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Split field 'process_in_subruntypes' to rows</from>
      <to>Subruntype NOT NULL?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Subruntype NOT NULL?</from>
      <to>Ignore subruntype NULL</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Subruntype NOT NULL?</from>
      <to>subruntype -> number</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>subruntype -> number</from>
      <to>ref_data_vault_objects_in_subruntypes</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Append hub_satellites</name>
    <type>Append</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <head_name>Append links</head_name>
    <tail_name>hub_satellites</tail_name>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>288</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Append link_satellites</name>
    <type>Append</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <head_name>Append hub_satellites</head_name>
    <tail_name>link_satellites</tail_name>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Append links</name>
    <type>Append</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <head_name>hubs</head_name>
    <tail_name>links</tail_name>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ignore subruntype NULL</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>768</xloc>
      <yloc>288</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Split field 'process_in_subruntypes' to rows</name>
    <type>SplitFieldToRows3</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <delimiter>|</delimiter>
    <delimiter_is_regex>N</delimiter_is_regex>
    <newfield>subruntype</newfield>
    <resetrownumber>Y</resetrownumber>
    <rownum>N</rownum>
    <splitfield>process_in_subruntypes</splitfield>
    <attributes/>
    <GUI>
      <xloc>512</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Subruntype NOT NULL?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compare>
      <condition>
        <conditions>
</conditions>
        <function>IS NOT NULL</function>
        <leftvalue>subruntype</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
      </condition>
    </compare>
    <send_false_to>Ignore subruntype NULL</send_false_to>
    <send_true_to>subruntype -> number</send_true_to>
    <attributes/>
    <GUI>
      <xloc>768</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>hub_satellites</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT     DISTINCT hubs.id_data_vault      as id_data_vault
,          'hub_satellite'         as data_vault_object_type
,          hsats.sat_name          as data_vault_object_name
,          srcsys.description      as source_system
,          srctab.table_name       as source_table
,          1                       as source_order
,          0                       as ind_status_sat
,          0                       as ind_validity_sat
,          CONCAT('|0',COALESCE(hsats.process_in_subruntypes,'')) as process_in_subruntypes 
FROM       ref_data_vault_hub_satellites hsats
INNER JOIN ref_data_vault_hubs           hubs
ON         hsats.id_data_vault_hub     = hubs.id_data_vault_hub
INNER JOIN ref_source_tables             srctab
ON         hsats.record_source_id      = srctab.id_srctab
INNER JOIN ref_source_systems            srcsys
ON         srctab.id_srcsys            = srcsys.id_srcsys
WHERE      hsats.ind_current           = 1</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>288</yloc>
    </GUI>
  </transform>
  <transform>
    <name>hubs</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT     DISTINCT hubs.id_data_vault      as id_data_vault
,          'hub'                   as data_vault_object_type
,          hubs.hub_name           as data_vault_object_name
,          srcsys.description      as source_system
,          srctab.table_name       as source_table
,          hsrc.source_order       as source_order
,          hsrc.ind_status_sat     as ind_status_sat
,          0                       as ind_validity_sat
,          CONCAT('|0',COALESCE(hsrc.process_in_subruntypes,'')) as process_in_subruntypes 
FROM       ref_data_vault_hub_sources hsrc
INNER JOIN ref_data_vault_hubs        hubs
ON         hsrc.id_data_vault_hub   = hubs.id_data_vault_hub
INNER JOIN ref_source_tables          srctab
ON         hsrc.record_source_id    = srctab.id_srctab
INNER JOIN ref_source_systems         srcsys
ON         srctab.id_srcsys         = srcsys.id_srcsys
WHERE      hsrc.ind_current         = 1</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>link_satellites</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT     DISTINCT links.id_data_vault     as id_data_vault
,          'link_satellite'        as data_vault_object_type
,          lsats.sat_name          as data_vault_object_name
,          srcsys.description      as source_system
,          srctab.table_name       as source_table
,          1                       as source_order
,          0                       as ind_status_sat
,          0                       as ind_validity_sat
,          CONCAT('|0',COALESCE(lsats.process_in_subruntypes,'')) as process_in_subruntypes 
FROM       ref_data_vault_link_satellites lsats
INNER JOIN ref_data_vault_links           links
ON         lsats.id_data_vault_link     = links.id_data_vault_link
INNER JOIN ref_source_tables              srctab
ON         lsats.record_source_id       = srctab.id_srctab
INNER JOIN ref_source_systems             srcsys
ON         srctab.id_srcsys             = srcsys.id_srcsys
WHERE      lsats.ind_current            = 1</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>links</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT     DISTINCT links.id_data_vault     as id_data_vault
,          'link'                  as data_vault_object_type
,          links.link_name         as data_vault_object_name
,          srcsys.description      as source_system
,          srctab.table_name       as source_table
,          lsrc.source_order       as source_order
,          lsrc.ind_status_sat     as ind_status_sat
,          CASE
               WHEN links.lnk_bk_columns       IS NOT NULL
                 OR links.lnk_group_key_column IS NOT NULL THEN 1
               ELSE 0
           END                     as ind_validity_sat
,          CONCAT('|0',COALESCE(lsrc.process_in_subruntypes,'')) as process_in_subruntypes 
FROM       ref_data_vault_link_sources lsrc
INNER JOIN ref_data_vault_links        links
ON         lsrc.id_data_vault_link   = links.id_data_vault_link
INNER JOIN ref_source_tables           srctab
ON         lsrc.record_source_id     = srctab.id_srctab
INNER JOIN ref_source_systems          srcsys
ON         srctab.id_srcsys          = srcsys.id_srcsys
WHERE      lsrc.ind_current          = 1</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>ref_data_vault_objects_in_subruntypes</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <fields>
      <field>
        <column_name>id_data_vault</column_name>
        <stream_name>id_data_vault</stream_name>
      </field>
      <field>
        <column_name>data_vault_object_type</column_name>
        <stream_name>data_vault_object_type</stream_name>
      </field>
      <field>
        <column_name>data_vault_object_name</column_name>
        <stream_name>data_vault_object_name</stream_name>
      </field>
      <field>
        <column_name>source_system</column_name>
        <stream_name>source_system</stream_name>
      </field>
      <field>
        <column_name>source_table</column_name>
        <stream_name>source_table</stream_name>
      </field>
      <field>
        <column_name>source_order</column_name>
        <stream_name>source_order</stream_name>
      </field>
      <field>
        <column_name>ind_status_sat</column_name>
        <stream_name>ind_status_sat</stream_name>
      </field>
      <field>
        <column_name>ind_validity_sat</column_name>
        <stream_name>ind_validity_sat</stream_name>
      </field>
      <field>
        <column_name>subruntype</column_name>
        <stream_name>subruntype</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <table>ref_data_vault_objects_in_subruntypes</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>1248</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>subruntype -> number</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <meta>
        <date_format_lenient>N</date_format_lenient>
        <length>-2</length>
        <lenient_string_to_number>N</lenient_string_to_number>
        <name>subruntype</name>
        <precision>-2</precision>
        <rename>subruntype</rename>
        <storage_type/>
        <type>Number</type>
      </meta>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>992</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

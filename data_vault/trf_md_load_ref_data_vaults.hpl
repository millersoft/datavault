<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_md_load_ref_data_vaults</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load design metadata: data vaults</description>
    <extended_description>This transformation loads the Data Vault name and description from the staging table into the ref table.</extended_description>
    <pipeline_version>1.2</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:34.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2014/12/14 11:22:28.554</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ariel</fontname>
      <fontsize>10</fontsize>
      <height>22</height>
      <xloc>64</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>272</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>stg_management_data_vaults</from>
      <to>ref_data_vaults</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>ref_data_vaults</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>id_data_vault</field>
        <name>id_data_vault</name>
      </key>
      <schema/>
      <table>ref_data_vaults</table>
      <value>
        <name>id_data_vault</name>
        <rename>id_data_vault</rename>
        <update>N</update>
      </value>
      <value>
        <name>data_vault_name</name>
        <rename>data_vault_name</rename>
        <update>Y</update>
      </value>
      <value>
        <name>data_vault_description</name>
        <rename>data_vault_description</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_current</name>
        <rename>ind_current</rename>
        <update>Y</update>
      </value>
    </lookup>
    <update_bypassed>N</update_bypassed>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>stg_management_data_vaults</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
  stg_dv.id_data_vault
, stg_dv.data_vault_name
, stg_dv.data_vault_description
, stg_dv.ind_current
FROM            stg_management_data_vaults   stg_dv
WHERE NOT EXISTS
(
select 1
from   ref_data_vaults                       dv
where  dv.id_data_vault                      = stg_dv.id_data_vault
and    coalesce(dv.data_vault_name,'')         = coalesce(dv.data_vault_name,'')
and    coalesce(dv.data_vault_description,'')  = coalesce(dv.data_vault_description,'')
and    coalesce(dv.ind_current,0)              = coalesce(dv.ind_current,0)
)        </sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_md_load_ref_source_systems</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Load design metadata: source systems</description>
    <extended_description>This transformation loads the source systems from the staging table into the ref table.</extended_description>
    <pipeline_version>1.3</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>admin</created_user>
    <created_date>2011/02/02 21:09:34.000</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2014/12/14 11:21:56.234</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ariel</fontname>
      <fontsize>10</fontsize>
      <height>22</height>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>272</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>stg_management_source_systems</from>
      <to>ref_source_systems</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>ref_source_systems</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <lookup>
      <key>
        <condition>=</condition>
        <field>id_srcsys</field>
        <name>id_srcsys</name>
      </key>
      <schema/>
      <table>ref_source_systems</table>
      <value>
        <name>id_srcsys</name>
        <rename>id_srcsys</rename>
        <update>N</update>
      </value>
      <value>
        <name>cod_srcsys</name>
        <rename>cod_srcsys</rename>
        <update>Y</update>
      </value>
      <value>
        <name>description</name>
        <rename>description</rename>
        <update>Y</update>
      </value>
      <value>
        <name>id_source_connection</name>
        <rename>id_source_connection</rename>
        <update>Y</update>
      </value>
      <value>
        <name>id_staging_connection</name>
        <rename>id_staging_connection</rename>
        <update>Y</update>
      </value>
      <value>
        <name>staging_days_to_load_default</name>
        <rename>staging_days_to_load_default</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ind_archive_staging_tables</name>
        <rename>ind_archive_staging_tables</rename>
        <update>Y</update>
      </value>
    </lookup>
    <update_bypassed>N</update_bypassed>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>stg_management_source_systems</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT
  srcsys.id_srcsys
, srcsys.cod_srcsys
, srcsys.description
, source_conn.id_connection  as id_source_connection
, stag_conn.id_connection    as id_staging_connection
, srcsys.staging_days_to_load_default
, srcsys.ind_archive_staging_tables
FROM            stg_management_source_systems srcsys
LEFT OUTER JOIN ref_connections               source_conn
ON              srcsys.source_connection    = source_conn.name
LEFT OUTER JOIN ref_connections               stag_conn
ON              srcsys.staging_connection    = stag_conn.name
WHERE NOT EXISTS
(
select 1
from ref_source_systems                               srcsys_bestaand
where srcsys.id_srcsys                              = srcsys_bestaand.id_srcsys
and   coalesce(srcsys.cod_srcsys,'')                  = coalesce(srcsys_bestaand.cod_srcsys,'')
and   coalesce(source_conn.id_connection,0)           = coalesce(srcsys_bestaand.id_source_connection,0)  
and   coalesce(stag_conn.id_connection,0)             = coalesce(srcsys_bestaand.id_staging_connection,0) 
and   coalesce(srcsys.staging_days_to_load_default,0) = coalesce(srcsys_bestaand.staging_days_to_load_default,0) 
and   coalesce(srcsys.ind_archive_staging_tables,0)   = coalesce(srcsys_bestaand.ind_archive_staging_tables,0) 
)        </sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>160</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

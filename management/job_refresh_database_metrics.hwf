    <hop>
      <from>end_run of type 'par_id_rtyp'  (error)</from>
      <to>Send error mail?</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>

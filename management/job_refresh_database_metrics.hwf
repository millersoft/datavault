      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>job_refresh_database_table_metrics (Data Vault)</from>
      <to>job_refresh_database_table_metrics (Staging)</to>
      <enabled>Y</enabled>

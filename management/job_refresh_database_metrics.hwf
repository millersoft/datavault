<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>job_refresh_database_metrics</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Refresh database metrics.</description>
  <extended_description>This job refreshes database metrics in the pdi_meta database.
The current setup records the table sizes of the Data Vault and the Staging database.
The resulting numbers can be used for identifying possible space problems or predict database growth over time.

Parameter 'par_id_rtyp' determines the runtype, make sure that the corresponding entry in metadata table 'ref_runtypes'
contains a fitting description for this job.
Optionally a mail will be sent after success/failure of the job.

Suggestion: schedule this job once a week, providing history on a weekly basis.
</extended_description>
  <workflow_version>1.1</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user/>
  <created_date>2014/05/26 21:54:14.516</created_date>
  <modified_user>admin</modified_user>
  <modified_date>2014/12/12 15:27:59.248</modified_date>
  <parameters>
    <parameter>
      <name>par_id_rtyp</name>
      <default_value>6</default_value>
      <description>The runtype for refreshing the database table metrics.</description>
    </parameter>
    <parameter>
      <name>par_send_error_mail_ind</name>
      <default_value>0</default_value>
      <description>Indicator whether a mail should be send on error (0=No, 1=Yes).</description>
    </parameter>
    <parameter>
      <name>par_send_success_mail_ind</name>
      <default_value>0</default_value>
      <description>Indicator whether a mail should be send on success (0=No, 1=Yes).</description>
    </parameter>
    <parameter>
      <name>par_subruntype</name>
      <default_value>0</default_value>
      <description>The subruntype. </description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>448</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_new_run of type 'par_id_rtyp'</name>
      <description>Create a new ETL run of type 1.</description>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_create_new_run(${par_id_rtyp},0,${par_subruntype})</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>end_run of type 'par_id_rtyp'</name>
      <description>End the current ETL run with status 2 (succesfully completed).</description>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_end_run(2,NULL,${par_id_rtyp})</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>448</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Set var_id_rtyp and var_subruntype</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <fields>
        <field>
          <variable_name>var_id_rtyp</variable_name>
          <variable_type>CURRENT_WORKFLOW</variable_type>
          <variable_value>${par_id_rtyp}</variable_value>
        </field>
        <field>
          <variable_name>var_subruntype</variable_name>
          <variable_type>CURRENT_WORKFLOW</variable_type>
          <variable_value>${par_subruntype}</variable_value>
        </field>
      </fields>
      <file_variable_type>CURRENT_WORKFLOW</file_variable_type>
      <replacevars>Y</replacevars>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>job_refresh_database_table_metrics (Data Vault)</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/management/job_refresh_database_table_metrics.hwf</filename>
      <loglevel>Nothing</loglevel>
      <parameters>
        <parameter>
          <name>par_table_name_condition</name>
          <value>and table_name not like'%\_err'</value>
        </parameter>
        <parameter>
          <name>par_table_schema</name>
          <value>${data_vault_schema_name}</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>job_refresh_database_table_metrics (Staging)</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/management/job_refresh_database_table_metrics.hwf</filename>
      <loglevel>Nothing</loglevel>
      <parameters>
        <parameter>
          <name>par_table_name_condition</name>
          <value>and table_name not like'%\_err'</value>
        </parameter>
        <parameter>
          <name>par_table_schema</name>
          <value>${stg_schema_name}</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>job_send_mail (error)</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/management/job_send_mail.hwf</filename>
      <loglevel>Nothing</loglevel>
      <parameters>
        <parameter>
          <name>par_file_to_attach</name>
        </parameter>
        <parameter>
          <name>par_mail_body</name>
          <value>Something went wrong in job ${Internal.Workflow.Name}. Check the log for details.</value>
        </parameter>
        <parameter>
          <name>par_mail_subject</name>
          <value>Error in ETL job ${Internal.Workflow.Name}</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>448</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Abort job</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <always_log_rows>N</always_log_rows>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>448</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Send error mail?</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <comparevalue>1</comparevalue>
      <fieldtype>number</fieldtype>
      <successbooleancondition>false</successbooleancondition>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successwhenvarset>N</successwhenvarset>
      <valuetype>variable</valuetype>
      <variablename>${par_send_error_mail_ind}</variablename>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>job_send_mail (success)</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/management/job_send_mail.hwf</filename>
      <loglevel>Nothing</loglevel>
      <parameters>
        <parameter>
          <name>par_file_to_attach</name>
        </parameter>
        <parameter>
          <name>par_mail_body</name>
          <value>ETL job ${Internal.Workflow.Name} completed successfully.</value>
        </parameter>
        <parameter>
          <name>par_mail_subject</name>
          <value>ETL job ${Internal.Workflow.Name} completed</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>1056</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Send success mail?</name>
      <description/>
      <type>SIMPLE_EVAL</type>
      <attributes/>
      <comparevalue>1</comparevalue>
      <fieldtype>number</fieldtype>
      <successbooleancondition>false</successbooleancondition>
      <successcondition>equal</successcondition>
      <successnumbercondition>equal</successnumbercondition>
      <successwhenvarset>N</successwhenvarset>
      <valuetype>variable</valuetype>
      <variablename>${par_send_success_mail_ind}</variablename>
      <parallel>N</parallel>
      <xloc>832</xloc>
      <yloc>448</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>end_run of type 'par_id_rtyp'  (error)</name>
      <description>End the current ETL run with status 2 (succesfully completed).</description>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_end_run(3,'Error, check the logs!',${par_id_rtyp})</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>256</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>

      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>job_refresh_database_table_metrics (Staging)</from>
      <to>end_run of type 'par_id_rtyp'  (error)</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>job_refresh_database_table_metrics (Data Vault)</from>
      <to>end_run of type 'par_id_rtyp'  (error)</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>

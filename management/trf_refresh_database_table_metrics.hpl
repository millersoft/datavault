<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_refresh_database_table_metrics</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Refresh database table metrics</description>
    <extended_description>This transformation refreshes database table sizes in the pdi_meta database tables adm_database_table_sizes_(hist).
The resulting numbers can be used for identifying possible space problems or predict database growth over time.
Source for these numbers is the view 'vw_adm_database_table_sizes' in the metadata database.

Parameter 'par_table_schema' determines which schema to analyze.
Parameter 'par_table_name_condition' can be used to specifically include/exclude tables.

To exclude gathering sizes for error-tables in the Data Vault for example, use this value:
and table_name not like'%\_err'</extended_description>
    <pipeline_version>1.1</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>par_table_name_condition</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>par_table_schema</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2014/11/16 16:17:13.863</created_date>
    <modified_user>-</modified_user>
    <modified_date>2014/12/14 11:14:32.319</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ubuntu</fontname>
      <fontsize>11</fontsize>
      <height>23</height>
      <xloc>64</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>282</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>vw_adm_database_table_sizes</from>
      <to>adm_database_table_sizes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>vw_adm_database_table_sizes</from>
      <to>adm_database_table_sizes_hist</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>adm_database_table_sizes</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <fields>
      <field>
        <column_name>table_schema</column_name>
        <stream_name>table_schema</stream_name>
      </field>
      <field>
        <column_name>table_name</column_name>
        <stream_name>table_name</stream_name>
      </field>
      <field>
        <column_name>date_checked</column_name>
        <stream_name>date_checked</stream_name>
      </field>
      <field>
        <column_name>data_mb</column_name>
        <stream_name>data_mb</stream_name>
      </field>
      <field>
        <column_name>index_mb</column_name>
        <stream_name>index_mb</stream_name>
      </field>
      <field>
        <column_name>id_run_checked</column_name>
        <stream_name>id_run_checked</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <table>adm_database_table_sizes</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>adm_database_table_sizes_hist</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>${PROP_COMMIT_SIZE_PDI_META}</commit>
    <connection>pdi_meta</connection>
    <fields>
      <field>
        <column_name>table_schema</column_name>
        <stream_name>table_schema</stream_name>
      </field>
      <field>
        <column_name>table_name</column_name>
        <stream_name>table_name</stream_name>
      </field>
      <field>
        <column_name>date_checked</column_name>
        <stream_name>date_checked</stream_name>
      </field>
      <field>
        <column_name>data_mb</column_name>
        <stream_name>data_mb</stream_name>
      </field>
      <field>
        <column_name>index_mb</column_name>
        <stream_name>index_mb</stream_name>
      </field>
      <field>
        <column_name>id_run_checked</column_name>
        <stream_name>id_run_checked</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <table>adm_database_table_sizes_hist</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>320</yloc>
    </GUI>
  </transform>
  <transform>
    <name>vw_adm_database_table_sizes</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT table_schema
,      table_name
,      date_checked
,      data_mb
,      index_mb
,      (select id_run from inst_actual_runs where id_rtyp = ${var_id_rtyp}) as id_run_checked
FROM   vw_adm_database_table_sizes
WHERE  table_schema = '${par_table_schema}'
${par_table_name_condition}
</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

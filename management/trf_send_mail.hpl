<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_send_mail</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Transformation: send mail</description>
    <extended_description>This transformation sends a mail.
The following properties in the properties file are relevant:

mail_destination_address
mail_sender_name
mail_sender_address
mail_smtp_server
mail_smtp_port
mail_authentication_user
mail_authentication_password

The transformation parameters determine the subject, body and optionally an attached file.

par_mail_subject
par_mail_body
par_file_to_attach
</extended_description>
    <pipeline_version>1.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>par_file_to_attach</name>
        <default_value/>
        <description>Filename of the file to attach (optional).</description>
      </parameter>
      <parameter>
        <name>par_mail_body</name>
        <default_value/>
        <description>Body of the mail.</description>
      </parameter>
      <parameter>
        <name>par_mail_subject</name>
        <default_value/>
        <description>Subject of the mail.</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2014/11/16 18:30:30.307</created_date>
    <modified_user>-</modified_user>
    <modified_date>2014/11/18 20:56:33.833</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ubuntu</fontname>
      <fontsize>11</fontsize>
      <height>23</height>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>282</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Get Mail Variables</from>
      <to>Mail</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Get Mail Variables</name>
    <type>GetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-1</length>
        <name>mail_destination_address</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${mail_destination_address}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>mail_sender_name</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${mail_sender_name}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>mail_sender_address</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${mail_sender_address}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>mail_smtp_server</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${mail_smtp_server}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>mail_smtp_port</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${mail_smtp_port}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>mail_authentication_user</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${mail_authentication_user}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>mail_authentication_password</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${mail_authentication_password}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>par_mail_subject</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${par_mail_subject}</variable>
      </field>
      <field>
        <length>-1</length>
        <name>par_mail_body</name>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <type>String</type>
        <variable>${par_mail_body}</variable>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Mail</name>
    <type>Mail</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attachContentFromField>N</attachContentFromField>
    <auth_password>Encrypted 6d61696c5f61757468656e76d7fbcebc03c89cbbbb18bd63c99dbdde</auth_password>
    <auth_user>mail_authentication_user</auth_user>
    <check_server_identity>N</check_server_identity>
    <comment>par_mail_body</comment>
    <destination>mail_destination_address</destination>
    <embeddedimages>
</embeddedimages>
    <encoding>UTF-8</encoding>
    <importance>high</importance>
    <include_date>Y</include_date>
    <include_files>N</include_files>
    <include_message_in_output>N</include_message_in_output>
    <include_subfolders>N</include_subfolders>
    <isFilenameDynamic>N</isFilenameDynamic>
    <only_comment>N</only_comment>
    <port>mail_smtp_port</port>
    <priority>high</priority>
    <replyto>mail_sender_address</replyto>
    <replytoname>mail_sender_name</replytoname>
    <secureconnectiontype>SSL</secureconnectiontype>
    <sensitivity>normal</sensitivity>
    <server>mail_smtp_server</server>
    <sourcefilefoldername>${par_file_to_attach}</sourcefilefoldername>
    <subject>par_mail_subject</subject>
    <use_HTML>N</use_HTML>
    <use_Priority>Y</use_Priority>
    <use_auth>Y</use_auth>
    <use_secure_auth>Y</use_secure_auth>
    <usexoauth2>N</usexoauth2>
    <zipFilenameDynamic>N</zipFilenameDynamic>
    <zip_files>N</zip_files>
    <zip_limit_size>0</zip_limit_size>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

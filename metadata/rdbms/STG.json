{
  "rdbms": {
    "POSTGRESQL": {
      "databaseName": "${stg_database_name}",
      "pluginId": "POSTGRESQL",
      "accessType": 0,
      "hostname": "${stg_host_name}",
      "password": "${stg_password}",
      "pluginName": "PostgreSQL",
      "port": "${stg_port_number}",
      "attributes": {
        "USE_POOLING": "N",
        "IS_CLUSTERED": "N",
        "SUPPORTS_TIMESTAMP_DATA_TYPE": "Y",
        "QUOTE_ALL_FIELDS": "N",
        "FORCE_IDENTIFIERS_TO_LOWERCASE": "N",
        "SUPPORTS_BOOLEAN_DATA_TYPE": "N",
        "PRESERVE_RESERVED_WORD_CASE": "N",
        "FORCE_IDENTIFIERS_TO_UPPERCASE": "N",
        "PORT_NUMBER": "${stg_port_number}"
      },
      "username": "${stg_user_name}"
    }
  },
  "name": "STG"
}
<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>job_stg_load_file_directory_generic</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Generic staging job: load all files in a directory</description>
  <extended_description>This job loads all current source file from the given source file directory (parameter).
The necessary metadata is stored in the tables:

ref_source_file_directories
ref_source_files
ref_source_file_columns</extended_description>
  <workflow_version>1.4</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user/>
  <created_date>2014/12/15 01:10:16.912</created_date>
  <modified_user>admin</modified_user>
  <modified_date>2017/03/03 12:16:32.608</modified_date>
  <parameters>
    <parameter>
      <name>id_srcfile_directory</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>par_id_rtyp</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>par_subruntype</name>
      <default_value>0</default_value>
      <description/>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Set var_id_rtyp and var_subruntype</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <fields>
        <field>
          <variable_name>var_id_rtyp</variable_name>
          <variable_type>CURRENT_WORKFLOW</variable_type>
          <variable_value>${par_id_rtyp}</variable_value>
        </field>
        <field>
          <variable_name>var_subruntype</variable_name>
          <variable_type>CURRENT_WORKFLOW</variable_type>
          <variable_value>${par_subruntype}</variable_value>
        </field>
      </fields>
      <file_variable_type>CURRENT_WORKFLOW</file_variable_type>
      <replacevars>Y</replacevars>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>create_new_run of type 'par_id_rtyp'</name>
      <description>Create a new ETL run of type 1.</description>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_create_new_run(${par_id_rtyp},0,${par_subruntype})</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>end_run of type 'par_id_rtyp'</name>
      <description>End the current ETL run with status 2 (succesfully completed).</description>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_end_run(2,NULL,${par_id_rtyp})</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1152</xloc>
      <yloc>480</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1376</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>File directory empty?</name>
      <description/>
      <type>FOLDER_IS_EMPTY</type>
      <attributes/>
      <foldername>${file_directory}</foldername>
      <include_subfolders>N</include_subfolders>
      <specify_wildcard>N</specify_wildcard>
      <parallel>N</parallel>
      <xloc>912</xloc>
      <yloc>272</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>trf_stg_set_variable_file_directory_archive</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/staging_generic/staging_generic_files_in_directory/trf_stg_set_variable_file_directory_archive.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <parameter>
          <name>id_srcfile_directory</name>
          <value>${id_srcfile_directory}</value>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>Y</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>896</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>trf_stg_determine_source_files_to_load_in_directory</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/staging_generic/staging_generic_files_in_directory/trf_stg_determine_source_files_to_load_in_directory.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <parameter>
          <name>id_srcfile_directory</name>
          <stream_name>${id_srcfile_directory}</stream_name>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>job_stg_load_file_generic</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>Y</exec_per_row>
      <filename>${PROJECT_HOME}/staging_generic/staging_generic_files_in_directory/job_stg_load_file_generic.hwf</filename>
      <loglevel>Nothing</loglevel>
      <parameters>
        <parameter>
          <name>id_srcfile</name>
          <stream_name>id_srcfile</stream_name>
        </parameter>
        <parameter>
          <name>stg_target_table</name>
          <stream_name>stg_target_table</stream_name>
        </parameter>
        <parameter>
          <name>trf_stg_inject_metadata_to_execute</name>
          <stream_name>trf_stg_inject_metadata_to_execute</stream_name>
        </parameter>
        <parameter>
          <name>filename</name>
          <stream_name>filename</stream_name>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>Y</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>end_run of type 'par_id_rtyp' (empty)</name>
      <description>End the current ETL run with status 2 (succesfully completed).</description>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_end_run(2,'The input directory was empty!',${par_id_rtyp})</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1152</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>trf_stg_determine_source_files_to_load_in_directory 2</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/staging_generic/staging_generic_files_in_directory/trf_stg_determine_source_files_to_load_in_directory.hpl</filename>

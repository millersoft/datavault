<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>job_stg_process_source_file</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Generic staging job: process a file</description>
  <extended_description>This job set the necessary variable and executes the appropriate transformation (csv or fixed version)  to load the source file.</extended_description>
  <workflow_version>1.0</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user/>
  <created_date>2014/12/15 01:10:16.903</created_date>
  <modified_user>admin</modified_user>
  <modified_date>2014/10/23 20:29:49.810</modified_date>
  <parameters>
    <parameter>
      <name>filename</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>id_srcfile</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>stg_target_table</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>trf_stg_inject_metadata_to_execute</name>
      <default_value/>
      <description/>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>trf_stg_set_variable_stg_target_table_generic</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/staging_generic/staging_generic_files_in_directory/trf_stg_set_variable_stg_target_table_generic.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>320</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>${trf_stg_inject_metadata_to_execute}</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/staging_generic/staging_generic_files_in_directory/${trf_stg_inject_metadata_to_execute}.hpl</filename>
      <loglevel>Basic</loglevel>
      <parameters>
        <parameter>
          <name>id_srcfile</name>
          <stream_name>${id_srcfile}</stream_name>
        </parameter>
        <parameter>
          <name>filename</name>
          <stream_name>${filename}</stream_name>
        </parameter>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>640</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>896</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>trf_stg_set_variable_stg_target_table_generic</from>
      <to>${trf_stg_inject_metadata_to_execute}</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>START</from>
      <to>trf_stg_set_variable_stg_target_table_generic</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>${trf_stg_inject_metadata_to_execute}</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ariel</fontname>
      <fontsize>10</fontsize>
      <height>22</height>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <note>Description: see job settings</note>
      <width>195</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

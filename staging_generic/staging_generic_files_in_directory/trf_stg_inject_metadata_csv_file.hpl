        <target_detail>Y</target_detail>
        <source_transform>file_columns</source_transform>
        <source_field>column_decimal</source_field>
      </mapping>
      <mapping>
        <target_transform_name>Select values</target_transform_name>
        <target_attribute_key>FIELD_NAME</target_attribute_key>
        <target_detail>Y</target_detail>
        <source_transform>file_columns</source_transform>
        <source_field>column_name</source_field>
      </mapping>
      <mapping>
        <target_transform_name>CSV file input</target_transform_name>
        <target_attribute_key>FIELD_FORMAT</target_attribute_key>

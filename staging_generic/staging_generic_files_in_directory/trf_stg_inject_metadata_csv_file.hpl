<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_stg_inject_metadata_csv_file</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic staging transformation: load a csv file</description>
    <extended_description>This job loads collect the metadata for the source file and 'injects' that into the transformation trf_stg_load_csv_file_generic.</extended_description>
    <pipeline_version>1.2</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>filename</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>id_srcfile</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user/>
    <created_date>2014/12/15 01:10:16.831</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2014/12/14 23:56:55.300</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Ariel</fontname>
      <fontsize>10</fontsize>
      <height>22</height>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>272</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>trf_stg_load_csv_file_generic</from>
      <to>Dummy (do nothing)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>file_properties</from>
      <to>trf_stg_load_csv_file_generic</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>file_columns</from>
      <to>trf_stg_load_csv_file_generic</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get transformation and job batch ID</from>
      <to>Set var_etl_trf_id_batch and var_etl_job_id_job</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Dummy (do nothing)</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Get transformation and job batch ID</name>
    <type>SystemInfo</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>var_etl_trf_id_batch</name>
        <type/>
      </field>
      <field>
        <name>var_etl_job_id_job</name>
        <type/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Set var_etl_trf_id_batch and var_etl_job_id_job</name>
    <type>SetVariable</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <field_name>var_etl_trf_id_batch</field_name>
        <variable_name>var_etl_trf_id_batch</variable_name>
        <variable_type>GP_WORKFLOW</variable_type>
      </field>
      <field>
        <field_name>var_etl_job_id_job</field_name>
        <variable_name>var_etl_job_id_job</variable_name>
        <variable_type>GP_WORKFLOW</variable_type>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>384</yloc>
    </GUI>
  </transform>
  <transform>
    <name>file_columns</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select     ref_file.staging_table_name    as target_table_name     
,          ref_fdir.file_directory        as file_directory
,          ref_file.file_name             as file_name
,          column_name
,          column_type
,          column_format	
,          column_length					
,          column_precision				
,          column_currency			
,          column_decimal		
,          column_group			
,          coalesce(column_trimtype,'both') as column_trimtype
from       ref_source_file_directories      ref_fdir
inner join ref_source_files                 ref_file
on         ref_fdir.id_srcfile_directory  = ref_file.id_srcfile_directory
inner join ref_source_file_columns          ref_col
on         ref_file.id_srcfile            = ref_col.id_srcfile
where      ref_file.id_srcfile            = ${id_srcfile}
and        ref_file.ind_current           = 1
order by   ref_col.column_position</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform>
    <name>file_properties</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select     '${filename}'                   as filename
,          ref_file.delimiter
,          ref_file.enclosure
,          ref_file.header_row_present
,          ref_file.file_encoding
from       ref_source_file_directories      ref_fdir
inner join ref_source_files                 ref_file
on         ref_fdir.id_srcfile_directory  = ref_file.id_srcfile_directory
where      ref_file.id_srcfile            = ${id_srcfile}
and        ref_file.ind_current           = 1 </sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>trf_stg_load_csv_file_generic</name>
    <type>MetaInject</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${PROJECT_HOME}/staging_generic/staging_generic_files_in_directory/trf_stg_load_csv_file_generic.hpl</filename>
    <run_configuration/>
    <source_transform/>
    <source_output_fields>    </source_output_fields>
    <target_file/>
    <create_parent_folder>N</create_parent_folder>
    <no_execution>N</no_execution>
    <stream_source_transform/>
    <stream_target_transform/>
    <mappings>
      <mapping>
        <target_transform_name>Fixed file input (metadata injected)</target_transform_name>
        <target_attribute_key>CURRENCY</target_attribute_key>
        <target_detail>Y</target_detail>
        <source_transform>file_columns</source_transform>
        <source_field>column_currency</source_field>
      </mapping>
      <mapping>
        <target_transform_name>CSV file input (metadata injected)</target_transform_name>
        <target_attribute_key>FIELD_GROUP</target_attribute_key>
        <target_detail>Y</target_detail>
        <source_transform>file_columns</source_transform>
        <source_field>column_group</source_field>
      </mapping>
      <mapping>
        <target_transform_name>CSV file input (metadata injected)</target_transform_name>
        <target_attribute_key>FIELD_FORMAT</target_attribute_key>
        <target_detail>Y</target_detail>
        <source_transform>file_columns</source_transform>
        <source_field>column_format</source_field>
      </mapping>
      <mapping>
        <target_transform_name>CSV file input (metadata injected)</target_transform_name>
        <target_attribute_key>FIELD_PRECISION</target_attribute_key>
        <target_detail>Y</target_detail>
        <source_transform>file_columns</source_transform>
        <source_field>column_precision</source_field>
      </mapping>
      <mapping>
        <target_transform_name>CSV file input</target_transform_name>
        <target_attribute_key>FIELD_DECIMAL</target_attribute_key>
        <target_detail>Y</target_detail>
        <source_transform>file_columns</source_transform>
        <source_field>column_decimal</source_field>
      </mapping>
      <mapping>
        <target_transform_name>CSV file input</target_transform_name>
        <target_attribute_key>FIELD_LENGTH</target_attribute_key>
        <target_detail>Y</target_detail>
        <source_transform>file_columns</source_transform>
        <source_field>column_length</source_field>
      </mapping>
      <mapping>

<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>trf_stg_log_source_file_generic_start</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Generic staging transformation: log start of source file loading</description>
    <extended_description>This transformations logs the start of loading a source file.</extended_description>
    <pipeline_version>1.2</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>filename</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>id_srcfile</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>stg_target_table</name>
        <default_value/>
        <description/>
      </parameter>
      <parameter>
        <name>trf_stg_inject_metadata_to_execute</name>
        <default_value/>
        <description/>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user/>
    <created_date>2014/12/15 01:10:16.820</created_date>
    <modified_user>admin</modified_user>
    <modified_date>2014/12/12 09:55:49.690</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Courier New</fontname>
      <fontsize>10</fontsize>
      <height>21</height>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <note>Description: see transformation settings</note>
      <width>330</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Join Rows (cartesian product)</from>
      <to>inst_run_source_files Mapping</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>process_data</from>
      <to>Join Rows (cartesian product)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get Files Rows Count</from>
      <to>Join Rows (cartesian product)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get File data</from>
      <to>Join Rows (cartesian product)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>inst_run_source_files Mapping</from>
      <to>Log start transformation</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Get File data</name>
    <type>GetFileNames</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <file>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
      <name>${filename}</name>
    </file>
    <filefield>N</filefield>
    <filename_Field>file_name</filename_Field>
    <filter>
      <filterfiletype>all_files</filterfiletype>
    </filter>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <raiseAnExceptionIfNoFile>N</raiseAnExceptionIfNoFile>
    <rownum>N</rownum>
    <rownum_field>rowscount</rownum_field>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Get Files Rows Count</name>
    <type>GetFilesRowsCount</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <file>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
      <name>${filename}</name>
    </file>
    <filefield>N</filefield>
    <filename_Field>filename</filename_Field>
    <files_count>N</files_count>
    <isaddresult>Y</isaddresult>
    <rows_count_fieldname>rowscount</rows_count_fieldname>
    <rowseparator_format>LINEFEED</rowseparator_format>
    <smartCount>N</smartCount>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Join Rows (cartesian product)</name>
    <type>JoinRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>500</cache_size>
    <compare>
      <condition>
        <conditions>
</conditions>
        <function>=</function>
        <negated>N</negated>
        <operator>-</operator>
      </condition>
    </compare>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>out</prefix>
    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Log start transformation</name>
    <type>ExecSql</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <arguments>
      <argument>
        <name>date_file_last_modified</name>
      </argument>
      <argument>
        <name>num_records_file</name>
      </argument>
    </arguments>
    <connection>pdi_meta</connection>
    <execute_each_row>Y</execute_each_row>
    <quoteString>N</quoteString>
    <replace_variables>Y</replace_variables>
    <set_params>N</set_params>
    <single_statement>N</single_statement>
    <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_log_stg_file_job_in_run
('job_stg_load_file_generic'
,'${trf_stg_inject_metadata_to_execute}'
,'start'
,'${id_srcfile}'
,'${stg_target_table}'
,'${staging_schema_name}'
,'${filename}'
,'?'
,?
,${var_id_rtyp}
,NULL,NULL
)                  </sql>
    <attributes/>
    <GUI>
      <xloc>928</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>inst_run_source_files Mapping</name>
    <type>SelectValues</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <length>-2</length>
        <name>filename</name>
        <precision>-2</precision>
        <rename>source_file</rename>
      </field>
      <field>
        <length>-2</length>
        <name>id_srcfile</name>
        <precision>-2</precision>
      </field>
      <field>
        <length>-2</length>
        <name>rowscount</name>
        <precision>-2</precision>
        <rename>num_records_file</rename>
      </field>
      <field>
        <length>-2</length>
        <name>id_run</name>
        <precision>-2</precision>
      </field>
      <field>
        <length>-2</length>
        <name>date_start</name>
        <precision>-2</precision>
      </field>
      <field>
        <length>-2</length>
        <name>lastmodifiedtime</name>
        <precision>-2</precision>
        <rename>date_file_last_modified</rename>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>704</xloc>
      <yloc>192</yloc>
    </GUI>
  </transform>
  <transform>
    <name>process_data</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>pdi_meta</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>select     id_run
,          now()               as date_start
,          ${id_srcfile}       as id_srcfile
from       inst_actual_runs
where      id_rtyp = ${var_id_rtyp}</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>320</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

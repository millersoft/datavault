<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>job_staging_generic_source_system_run</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Staging all tables for a source systemProduction in a run</description>
<extended_description>This job loads all staging tables for a given source systems using the active
run of type par_id_rtyp, which must be created and closed by its caller.

NB: The parameters par_id_srcsys and par_id_rtyp must be a right 'combination'. The description of the run type should be the staging of the given sourec system.</extended_description>
  <workflow_version>1.2</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user/>
  <created_date>2014/12/15 01:10:16.873</created_date>
  <modified_user>admin</modified_user>
  <modified_date>2017/11/14 14:53:10.340</modified_date>
  <parameters>
    <parameter>
      <name>par_id_rtyp</name>
      <default_value/>
      <description>Active run type. Table ref_runtypes contains valid options. Must be the staging runtype for the given source system. </description>
    </parameter>
    <parameter>
      <name>par_id_srcsys</name>
      <default_value/>
      <description>Source system to process. Table ref_source_systems contains valid options.</description>
    </parameter>
    <parameter>
      <name>par_subruntype</name>
      <default_value>0</default_value>
      <description>Subruntype for the run. Default is 0 (all for the runtype).</description>
    </parameter>
    <parameter>
      <name>reindex</name>
      <default_value>0</default_value>
      <description/>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>job_staging_generic_source_system_tables</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/staging_generic/staging_generic_tables_source_system/job_staging_generic_source_system_tables.hwf</filename>
      <loglevel>Nothing</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>416</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>960</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Set var_id_rtyp and var_subruntype</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <fields>
        <field>
          <variable_name>var_id_rtyp</variable_name>
          <variable_type>CURRENT_WORKFLOW</variable_type>
          <variable_value>${par_id_rtyp}</variable_value>
        </field>
        <field>
          <variable_name>var_subruntype</variable_name>
          <variable_type>CURRENT_WORKFLOW</variable_type>
          <variable_value>${par_subruntype}</variable_value>
        </field>
      </fields>
      <file_variable_type>CURRENT_WORKFLOW</file_variable_type>
      <replacevars>Y</replacevars>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>224</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Write To Log</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <loglevel>Basic</loglevel>
      <logmessage>Variable name	Value	Variable scope type
var_id_rtyp	${par_id_rtyp}	Valid in the current job
var_subruntype	${par_subruntype}	Valid in the current job
</logmessage>
      <logsubject/>
      <parallel>N</parallel>
      <xloc>288</xloc>
      <yloc>320</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>START</from>
      <to>Set var_id_rtyp and var_subruntype</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>job_staging_generic_source_system_tables</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Set var_id_rtyp and var_subruntype</from>
      <to>Write To Log</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Write To Log</from>
      <to>job_staging_generic_source_system_tables</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>0</backgroundcolorblue>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorred>255</backgroundcolorred>
      <bordercolorblue>100</bordercolorblue>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorred>100</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>0</fontcolorblue>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorred>0</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Courier New</fontname>
      <fontsize>10</fontsize>
      <height>21</height>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <note>Description: see job settings</note>
      <width>242</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>

      <sql>${PROP_DATABASE_CALL_PROCEDURE_SYNTAX} prc_log_stg_job_in_run
('job_staging_generic_source_system_table'
,'trf_staging_generic_source_system_table_id_srcsys_${par_id_srcsys}'
,'start'
,${par_record_source_id}
,'${par_source_table_name}'
,'${par_staging_table_name}'
,'${par_source_table_where_clause_to_log}'
,'${staging_schema_name}'
,'${par_source_table_stg_load_from}'
,''
,${var_id_rtyp}
, NULL, NULL
)</sql>

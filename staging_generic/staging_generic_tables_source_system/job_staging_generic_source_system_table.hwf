<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>job_staging_generic_source_system_table</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Staging a table of a source system: job</description>
  <extended_description>This job loads a staging table of a source system.
Which table that is and which possible incremental interval is used is determined in the previous jobs/transformations.

For each table a job is logged in table pdi_meta.inst_run_stg_jobs,
containing data about the table, the where condition used, start/end time and number of records loaded.

In this job the source system specific staging transformation is called, the name defined by:
trf_staging_generic_source_system_table_id_srcsys_${par_id_srcsys}

Example: for the source system with id_srcsys '8' the transformation trf_staging_generic_source_system_table_id_srcsys_8 will be called.
</extended_description>
  <workflow_version>1.3</workflow_version>
  <workflow_status>0</workflow_status>
  <created_user/>
  <created_date>2014/12/15 01:10:16.889</created_date>
  <modified_user>admin</modified_user>
  <modified_date>2017/11/14 14:55:30.334</modified_date>
  <parameters>
    <parameter>
      <name>current_sat</name>
      <default_value/>
      <description>The satellite table found using the table name</description>
    </parameter>
    <parameter>
      <name>par_id_srcsys</name>
      <default_value>1</default_value>
      <description>Id of the source system to stage</description>
    </parameter>
    <parameter>
      <name>par_record_source_id</name>
      <default_value/>
      <description>The record_source_id of the source table as defined in ref_source_tables.</description>
    </parameter>
    <parameter>
      <name>par_source_sql</name>
      <default_value/>
      <description>The SQL for the source table without the possible incremental WHERE clause. Default: select * from &lt;source_table> where 1=1, possibly overruled by  staging_sql_override.</description>
    </parameter>
    <parameter>
      <name>par_source_table_name</name>
      <default_value/>
      <description>The source table.</description>
    </parameter>
    <parameter>
      <name>par_source_table_stg_load_from</name>
      <default_value/>
      <description>The (possible) start date of the interval</description>
    </parameter>
    <parameter>
      <name>par_source_table_where_clause</name>
      <default_value/>
      <description>The (possible) WHERE-clause defining the increment.</description>
    </parameter>
    <parameter>
      <name>par_source_table_where_clause_to_log</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>par_staging_table_name</name>
      <default_value/>
      <description>The staging table.</description>
    </parameter>
    <parameter>
      <name>reindex</name>
      <default_value>0</default_value>
      <description/>
    </parameter>
    <parameter>
      <name>row_version</name>
      <default_value/>
      <description/>
    </parameter>
    <parameter>
      <name>rv_exists</name>
      <default_value/>
      <description/>
    </parameter>
  </parameters>

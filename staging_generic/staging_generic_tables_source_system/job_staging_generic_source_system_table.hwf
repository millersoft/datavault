    <action>
      <name>Archive the staging table MYSQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <connection>pdi_meta</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>drop table if exists ${staging_schema_name}_archive.${par_staging_table_name}_${var_archive_table_suffix};
create table         ${staging_schema_name}_archive.${par_staging_table_name}_${var_archive_table_suffix} as select * from ${staging_schema_name}.${par_staging_table_name} where 1 = 0;
alter  table         ${staging_schema_name}_archive.${par_staging_table_name}_${var_archive_table_suffix} ${PROP_DATABASE_ARCHIVE_TABLE_ENGINE};

insert into          ${staging_schema_name}_archive.${par_staging_table_name}_${var_archive_table_suffix}
select * from        ${staging_schema_name}.${par_staging_table_name};</sql>
      <sqlfromfile>N</sqlfromfile>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <parallel>N</parallel>
      <xloc>1248</xloc>

<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version>1.2</pipeline_version>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>2</pipeline_status>
    <parameters>
      <parameter>
        <name>par_source_table_where_clause</name>
        <description>The (possible) WHERE-clause defining the increment.</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>par_record_source_id</name>
        <description>The record_source_id of the source table as defined in ref_source_tables.</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>par_staging_table_name</name>
        <description>The staging table.</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>par_source_sql</name>
        <description>The SQL for the source table.</description>
        <default_value/>
      </parameter>
      <parameter>
        <name>par_source_table_name</name>
        <description>The source table.</description>
        <default_value/>
      </parameter>
    </parameters>
    <name>trf_staging_generic_source_system_table_id_srcsys_1</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Staging a table from source system Sakila: transformation</description>
    <extended_description>This transformation loads a staging table from source system Sakila.
The shared connection used are Sakila and STG.

NB: these connections used are stored in the configuration file shared.xml.</extended_description>
    <created_user/>
    <modified_user>admin</modified_user>
    <created_date>2014/12/15 01:10:16.733</created_date>
    <modified_date>2017/05/08 17:12:09.145</modified_date>
  </info>
  <transform>
    <type>SystemInfo</type>
    <name>Get transformation and job batch ID</name>
    <fields>
      <field>
        <name>var_etl_trf_id_batch</name>
        <type/>
      </field>
      <field>
        <name>var_etl_job_id_job</name>
        <type/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>512</xloc>
      <yloc>32</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Get variables</name>
    <fields>
      <field>
        <name>var_etl_trf_id_batch</name>
        <variable>0</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>var_etl_job_id_job</name>
        <variable>0</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>512</xloc>
      <yloc>176</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Set var_etl_trf_id_batch and var_etl_job_id_job</name>
    <fields>
      <field>
        <field_name>var_etl_trf_id_batch</field_name>
        <variable_name>var_etl_trf_id_batch</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
      </field>
      <field>
        <field_name>var_etl_job_id_job</field_name>
        <variable_name>var_etl_job_id_job</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1024</xloc>
      <yloc>32</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>staging_table_name</name>
    <connection>staging</connection>
    <schema>${stg_schema_name}</schema>
    <table>${par_staging_table_name}</table>
    <commit>${PROP_COMMIT_SIZE_STAGING}</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>N</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields/>
    <distribute>Y</distribute>
    <copies>${STG_INSERT_COPIES}</copies>
    <GUI>
      <xloc>320</xloc>
      <yloc>128</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>table_name</name>
    <sql>${par_source_sql}
${par_source_table_where_clause}</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>source</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>128</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>table_name</from>
      <to>staging_table_name</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Get transformation and job batch ID</from>
      <to>Set var_etl_trf_id_batch and var_etl_job_id_job</to>
      <enabled>N</enabled>
    </hop>
    <hop>
      <from>Get variables</from>
      <to>Set var_etl_trf_id_batch and var_etl_job_id_job</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>Description: see transformation settings</note>
      <fontname>Courier New</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorblue>0</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <width>330</width>
      <height>21</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
